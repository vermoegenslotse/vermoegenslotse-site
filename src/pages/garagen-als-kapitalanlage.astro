---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Garagen als Kapitalanlage | Vermögenslotse">
  <meta
    name="description"
    content="Garagen als Kapitalanlage strukturiert prüfen: Standort, Nachfrage, Miete, Kosten, Rendite, Finanzierung, Steuern und Exit im Vermögenslotse-Check."
  />

  <!-- ===================================================== -->
  <!-- HERO                                                  -->
  <!-- ===================================================== -->

  <section class="hero garageHero reveal">

    <div class="garageBreadcrumb">
      <a href="/sachwerte">Sachwerte & Direktanlagen</a>
      <span aria-hidden="true">→</span>
      <span>Garagen</span>
    </div>

    <div class="heroGrid garageHeroGrid">

      <div class="garageHeroContent">

        <div class="kicker">
          IMMOBILIEN ALS KAPITALANLAGE
        </div>

        <h1 class="heroTitle">
          Immobilien müssen nicht
          <span class="heroTitleSub">
            immer Wohnungen sein.
          </span>
        </h1>

        <p class="lead garageLead">
          Garagen können ein interessanter Immobilienbaustein sein:
          überschaubare Einheiten, laufende Mieteinnahmen und eine
          vergleichsweise einfache Gebäudestruktur.
        </p>

        <p class="heroExplanation">
          Aber eine Garage ist nicht deshalb eine gute Kapitalanlage,
          weil sie aus Beton besteht. Entscheidend sind Standort,
          Kaufpreis, Vermietbarkeit, Kosten und die wirtschaftliche
          Gesamtrechnung.
        </p>

        <div class="heroPills">
          <span>Direktes Immobilieneigentum</span>
          <span>Laufende Mieteinnahmen</span>
          <span>Standort bleibt entscheidend</span>
        </div>

        <div class="btnRow garageHeroButtons">
          <a class="btn" href="#garagen-check">
            Garagen prüfen
          </a>

          <a class="btn btnSecondary" href="#beispielrechnung">
            Beispielrechnung ansehen
          </a>
        </div>

      </div>


      <!-- HERO VISUAL -->

      <div class="garageHeroVisual">

        <div class="garageScene">

          <div class="sceneTop">
            <span class="sceneEyebrow">
              EIN EINFACHER SACHWERT?
            </span>

            <strong>
              Die Konstruktion ist einfach.<br />
              Die Investitionsentscheidung nicht.
            </strong>
          </div>


          <div class="garageRow" aria-hidden="true">

            <div class="garageUnit">
              <div class="garageRoof"></div>
              <div class="garageBody">
                <div class="garageDoor">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
              </div>
            </div>

            <div class="garageUnit garageUnitAccent">
              <div class="garageRoof"></div>
              <div class="garageBody">
                <div class="garageDoor">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
              </div>
            </div>

            <div class="garageUnit">
              <div class="garageRoof"></div>
              <div class="garageBody">
                <div class="garageDoor">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
              </div>
            </div>

          </div>


          <div class="sceneParameters">

            <div>
              <span>01</span>
              <strong>Standort</strong>
            </div>

            <div>
              <span>02</span>
              <strong>Nachfrage</strong>
            </div>

            <div>
              <span>03</span>
              <strong>Rendite</strong>
            </div>

            <div>
              <span>04</span>
              <strong>Exit</strong>
            </div>

          </div>


          <div class="sceneBottom">
            <span>
              Nicht die Garage entscheidet.
            </span>

            <strong>
              Sondern ihre Parameter.
            </strong>
          </div>

        </div>

      </div>

    </div>
  </section>


  <!-- ===================================================== -->
  <!-- WARUM GARAGEN                                         -->
  <!-- ===================================================== -->

  <section class="section reveal">

    <div class="sectionIntro sectionIntroNarrow">

      <div class="sectionEyebrow">
        WARUM ÜBERHAUPT GARAGEN?
      </div>

      <h2 class="sectionTitle">
        Weniger Wohnen. Mehr Nutzwert.
      </h2>

      <p class="lead">
        Wer bei Immobilien nur an Eigentumswohnungen oder Mehrfamilienhäuser
        denkt, übersieht ein kleines Segment mit einer sehr klaren Funktion:
        Menschen benötigen Stell- und Abstellfläche.
      </p>

    </div>


    <div class="whyGrid">

      <article class="whyCard">

        <div class="whyIcon" aria-hidden="true">
          ▣
        </div>

        <span class="whyNumber">
          01
        </span>

        <h3>
          Einfache Substanz
        </h3>

        <p>
          Keine Küche, kein Bad und in der Regel deutlich weniger technische
          Komponenten als bei einer Wohnimmobilie.
        </p>

        <div class="whyNote">
          Einfacher bedeutet allerdings nicht wartungsfrei.
        </div>

      </article>


      <article class="whyCard">

        <div class="whyIcon" aria-hidden="true">
          €
        </div>

        <span class="whyNumber">
          02
        </span>

        <h3>
          Kleinere Einheiten
        </h3>

        <p>
          Garagen ermöglichen Immobilieninvestitionen in kleineren Einheiten
          und können dadurch eine feinere Dosierung innerhalb des Vermögens
          erlauben.
        </p>

        <div class="whyNote">
          Die Investitionsgröße muss trotzdem zum Portfolio passen.
        </div>

      </article>


      <article class="whyCard">

        <div class="whyIcon" aria-hidden="true">
          ↗
        </div>

        <span class="whyNumber">
          03
        </span>

        <h3>
          Laufende Nutzung
        </h3>

        <p>
          Die wirtschaftliche Grundlage ist nachvollziehbar:
          Ein Nutzer zahlt für einen Stell-, Lager- oder Abstellplatz.
        </p>

        <div class="whyNote">
          Entscheidend bleibt die lokale Nachfrage.
        </div>

      </article>


      <article class="whyCard">

        <div class="whyIcon" aria-hidden="true">
          ◇
        </div>

        <span class="whyNumber">
          04
        </span>

        <h3>
          Reales Eigentum
        </h3>

        <p>
          Bei entsprechend ausgestalteten Angeboten erwirbt der Anleger
          unmittelbar Immobilieneigentum einschließlich der damit
          verbundenen Rechte.
        </p>

        <div class="whyNote">
          Eigentum allein garantiert noch keine Rendite.
        </div>

      </article>

    </div>


    <div class="garageStatement">

      <div class="garageStatementMark">
        !
      </div>

      <div>
        <span>
          MEIN AUSGANGSPUNKT
        </span>

        <strong>
          Garagen weisen Eigenschaften auf, die sie als Immobilienbaustein
          interessant machen können. Entscheidend bleibt das konkrete Objekt.
        </strong>
      </div>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- GARAGE VS WOHNEN                                      -->
  <!-- ===================================================== -->

  <section class="section sectionAlt reveal">

    <div class="sectionIntro">

      <div class="sectionEyebrow">
        EIN ANDERES IMMOBILIENPROFIL
      </div>

      <h2 class="sectionTitle">
        Eine Garage ist keine kleine Wohnung.
      </h2>

      <p class="lead">
        Beide sind Immobilien. Ihre wirtschaftlichen Treiber unterscheiden
        sich jedoch deutlich.
      </p>

    </div>


    <div class="propertyCompare">

      <div class="propertyColumn propertyResidential">

        <div class="propertyHeader">
          <span>KLASSISCHE WOHNIMMOBILIE</span>
          <h3>Wohnen ist komplex.</h3>
        </div>

        <div class="propertyRows">

          <div class="propertyRow">
            <span>Gebäudetechnik</span>
            <strong>vergleichsweise hoch</strong>
          </div>

          <div class="propertyRow">
            <span>Instandhaltung</span>
            <strong>viele Komponenten</strong>
          </div>

          <div class="propertyRow">
            <span>Mietverhältnis</span>
            <strong>umfangreicher</strong>
          </div>

          <div class="propertyRow">
            <span>Investitionsgröße</span>
            <strong>häufig höher</strong>
          </div>

          <div class="propertyRow">
            <span>Werttreiber</span>
            <strong>Lage + Gebäude + Wohnqualität</strong>
          </div>

        </div>

      </div>


      <div class="propertyDivider">
        <span>VS.</span>
      </div>


      <div class="propertyColumn propertyGarage">

        <div class="propertyHeader">
          <span>GARAGE</span>
          <h3>Der Nutzwert ist einfacher.</h3>
        </div>

        <div class="propertyRows">

          <div class="propertyRow">
            <span>Gebäudetechnik</span>
            <strong>vergleichsweise gering</strong>
          </div>

          <div class="propertyRow">
            <span>Instandhaltung</span>
            <strong>weniger Komponenten</strong>
          </div>

          <div class="propertyRow">
            <span>Mietverhältnis</span>
            <strong>funktionaler</strong>
          </div>

          <div class="propertyRow">
            <span>Investitionsgröße</span>
            <strong>kleiner dosierbar</strong>
          </div>

          <div class="propertyRow propertyRowAccent">
            <span>Werttreiber</span>
            <strong>Standort + Nachfrage + Preis</strong>
          </div>

        </div>

      </div>

    </div>


    <p class="compareFootnote">
      Die Gegenüberstellung beschreibt typische strukturelle Unterschiede
      und stellt keine pauschale Bewertung einzelner Immobilien dar.
    </p>

  </section>


  <!-- ===================================================== -->
  <!-- STANDORT                                              -->
  <!-- ===================================================== -->

  <section class="section reveal">

    <div class="locationGrid">

      <div class="locationIntro">

        <div class="sectionEyebrow">
          DER ENTSCHEIDENDE FAKTOR
        </div>

        <h2 class="sectionTitle">
          Eine Garage verdient ihr Geld nicht im Exposé.
        </h2>

        <p class="lead">
          Sie verdient es dort, wo Menschen bereit sind,
          dauerhaft für ihre Nutzung zu bezahlen.
        </p>

        <p>
          Deshalb ist die wichtigste Frage nicht, ob Garagen grundsätzlich
          gefragt sind. Entscheidend ist, ob an genau diesem Standort
          ausreichend Nachfrage für genau dieses Angebot besteht.
        </p>

        <div class="locationQuote">
          <span>Die Kernfrage:</span>

          <strong>
            Warum braucht jemand an diesem Standort
            genau diese Garage?
          </strong>
        </div>

      </div>


      <div class="locationFactors">

        <div class="locationFactor">
          <span>01</span>
          <div>
            <strong>Wohn- und Siedlungsstruktur</strong>
            <p>
              Wie viele Haushalte verfügen über unzureichende
              Stell- oder Abstellmöglichkeiten?
            </p>
          </div>
        </div>

        <div class="locationFactor">
          <span>02</span>
          <div>
            <strong>Lokales Angebot</strong>
            <p>
              Wie viele vergleichbare Garagen und Stellplätze
              konkurrieren um die Nachfrage?
            </p>
          </div>
        </div>

        <div class="locationFactor">
          <span>03</span>
          <div>
            <strong>Erzielbare Miete</strong>
            <p>
              Welche Mieten werden tatsächlich bezahlt –
              nicht nur angeboten?
            </p>
          </div>
        </div>

        <div class="locationFactor">
          <span>04</span>
          <div>
            <strong>Zukünftige Entwicklung</strong>
            <p>
              Bevölkerung, Bebauung, Mobilität und kommunale Planung
              können die Nachfrage verändern.
            </p>
          </div>
        </div>

      </div>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- BEISPIELRECHNUNG                                      -->
  <!-- ===================================================== -->

  <section
    class="section sectionAlt reveal"
    id="beispielrechnung"
  >

    <div class="sectionIntro">

      <div class="sectionEyebrow">
        VON DER MIETE ZUR RENDITE
      </div>

      <h2 class="sectionTitle">
        Entscheidend ist, was nach den Kosten übrig bleibt.
      </h2>

      <p class="lead">
        Ein konkretes Referenzobjekt zeigt, warum ich Objektrendite,
        Finanzierung und Steuern bewusst voneinander trenne.
      </p>

    </div>


    <div class="calculationPanel">

      <div class="calculationHeader">

        <div>
          <span class="calculationLabel">
            BEISPIEL · 10 NEUBAUGARAGEN
          </span>

          <h3>
            So entsteht die Objektrendite.
          </h3>

          <p>
            Die folgenden Werte stammen aus einem von Future Construct
            bereitgestellten Beispiel-Exposé. Sie dienen ausschließlich
            der Veranschaulichung der Berechnung und stellen kein aktuell
            verfügbares Angebot dar.
          </p>
        </div>

        <div class="calculationLocation">
          <span>REFERENZOBJEKT</span>
          <strong>Gotha</strong>
        </div>

      </div>


      <div class="calculationBody">

        <div class="calculationSteps">

          <div class="calcRow">
            <div>
              <span>01</span>
              <strong>Kaufpreis</strong>
            </div>

            <strong class="calcValue">
              175.000 €
            </strong>
          </div>


          <div class="calcRow">
            <div>
              <span>02</span>
              <strong>+ Erwerbsnebenkosten</strong>
            </div>

            <strong class="calcValue">
              11.935 €
            </strong>
          </div>


          <div class="calcRow calcRowTotal">
            <div>
              <span>03</span>
              <strong>Gesamtinvestition</strong>
            </div>

            <strong class="calcValue">
              186.935 €
            </strong>
          </div>


          <div class="calcSpacer"></div>


          <div class="calcRow calcRowIncome">
            <div>
              <span>04</span>
              <strong>Jahresmiete</strong>
            </div>

            <strong class="calcValue">
              + 9.480 €
            </strong>
          </div>


          <div class="calcRow calcRowCost">
            <div>
              <span>05</span>
              <strong>Betriebskosten</strong>
            </div>

            <strong class="calcValue">
              − 1.200 €
            </strong>
          </div>


          <div class="calcRow calcRowCost">
            <div>
              <span>06</span>
              <strong>Verwaltung / Service</strong>
            </div>

            <strong class="calcValue">
              − 720 €
            </strong>
          </div>


          <div class="calcRow calcRowResult">
            <div>
              <span>07</span>
              <strong>Überschuss vor Finanzierung und Steuern</strong>
            </div>

            <strong class="calcValue">
              7.560 €
            </strong>
          </div>

        </div>


        <div class="yieldCard">

          <span class="yieldEyebrow">
            OBJEKTRENDITE
          </span>

          <div class="yieldNumber">
            ≈ 4,0 %
          </div>

          <p>
            7.560 € laufender Überschuss
            im Verhältnis zur Gesamtinvestition
            von 186.935 €.
          </p>

          <div class="yieldFormula">
            <span>7.560 €</span>
            <div></div>
            <span>186.935 €</span>
          </div>

          <div class="yieldNote">
            vor Finanzierung · vor Steuern ·
            vor außergewöhnlicher Instandhaltung
          </div>

        </div>

      </div>

    </div>


    <div class="calculationMessage">

      <span>
        WARUM DIESE ZAHL FÜR MICH WICHTIG IST
      </span>

      <strong>
        Erst muss das Objekt wirtschaftlich überzeugen.
      </strong>

      <p>
        Finanzierung und steuerliche Effekte können das Ergebnis
        für den einzelnen Anleger verändern. Sie erzeugen jedoch
        keine zusätzliche Objektrendite.
      </p>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- 3 EBENEN                                              -->
  <!-- ===================================================== -->

  <section class="section reveal">

    <div class="sectionIntro centerIntro">

      <div class="sectionEyebrow">
        SAUBER TRENNEN
      </div>

      <h2 class="sectionTitle">
        Objekt. Finanzierung. Steuern.
      </h2>

      <p class="lead">
        Drei Ebenen – drei unterschiedliche Fragen.
      </p>

    </div>


    <div class="levelsGrid">

      <article class="levelCard">

        <div class="levelNumber">
          01
        </div>

        <div class="levelIcon">
          ◇
        </div>

        <h3>
          Das Objekt
        </h3>

        <p>
          Was erwirtschaftet die Garage aus Miete und laufenden Kosten
          aus eigener Kraft?
        </p>

        <div class="levelBottom">
          <span>Relevant:</span>
          Kaufpreis · Miete · Kosten · Nachfrage
        </div>

      </article>


      <div class="levelPlus">
        +
      </div>


      <article class="levelCard">

        <div class="levelNumber">
          02
        </div>

        <div class="levelIcon">
          %
        </div>

        <h3>
          Die Finanzierung
        </h3>

        <p>
          Fremdkapital kann die Eigenkapitalrendite verändern –
          erhöht aber gleichzeitig Zins- und Liquiditätsrisiken.
        </p>

        <div class="levelBottom">
          <span>Relevant:</span>
          Zins · Tilgung · Eigenkapital · Reserve
        </div>

      </article>


      <div class="levelPlus">
        +
      </div>


      <article class="levelCard">

        <div class="levelNumber">
          03
        </div>

        <div class="levelIcon">
          §
        </div>

        <h3>
          Die Steuern
        </h3>

        <p>
          Abschreibungen und persönliche steuerliche Rahmenbedingungen
          können die Nachsteuerrechnung beeinflussen.
        </p>

        <div class="levelBottom">
          <span>Relevant:</span>
          individuelle steuerliche Situation
        </div>

      </article>

    </div>


    <div class="levelsConclusion">

      <span>
        MEINE REIHENFOLGE
      </span>

      <strong>
        Erst die Investition prüfen.
        Dann Finanzierung und Steuern.
        Nicht umgekehrt.
      </strong>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- CHECK                                                 -->
  <!-- ===================================================== -->

  <section
    class="section sectionAlt reveal"
    id="garagen-check"
  >

    <div class="sectionIntro">

      <div class="sectionEyebrow">
        DER VERMÖGENSLOTSE-CHECK
      </div>

      <h2 class="sectionTitle">
        Wie schneiden Garagen bei den entscheidenden Fragen ab?
      </h2>

      <p class="lead">
        Nicht mit einem pauschalen Urteil – sondern mit den Fragen,
        die vor einer Investition beantwortet werden sollten.
      </p>

    </div>


    <div class="garageCheckGrid">

      <article class="garageCheckCard">

        <div class="garageCheckTop">
          <span>01</span>
          <strong>ERTRAG</strong>
        </div>

        <h3>
          Was bleibt von der Miete übrig?
        </h3>

        <p>
          Nicht die Bruttomiete entscheidet. Betriebskosten, Verwaltung,
          Instandhaltung und Erwerbsnebenkosten gehören in die Rechnung.
        </p>

      </article>


      <article class="garageCheckCard">

        <div class="garageCheckTop">
          <span>02</span>
          <strong>NACHFRAGE</strong>
        </div>

        <h3>
          Wer braucht die Garage?
        </h3>

        <p>
          Lokale Wohnstruktur, Parkplatzsituation, alternative Angebote
          und tatsächlich erzielbare Mieten bestimmen die Vermietbarkeit.
        </p>

      </article>


      <article class="garageCheckCard">

        <div class="garageCheckTop">
          <span>03</span>
          <strong>SUBSTANZ</strong>
        </div>

        <h3>
          Was gehört mir?
        </h3>

        <p>
          Grundstück, Bauqualität, Zufahrt, Dach, Tor, Elektrik und
          Außenflächen bestimmen den realen Vermögenswert.
        </p>

      </article>


      <article class="garageCheckCard">

        <div class="garageCheckTop">
          <span>04</span>
          <strong>AUFWAND</strong>
        </div>

        <h3>
          Wie einfach bleibt einfach?
        </h3>

        <p>
          Garagen haben weniger technische Komponenten als Wohnungen.
          Tore, Dächer, Elektrik, Entwässerung und Außenflächen
          benötigen trotzdem Aufmerksamkeit.
        </p>

      </article>


      <article class="garageCheckCard">

        <div class="garageCheckTop">
          <span>05</span>
          <strong>RISIKO</strong>
        </div>

        <h3>
          Was passiert, wenn es anders kommt?
        </h3>

        <p>
          Leerstand, Mietausfälle, Reparaturen oder eine schwächere
          lokale Nachfrage müssen wirtschaftlich verkraftbar sein.
        </p>

      </article>


      <article class="garageCheckCard">

        <div class="garageCheckTop">
          <span>06</span>
          <strong>STEUERN</strong>
        </div>

        <h3>
          Rechnet es sich auch vorher?
        </h3>

        <p>
          Steuerliche Effekte können eine gute Investition verbessern.
          Die wirtschaftliche Basis sollte jedoch bereits vor
          individuellen Steuereffekten nachvollziehbar sein.
        </p>

      </article>


      <article class="garageCheckCard">

        <div class="garageCheckTop">
          <span>07</span>
          <strong>EXIT</strong>
        </div>

        <h3>
          Wer kauft später?
        </h3>

        <p>
          Immobilieneigentum ist grundsätzlich veräußerbar.
          Zeitpunkt, erzielbarer Preis und Dauer eines Verkaufs
          sind jedoch nicht garantiert.
        </p>

      </article>


      <article class="garageCheckCard garageCheckCardAccent">

        <div class="garageCheckTop">
          <span>08</span>
          <strong>PORTFOLIO</strong>
        </div>

        <h3>
          Welche Aufgabe übernimmt die Garage?
        </h3>

        <p>
          Auch eine wirtschaftlich interessante Immobilie muss hinsichtlich
          Investitionsgröße, Liquidität und Risikostruktur zum
          Gesamtvermögen passen.
        </p>

      </article>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- CHANCEN / RISIKEN                                     -->
  <!-- ===================================================== -->

  <section class="section reveal">

    <div class="sectionIntro centerIntro">

      <div class="sectionEyebrow">
        ZWEI SEITEN DERSELBEN INVESTITION
      </div>

      <h2 class="sectionTitle">
        Sachwert bedeutet nicht risikofrei.
      </h2>

      <p class="lead">
        Ein physischer Vermögenswert kann Risiken anders verteilen.
        Er beseitigt sie nicht.
      </p>

    </div>


    <div class="balanceGrid">

      <div class="balanceCard balancePotential">

        <div class="balanceHeader">
          <span>STRUKTURELLE EIGENSCHAFTEN</span>
          <h3>Was interessant sein kann</h3>
        </div>

        <ul class="balanceList">
          <li>
            unmittelbares Immobilieneigentum
          </li>
          <li>
            laufende Einnahmen aus Vermietung
          </li>
          <li>
            vergleichsweise einfache Gebäudestruktur
          </li>
          <li>
            kleinere Investitionseinheiten als bei vielen Wohnimmobilien
          </li>
          <li>
