
---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Sachwerte & Direktanlagen | Vermögenslotse">
  <meta
    name="description"
    content="Sachwerte und Direktanlagen strukturiert prüfen: Rendite, Kapitalbindung, Restwert, Risiken und Portfoliofunktion. Struktur statt Produktlogik."
  />

  <!-- ===================================================== -->
  <!-- HERO                                                  -->
  <!-- ===================================================== -->

  <section class="hero sachwerteHero reveal">
    <div class="heroGrid sachwerteHeroGrid">

      <div class="sachwerteHeroContent">

        <div class="kicker">
          SACHWERTE & DIREKTANLAGEN
        </div>

        <h1 class="heroTitle">
          Eine Direktanlage muss sich
          <span class="heroTitleSub">
            ihren Platz im Vermögen verdienen.
          </span>
        </h1>

        <p class="lead sachwerteLead">
          Immobilien, Energieanlagen oder andere reale Vermögenswerte
          können ein Portfolio sinnvoll ergänzen.
        </p>

        <p class="heroExplanation">
          Doch wer Kapital langfristig bindet und damit auf einen Teil
          seiner Flexibilität verzichtet, sollte dafür einen guten Grund haben.
          Entscheidend ist deshalb nicht, ob ein Sachwert interessant klingt –
          sondern welchen zusätzlichen Nutzen er für die gesamte
          Vermögensstruktur schafft.
        </p>

        <div class="heroPills">
          <span>Struktur statt Produktlogik</span>
          <span>Parameter statt Prognosen</span>
          <span>Mehrwert statt Sachwertromantik</span>
        </div>

        <div class="btnRow sachwerteHeroButtons">
          <a class="btn" href="#pruefung">
            Wie ich Direktanlagen prüfe
          </a>

          <a class="btn btnSecondary" href="#anlagewelten">
            Anlagewelten ansehen
          </a>
        </div>

      </div>


      <div class="sachwerteHeroVisual">

        <div class="assetArchitecture">

          <div class="architectureTop">
            <span class="architectureEyebrow">
              VERMÖGENSARCHITEKTUR
            </span>

            <strong>
              Nicht jeder interessante Sachwert
              ist automatisch ein sinnvoller Vermögensbaustein.
            </strong>
          </div>

          <div class="architectureFlow">

            <div class="architectureItem">
              <div class="architectureNumber">01</div>

              <div>
                <span>LIQUIDITÄT</span>
                <strong>Was gebe ich auf?</strong>
              </div>
            </div>

            <div class="architectureConnector"></div>

            <div class="architectureItem">
              <div class="architectureNumber">02</div>

              <div>
                <span>MEHRWERT</span>
                <strong>Was gewinne ich hinzu?</strong>
              </div>
            </div>

            <div class="architectureConnector"></div>

            <div class="architectureItem architectureItemAccent">
              <div class="architectureNumber">03</div>

              <div>
                <span>PORTFOLIO</span>
                <strong>Welche Aufgabe übernimmt die Anlage?</strong>
              </div>
            </div>

          </div>

          <div class="architectureBottom">
            <span class="architectureQuote">
              „Erst die Funktion im Vermögen.
              Dann das konkrete Investment.“
            </span>
          </div>

        </div>

      </div>

    </div>
  </section>


  <!-- ===================================================== -->
  <!-- LIQUIDITÄT VS. DIREKTANLAGE                           -->
  <!-- ===================================================== -->

  <section class="section reveal">

    <div class="sectionIntro sectionIntroNarrow">
      <div class="sectionEyebrow">
        DIE ERSTE HÜRDE
      </div>

      <h2 class="sectionTitle">
        Wer Flexibilität aufgibt, sollte dafür etwas bekommen.
      </h2>

      <p class="lead">
        Eine Direktanlage unterscheidet sich in einem wesentlichen Punkt
        von einem liquiden Wertpapierinvestment: Die Entscheidung lässt
        sich später meist nicht einfach korrigieren.
      </p>
    </div>


    <div class="comparisonGrid">

      <div class="comparisonCard comparisonLiquid">

        <div class="comparisonIcon" aria-hidden="true">
          ↔
        </div>

        <div class="comparisonLabel">
          LIQUIDES VERMÖGEN
        </div>

        <h3>
          Beweglich bleiben
        </h3>

        <p>
          Wertpapierpositionen können reduziert, ausgetauscht oder neu
          gewichtet werden. Risiken und Liquidität lassen sich vergleichsweise
          schnell an veränderte Situationen anpassen.
        </p>

        <ul class="comparisonList">
          <li>hohe Steuerbarkeit</li>
          <li>breite Streuung möglich</li>
          <li>Kapital vergleichsweise verfügbar</li>
        </ul>

      </div>


      <div class="comparisonCenter">

        <span>
          GEGEN
        </span>

        <strong>
          zusätzlichen<br />
          Nutzen
        </strong>

      </div>


      <div class="comparisonCard comparisonDirect">

        <div class="comparisonIcon comparisonIconAccent" aria-hidden="true">
          ◆
        </div>

        <div class="comparisonLabel">
          DIREKTANLAGE
        </div>

        <h3>
          Kapital bewusst binden
        </h3>

        <p>
          Ein Sachwert bindet Kapital häufig über Jahre. Verkauf,
          Anpassung oder Umschichtung können Zeit kosten und vom
          jeweiligen Markt abhängen.
        </p>

        <ul class="comparisonList">
          <li>geringere Flexibilität</li>
          <li>objektspezifische Risiken</li>
          <li>mögliche zusätzliche Ertragsquellen</li>
        </ul>

      </div>

    </div>


    <div class="statementBox">
      <span class="statementMark" aria-hidden="true">“</span>

      <div>
        <p>
          Je geringer die spätere Steuerbarkeit einer Investition,
          desto höher muss die Qualität der Entscheidung vor dem Kauf sein.
        </p>
      </div>
    </div>

  </section>


  <!-- ===================================================== -->
  <!-- 3 STUFEN                                              -->
  <!-- ===================================================== -->

  <section class="section sectionAlt reveal" id="pruefung">

    <div class="sectionIntro centerIntro">
      <div class="sectionEyebrow">
        MEIN PRÜFRAHMEN
      </div>

      <h2 class="sectionTitle">
        Drei Stufen statt einer Produktentscheidung.
      </h2>

      <p class="lead">
        Bevor über Anbieter, Finanzierung oder steuerliche Gestaltung
        gesprochen wird, muss die Investition selbst überzeugen.
      </p>
    </div>


    <div class="processGrid">

      <article class="processCard">

        <div class="processNumber">
          01
        </div>

        <div class="processTag">
          SINN
        </div>

        <h3>
          Brauche ich diesen Baustein überhaupt?
        </h3>

        <p>
          Welchen zusätzlichen Nutzen schafft die Direktanlage gegenüber
          dem bestehenden Vermögen?
        </p>

        <div class="processQuestion">
          Was kann diese Anlage, was mein Portfolio heute nicht kann?
        </div>

      </article>


      <div class="processArrow" aria-hidden="true">
        →
      </div>


      <article class="processCard">

        <div class="processNumber">
          02
        </div>

        <div class="processTag">
          QUALITÄT
        </div>

        <h3>
          Hält die konkrete Investition der Prüfung stand?
        </h3>

        <p>
          Ertrag, Nachfrage, Substanz, Kosten, Zukunftsfähigkeit
          und Exit müssen zusammenpassen.
        </p>

        <div class="processQuestion">
          Wie robust ist die Rechnung, wenn nicht alles nach Plan läuft?
        </div>

      </article>


      <div class="processArrow" aria-hidden="true">
        →
      </div>


      <article class="processCard processCardAccent">

        <div class="processNumber">
          03
        </div>

        <div class="processTag">
          EINORDNUNG
        </div>

        <h3>
          Welchen Platz darf die Anlage im Vermögen einnehmen?
        </h3>

        <p>
          Erst jetzt geht es um Investitionssumme, Liquiditätsreserve,
          Finanzierung und konkrete Umsetzung.
        </p>

        <div class="processQuestion">
          Passt Größe und Risiko zur gesamten Vermögensstruktur?
        </div>

      </article>

    </div>


    <div class="processConclusion">
      <strong>
        Erst die Investition prüfen.
      </strong>

      <span>
        Dann Finanzierung und Steuern. Nicht umgekehrt.
      </span>
    </div>

  </section>


  <!-- ===================================================== -->
  <!-- RENDITE                                               -->
  <!-- ===================================================== -->

  <section class="section reveal">

    <div class="sectionIntro sectionIntroNarrow">
      <div class="sectionEyebrow">
        RENDITE RICHTIG LESEN
      </div>

      <h2 class="sectionTitle">
        Was zurückfließt, ist nicht automatisch das,
        was Sie verdient haben.
      </h2>

      <p class="lead">
        Gerade bei Sachwerten kann eine hohe laufende Zahlung attraktiv
        aussehen. Entscheidend ist jedoch, wie viel davon Ertrag ist –
        und welcher Wert am Ende noch vorhanden ist.
      </p>
    </div>


    <div class="returnExample">

      <div class="returnCard">

        <div class="returnCardHeader">
          <span>ANLAGE A</span>

          <strong>
            100.000 €
          </strong>

          <small>
            eingesetztes Kapital
          </small>
        </div>

        <div class="returnFlow">

          <div class="returnPayment">
            <span>Jährlicher Rückfluss</span>
            <strong>7.000 €</strong>
            <small>20 Jahre</small>
          </div>

          <div class="returnLine"></div>

          <div class="returnEnd returnEndZero">
            <span>Restwert nach 20 Jahren</span>
            <strong>0 €</strong>
          </div>

        </div>

      </div>


      <div class="returnVs">
        ≠
      </div>


      <div class="returnCard returnCardPositive">

        <div class="returnCardHeader">
          <span>ANLAGE B</span>

          <strong>
            100.000 €
          </strong>

          <small>
            eingesetztes Kapital
          </small>
        </div>

        <div class="returnFlow">

          <div class="returnPayment">
            <span>Jährlicher Rückfluss</span>
            <strong>7.000 €</strong>
            <small>20 Jahre</small>
          </div>

          <div class="returnLine"></div>

          <div class="returnEnd">
            <span>Restwert nach 20 Jahren</span>
            <strong>100.000 €</strong>
          </div>

        </div>

      </div>

    </div>


    <div class="returnMessage">

      <span>
        GLEICHER LAUFENDER RÜCKFLUSS
      </span>

      <strong>
        Völlig anderes wirtschaftliches Ergebnis.
      </strong>

      <p>
        Deshalb reicht eine einzelne Prozentzahl zur Beurteilung
        einer Direktanlage nicht aus.
      </p>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- IRR                                                   -->
  <!-- ===================================================== -->

  <section class="section irrSection reveal">

    <div class="irrPanel">

      <div class="irrIntro">

        <div class="sectionEyebrow sectionEyebrowLight">
          IRR · INTERNAL RATE OF RETURN
        </div>

        <h2>
          Eine Zahl für die gesamte Zahlungsreihe.
        </h2>

        <p>
          Der interne Zinsfuß betrachtet nicht nur die laufende Zahlung,
          sondern sämtliche Ein- und Auszahlungen einer Investition –
          einschließlich des Zeitpunkts, zu dem sie erfolgen.
        </p>

        <div class="irrQuestion">
          <span>Vereinfacht gefragt:</span>

          <strong>
            Was hat mein eingesetztes Kapital über die gesamte
            Laufzeit tatsächlich erwirtschaftet?
          </strong>
        </div>

      </div>


      <div class="irrFlow">

        <div class="irrStep">
          <span>HEUTE</span>
          <strong>− Investition</strong>
        </div>

        <div class="irrArrow">→</div>

        <div class="irrStep">
          <span>LAUFZEIT</span>
          <strong>± Zahlungsströme</strong>
        </div>

        <div class="irrArrow">→</div>

        <div class="irrStep">
          <span>ENDE</span>
          <strong>+ Restwert / Verkauf</strong>
        </div>

        <div class="irrResult">
          <span>DARAUS</span>
          <strong>IRR p. a.</strong>
        </div>

      </div>

    </div>


    <div class="irrWarning">

      <div class="irrWarningIcon">
        !
      </div>

      <div>
        <strong>
          Auch ein IRR kennt die Zukunft nicht.
        </strong>

        <p>
          Die Berechnung ist nur so belastbar wie ihre Annahmen:
          Einnahmen, Kosten, Nutzungsdauer, Investitionen und Restwert
          können sich anders entwickeln als geplant.
        </p>
      </div>

      <div class="irrMotto">
        Parameter statt Prognosen.
      </div>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- VERMÖGENSLOTSE CHECK                                  -->
  <!-- ===================================================== -->

  <section class="section sectionAlt reveal">

    <div class="sectionIntro">
      <div class="sectionEyebrow">
        DER VERMÖGENSLOTSE-CHECK
      </div>

      <h2 class="sectionTitle">
        Acht Fragen, bevor aus einem Sachwert
        ein Vermögensbaustein wird.
      </h2>

      <p class="lead">
        Unterschiedliche Sachwerte haben unterschiedliche Risiken.
        Der Prüfrahmen bleibt derselbe.
      </p>
    </div>


    <div class="checkGrid">

      <article class="checkCard">
        <span class="checkNumber">01</span>
        <h3>Ertrag</h3>
        <strong>Was verdient die Investition tatsächlich?</strong>
        <p>
          Relevant sind die tatsächlichen Zahlungsströme nach
          realistischen Kosten.
        </p>
      </article>


      <article class="checkCard">
        <span class="checkNumber">02</span>
        <h3>Nachfrage</h3>
        <strong>Warum sollte auch morgen jemand dafür bezahlen?</strong>
        <p>
          Welche wirtschaftliche Nutzung erzeugt die Einnahmen –
          und wie belastbar ist sie?
        </p>
      </article>


      <article class="checkCard">
        <span class="checkNumber">03</span>
        <h3>Substanz</h3>
        <strong>Was erwerbe ich tatsächlich?</strong>
        <p>
          Welche Vermögenswerte und Rechte gehören dem Anleger?
        </p>
      </article>


      <article class="checkCard">
        <span class="checkNumber">04</span>
        <h3>Aufwand</h3>
        <strong>Was kommt nach dem Kauf?</strong>
        <p>
          Verwaltung, Wartung, Reparaturen und mögliche
          Ersatzinvestitionen gehören in die Rechnung.
        </p>
      </article>


      <article class="checkCard">
        <span class="checkNumber">05</span>
        <h3>Zukunftsfähigkeit</h3>
        <strong>Was könnte die Rechnung später verändern?</strong>
        <p>
          Regulierung, Technik, Nutzeranforderungen und Märkte
          entwickeln sich weiter.
        </p>
      </article>


      <article class="checkCard">
        <span class="checkNumber">06</span>
        <h3>Steuern</h3>
        <strong>Funktioniert die Investition auch ohne Steuervorteil?</strong>
        <p>
          Steuern können eine gute Investition verbessern.
          Sie sollten keine schwache Investition retten müssen.
        </p>
      </article>


      <article class="checkCard">
        <span class="checkNumber">07</span>
        <h3>Exit</h3>
        <strong>Wie komme ich wieder aus der Investition?</strong>
        <p>
          Käuferkreis, Verkaufsdauer, Kosten und realistischer
          Restwert gehören zur Betrachtung.
        </p>
      </article>


      <article class="checkCard checkCardAccent">
        <span class="checkNumber">08</span>
        <h3>Portfolio</h3>
        <strong>Welche Aufgabe übernimmt die Investition?</strong>
        <p>
          Größe, Liquidität und Risikostruktur müssen zum
          Gesamtvermögen passen.
        </p>
      </article>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- ANLAGEWELTEN                                          -->
  <!-- ===================================================== -->

  <section class="section reveal" id="anlagewelten">

    <div class="sectionIntro">
      <div class="sectionEyebrow">
        AUSGEWÄHLTE ANLAGEWELTEN
      </div>

      <h2 class="sectionTitle">
        Vom Prüfrahmen zur konkreten Direktanlage.
      </h2>

      <p class="lead">
        Nicht jeder Sachwert funktioniert gleich. Deshalb betrachte ich
        unterschiedliche Konzepte jeweils mit ihren eigenen wirtschaftlichen
        Abhängigkeiten und Risiken.
      </p>
    </div>


    <div class="assetWorldGrid">

      <!-- GARAGEN -->

      <article class="assetWorld assetWorldGarage">

        <div class="assetWorldTop">

          <div class="assetWorldNumber">
            01
          </div>

          <div class="assetWorldStatus">
            IM FOKUS
          </div>

        </div>

        <div class="assetWorldSymbol garageSymbol" aria-hidden="true">

          <div class="garageRoof"></div>

          <div class="garageBody">
            <div class="garageDoor">
              <span></span>
              <span></span>
              <span></span>
            </div>
          </div>

        </div>

        <div class="assetWorldContent">

          <div class="assetWorldEyebrow">
            IMMOBILIEN
          </div>

          <h3>
            Garagen als Kapitalanlage
          </h3>

          <p>
            Immobilien müssen nicht immer Wohnungen sein.
            Garagen besitzen eine vergleichsweise einfache Gebäudestruktur
            und können laufende Mieteinnahmen erzeugen.
          </p>

          <div class="assetWorldQuestion">
            <span>Entscheidend:</span>
            Standort · Kaufpreis · Nachfrage · Kosten · Exit
          </div>

          <a class="assetWorldLink" href="/garagen-als-kapitalanlage">
            Garagen im Vermögenslotse-Check
            <span aria-hidden="true">→</span>
          </a>

        </div>

      </article>


      <!-- LOGISTIK -->

      <article class="assetWorld assetWorldLogistics">

        <div class="assetWorldTop">

          <div class="assetWorldNumber">
            02
          </div>

          <div class="assetWorldStatus assetWorldStatusNeutral">
            DIREKTANLAGEN
          </div>

        </div>

        <div class="assetWorldSymbol logisticsSymbol" aria-hidden="true">

          <div class="containerShape">
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
          </div>

        </div>

        <div class="assetWorldContent">

          <div class="assetWorldEyebrow">
            LOGISTIK-SACHWERTE
          </div>

          <h3>
            Container & Transportequipment
          </h3>

          <p>
            Reale Wirtschaft benötigt reale Infrastruktur.
            Direktinvestments in Logistikequipment folgen jedoch einer
            anderen Risikostruktur als klassische Immobilien.
          </p>

          <div class="assetWorldQuestion">
            <span>Entscheidend:</span>
            Eigentum · Zahlungsströme · Vertragspartner · Verwertung
          </div>

          <div class="assetWorldComing">
            Weitere Informationen folgen
          </div>

        </div>

      </article>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- ABSCHLUSS / CTA                                       -->
  <!-- ===================================================== -->

  <section class="section sachwerteClosing reveal">

    <div class="closingPanel">

      <div class="closingEyebrow">
        STRUKTUR STATT PRODUKTLOGIK
      </div>

      <h2>
        Sachwerte sind kein Selbstzweck.
      </h2>

      <p>
        Eine Direktanlage kann zusätzliche Ertragsquellen erschließen
        und ein Vermögen sinnvoll ergänzen.
        Gleichzeitig kostet sie Liquidität und Flexibilität.
      </p>

      <div class="closingQuestion">
        <span>Deshalb lautet meine Ausgangsfrage nicht:</span>

        <del>
          „Welches Sachwertinvestment kann ich kaufen?“
        </del>

        <strong>
          Welche Aufgabe soll dieser Baustein
          in meinem Vermögen übernehmen?
        </strong>
      </div>

      <p class="closingText">
        Erst wenn darauf eine überzeugende Antwort existiert,
        lohnt sich der Blick auf das konkrete Investment.
      </p>

      <div class="btnRow closingButtons">
        <a
          class="btn"
          href="https://chgradt-gradt-consulting.zohobookings.eu/#/242656000000190002"
          target="_blank"
          rel="noopener"
        >
          Orientierungsgespräch vereinbaren
        </a>

        <a
          class="btn btnSecondary"
          href="/kontakt"
        >
          Kontakt aufnehmen
        </a>
      </div>

      <p class="subtleText closingNote">
        Kostenlos & unverbindlich.
      </p>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- PAGE STYLES                                           -->
  <!-- ===================================================== -->

  <style>

    /* ----------------------------------------------------- */
    /* BASIS                                                 */
    /* ----------------------------------------------------- */

    .sachwerteHero {
      padding-top: clamp(2.4rem, 5vw, 4.8rem);
    }

    .sachwerteHeroGrid {
      align-items: center;
      gap: clamp(2rem, 5vw, 4.5rem);
    }

    .sachwerteHeroContent {
      min-width: 0;
    }

    .sachwerteLead {
      max-width: 720px;
    }

    .sectionIntro {
      max-width: 850px;
      margin-bottom: 2rem;
    }

    .sectionIntroNarrow {
      max-width: 780px;
    }

    .centerIntro {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    .sectionEyebrow {
      margin-bottom: .7rem;
      color: var(--c-accent);
      font-size: .73rem;
      font-weight: 800;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    .sectionEyebrowLight {
      color: #efad5f;
    }


    /* ----------------------------------------------------- */
    /* HERO PILLS                                            */
    /* ----------------------------------------------------- */

    .heroPills {
      display: flex;
      flex-wrap: wrap;
      gap: .55rem;
      margin-top: 1.25rem;
    }

    .heroPills span {
      display: inline-flex;
      align-items: center;
      min-height: 34px;
      padding: .45rem .75rem;
      border: 1px solid rgba(40,72,48,.12);
      border-radius: 999px;
      background: rgba(40,72,48,.045);
      color: var(--c-primary);
      font-size: .78rem;
      font-weight: 700;
    }

    .sachwerteHeroButtons {
      margin-top: 1.5rem;
    }


    /* ----------------------------------------------------- */
    /* HERO VISUAL                                           */
    /* ----------------------------------------------------- */

    .sachwerteHeroVisual {
      position: relative;
    }

    .assetArchitecture {
      overflow: hidden;
      border: 1px solid rgba(40,72,48,.12);
      border-radius: 28px;
      background:
        radial-gradient(
          520px 260px at 100% 0%,
          rgba(216,120,8,.17),
          transparent 64%
        ),
        linear-gradient(
          155deg,
          #284830 0%,
          #1b3423 100%
        );
      box-shadow: 0 24px 65px rgba(24,45,30,.16);
      color: #fff;
    }

    .architectureTop {
      padding: clamp(1.6rem, 3vw, 2.2rem);
      border-bottom: 1px solid rgba(255,255,255,.10);
    }

    .architectureEyebrow {
      display: block;
      margin-bottom: .75rem;
      color: #efad5f;
      font-size: .7rem;
      font-weight: 800;
      letter-spacing: .12em;
    }

    .architectureTop strong {
      display: block;
      max-width: 470px;
      font-size: clamp(1.15rem, 2vw, 1.55rem);
      line-height: 1.35;
    }

    .architectureFlow {
      display: grid;
      gap: 0;
      padding: 1rem clamp(1.2rem, 3vw, 2rem);
    }

    .architectureItem {
      display: grid;
      grid-template-columns: 46px 1fr;
      gap: 1rem;
      align-items: center;
      padding: 1rem;
      border-radius: 16px;
    }

    .architectureItemAccent {
      background: rgba(216,120,8,.12);
      border: 1px solid rgba(239,173,95,.20);
    }

    .architectureNumber {
      display: grid;
      place-items: center;
      width: 42px;
      height: 42px;
      border: 1px solid rgba(255,255,255,.16);
      border-radius: 50%;
      color: #efad5f;
      font-size: .78rem;
      font-weight: 800;
    }

    .architectureItem span {
      display: block;
      margin-bottom: .2rem;
      color: rgba(255,255,255,.56);
      font-size: .66rem;
      font-weight: 800;
      letter-spacing: .1em;
    }

    .architectureItem strong {
      display: block;
      color: #fff;
      font-size: .98rem;
      line-height: 1.35;
    }

    .architectureConnector {
      width: 1px;
      height: 14px;
      margin-left: 36px;
      background: rgba(255,255,255,.18);
    }

    .architectureBottom {
      padding: 1.2rem 2rem 1.5rem;
      background: rgba(0,0,0,.08);
      border-top: 1px solid rgba(255,255,255,.08);
    }

    .architectureQuote {
      color: rgba(255,255,255,.78);
      font-size: .9rem;
      font-style: italic;
      line-height: 1.5;
    }


    /* ----------------------------------------------------- */
    /* LIQUID VS DIREKT                                      */
    /* ----------------------------------------------------- */

    .comparisonGrid {
      display: grid;
      grid-template-columns: minmax(0,1fr) 100px minmax(0,1fr);
      gap: 1.25rem;
      align-items: stretch;
      margin-top: 2rem;
    }

    .comparisonCard {
      padding: clamp(1.5rem, 3vw, 2rem);
      border: 1px solid rgba(40,72,48,.11);
      border-radius: 22px;
      background: rgba(255,255,255,.76);
      box-shadow: 0 12px 34px rgba(0,0,0,.045);
    }

    .comparisonDirect {
      background:
        linear-gradient(
          145deg,
          rgba(216,120,8,.055),
          rgba(255,255,255,.88)
        );
    }

    .comparisonIcon {
      display: grid;
      place-items: center;
      width: 48px;
      height: 48px;
      margin-bottom: 1.2rem;
      border-radius: 14px;
      background: rgba(40,72,48,.08);
      color: var(--c-primary);
      font-size: 1.35rem;
      font-weight: 800;
    }

    .comparisonIconAccent {
      background: rgba(216,120,8,.11);
      color: var(--c-accent);
    }

    .comparisonLabel {
      margin-bottom: .5rem;
      color: var(--c-accent);
      font-size: .7rem;
      font-weight: 800;
      letter-spacing: .11em;
    }

    .comparisonCard h3 {
      margin-top: 0;
      color: var(--c-primary);
      font-size: 1.35rem;
    }

    .comparisonCard p {
      color: rgba(40,72,48,.76);
      line-height: 1.65;
    }

    .comparisonList {
      display: grid;
      gap: .5rem;
      margin: 1.25rem 0 0;
      padding: 1rem 0 0;
      border-top: 1px solid rgba(40,72,48,.09);
      list-style: none;
    }

    .comparisonList li {
      position: relative;
      padding-left: 1.15rem;
      color: rgba(40,72,48,.72);
      font-size: .9rem;
    }

    .comparisonList li::before {
      content: "";
      position: absolute;
      top: .55em;
      left: 0;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--c-accent);
    }

    .comparisonCenter {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    .comparisonCenter span {
      color: rgba(40,72,48,.42);
      font-size: .62rem;
      font-weight: 800;
      letter-spacing: .12em;
    }

    .comparisonCenter strong {
      margin-top: .4rem;
      color: var(--c-primary);
      font-size: .82rem;
      line-height: 1.3;
    }

    .statementBox {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 1rem;
      align-items: center;
      max-width: 900px;
      margin: 2rem auto 0;
      padding: 1.35rem 1.6rem;
      border-left: 4px solid var(--c-accent);
      border-radius: 0 18px 18px 0;
      background: rgba(40,72,48,.055);
    }

    .statementMark {
      color: var(--c-accent);
      font-size: 2.4rem;
      font-family: Georgia, serif;
      line-height: 1;
    }

    .statementBox p {
      margin: 0;
      color: var(--c-primary);
      font-size: clamp(1rem, 1.8vw, 1.18rem);
      font-weight: 700;
      line-height: 1.5;
    }


    /* ----------------------------------------------------- */
    /* PROCESS                                               */
    /* ----------------------------------------------------- */

    .processGrid {
      display: grid;
      grid-template-columns:
        minmax(0,1fr)
        40px
        minmax(0,1fr)
        40px
        minmax(0,1fr);
      gap: .75rem;
      align-items: center;
      margin-top: 2.2rem;
    }

    .processCard {
      min-height: 320px;
      padding: 1.5rem;
      border: 1px solid rgba(40,72,48,.11);
      border-radius: 22px;
      background: rgba(255,255,255,.78);
      box-shadow: 0 12px 32px rgba(0,0,0,.04);
    }

    .processCardAccent {
      border-color: rgba(216,120,8,.24);
      background:
        linear-gradient(
          145deg,
          rgba(216,120,8,.075),
          rgba(255,255,255,.88)
        );
    }

    .processNumber {
      margin-bottom: 1rem;
      color: rgba(40,72,48,.20);
      font-size: 2.2rem;
      font-weight: 900;
      letter-spacing: -.04em;
    }

    .processTag {
      margin-bottom: .55rem;
      color: var(--c-accent);
      font-size: .68rem;
      font-weight: 800;
      letter-spacing: .11em;
    }

    .processCard h3 {
      margin: 0 0 .8rem;
      color: var(--c-primary);
      font-size: 1.2rem;
      line-height: 1.35;
    }

    .processCard p {
      color: rgba(40,72,48,.70);
      line-height: 1.6;
    }

    .processQuestion {
      margin-top: 1.25rem;
      padding-top: 1rem;
      border-top: 1px solid rgba(40,72,48,.09);
      color: var(--c-primary);
      font-size: .88rem;
      font-weight: 700;
      line-height: 1.5;
    }

    .processArrow {
      color: rgba(40,72,48,.28);
      font-size: 1.5rem;
      text-align: center;
    }

    .processConclusion {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: .45rem;
      margin-top: 2rem;
      text-align: center;
      font-size: 1.05rem;
    }

    .processConclusion strong {
      color: var(--c-primary);
    }

    .processConclusion span {
      color: rgba(40,72,48,.70);
    }


    /* ----------------------------------------------------- */
    /* RETURN EXAMPLE                                        */
    /* ----------------------------------------------------- */

    .returnExample {
      display: grid;
      grid-template-columns: minmax(0,1fr) 70px minmax(0,1fr);
      gap: 1rem;
      align-items: center;
      margin-top: 2rem;
    }

    .returnCard {
      overflow: hidden;
      border: 1px solid rgba(40,72,48,.11);
      border-radius: 24px;
      background: #fff;
      box-shadow: 0 15px 38px rgba(0,0,0,.05);
    }

    .returnCardPositive {
      border-color: rgba(40,72,48,.20);
    }

    .returnCardHeader {
      padding: 1.4rem 1.5rem;
      background: rgba(40,72,48,.045);
    }

    .returnCardPositive .returnCardHeader {
      background: rgba(40,72,48,.075);
    }

    .returnCardHeader span,
    .returnPayment span,
    .returnEnd span {
      display: block;
      margin-bottom: .35rem;
      color: rgba(40,72,48,.55);
      font-size: .68rem;
      font-weight: 800;
      letter-spacing: .09em;
    }

    .returnCardHeader strong {
      display: block;
      color: var(--c-primary);
      font-size: 1.8rem;
    }

    .returnCardHeader small {
      color: rgba(40,72,48,.58);
    }

    .returnFlow {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: 1rem;
      align-items: center;
      padding: 1.5rem;
    }

    .returnPayment strong,
    .returnEnd strong {
      display: block;
      color: var(--c-primary);
      font-size: 1.35rem;
    }

    .returnPayment small {
      color: rgba(40,72,48,.55);
    }

    .returnLine {
      width: 42px;
      height: 1px;
      background: rgba(40,72,48,.20);
    }

    .returnEnd {
      padding: .9rem;
      border-radius: 14px;
      background: rgba(40,72,48,.075);
    }

    .returnEndZero {
      background: rgba(168,58,37,.07);
    }

    .returnEndZero strong {
      color: #8f2f1f;
    }

    .returnVs {
      color: var(--c-accent);
      font-size: 2.4rem;
      font-weight: 800;
      text-align: center;
    }

    .returnMessage {
      max-width: 720px;
      margin: 2rem auto 0;
      text-align: center;
    }

    .returnMessage span {
      display: block;
      margin-bottom: .4rem;
      color: var(--c-accent);
      font-size: .7rem;
      font-weight: 800;
      letter-spacing: .11em;
    }

    .returnMessage strong {
      display: block;
      color: var(--c-primary);
      font-size: clamp(1.3rem, 2.6vw, 1.8rem);
      line-height: 1.3;
    }

    .returnMessage p {
      max-width: 600px;
      margin: .8rem auto 0;
      color: rgba(40,72,48,.68);
    }


    /* ----------------------------------------------------- */
    /* IRR                                                   */
    /* ----------------------------------------------------- */

    .irrSection {
      padding-top: 1rem;
    }

    .irrPanel {
      display: grid;
      grid-template-columns: .9fr 1.1fr;
      gap: 2rem;
      align-items: center;
      padding: clamp(1.8rem, 4vw, 3rem);
      border-radius: 28px;
      background:
        radial-gradient(
          700px 320px at 100% 0%,
          rgba(216,120,8,.15),
          transparent 65%
        ),
        linear-gradient(
          150deg,
          #284830,
          #1b3423
        );
      box-shadow: 0 24px 60px rgba(24,45,30,.14);
      color: #fff;
    }

    .irrIntro h2 {
      margin: 0 0 1rem;
      color: #fff;
      font-size: clamp(1.6rem, 3vw, 2.25rem);
      line-height: 1.2;
    }

    .irrIntro > p {
      color: rgba(255,255,255,.72);
      line-height: 1.65;
    }

    .irrQuestion {
      margin-top: 1.5rem;
      padding: 1.15rem;
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 16px;
      background: rgba(255,255,255,.055);
    }

    .irrQuestion span {
      display: block;
      margin-bottom: .35rem;
      color: #efad5f;
      font-size: .7rem;
      font-weight: 800;
      letter-spacing: .08em;
    }

    .irrQuestion strong {
      color: #fff;
      line-height: 1.45;
    }

    .irrFlow {
      display: grid;
      grid-template-columns: 1fr auto 1fr auto 1fr;
      gap: .6rem;
      align-items: center;
    }

    .irrStep {
      min-height: 112px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 1rem;
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 16px;
      background: rgba(255,255,255,.055);
    }

    .irrStep span,
    .irrResult span {
      margin-bottom: .35rem;
      color: rgba(255,255,255,.50);
      font-size: .62rem;
      font-weight: 800;
      letter-spacing: .1em;
    }

    .irrStep strong {
      color: #fff;
      font-size: .9rem;
      line-height: 1.35;
    }

    .irrArrow {
      color: #efad5f;
    }

    .irrResult {
      grid-column: 1 / -1;
      margin-top: .4rem;
      padding: .9rem 1rem;
      border-radius: 14px;
      background: rgba(216,120,8,.16);
      text-align: center;
    }

    .irrResult strong {
      display: block;
      color: #fff;
      font-size: 1.35rem;
    }

    .irrWarning {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 1rem;
      align-items: center;
      margin-top: 1rem;
      padding: 1.2rem 1.4rem;
      border: 1px solid rgba(216,120,8,.17);
      border-radius: 18px;
      background: rgba(216,120,8,.055);
    }

    .irrWarningIcon {
      display: grid;
      place-items: center;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: var(--c-accent);
      color: #fff;
      font-weight: 900;
    }

    .irrWarning strong {
      color: var(--c-primary);
    }

    .irrWarning p {
      margin: .25rem 0 0;
      color: rgba(40,72,48,.68);
      font-size: .9rem;
      line-height: 1.5;
    }

    .irrMotto {
      color: var(--c-accent);
      font-size: .85rem;
      font-weight: 800;
      white-space: nowrap;
    }


    /* ----------------------------------------------------- */
    /* CHECK                                                 */
    /* ----------------------------------------------------- */

    .checkGrid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0,1fr));
      gap: 1rem;
      margin-top: 2rem;
    }

    .checkCard {
      position: relative;
      min-height: 260px;
      padding: 1.35rem;
      overflow: hidden;
      border: 1px solid rgba(40,72,48,.10);
      border-radius: 20px;
      background: rgba(255,255,255,.78);
      box-shadow: 0 10px 28px rgba(0,0,0,.035);
    }

    .checkCardAccent {
      border-color: rgba(216,120,8,.23);
      background:
        linear-gradient(
          145deg,
          rgba(216,120,8,.07),
          rgba(255,255,255,.90)
        );
    }

    .checkNumber {
      position: absolute;
      top: .9rem;
      right: 1rem;
      color: rgba(40,72,48,.12);
      font-size: 2.2rem;
      font-weight: 900;
    }

    .checkCard h3 {
      margin: 0 0 1rem;
      color: var(--c-accent);
      font-size: .78rem;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .checkCard strong {
      display: block;
      max-width: 220px;
      color: var(--c-primary);
      font-size: 1.02rem;
      line-height: 1.4;
    }

    .checkCard p {
      margin-top: .8rem;
      color: rgba(40,72,48,.65);
      font-size: .88rem;
      line-height: 1.55;
    }


    /* ----------------------------------------------------- */
    /* ASSET WORLDS                                          */
    /* ----------------------------------------------------- */

    .assetWorldGrid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0,1fr));
      gap: 1.5rem;
      margin-top: 2rem;
    }

    .assetWorld {
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(40,72,48,.11);
      border-radius: 26px;
      background: #fff;
      box-shadow: 0 16px 40px rgba(0,0,0,.05);
    }

    .assetWorldGarage {
      background:
        radial-gradient(
          500px 230px at 100% 0%,
          rgba(216,120,8,.10),
          transparent 65%
        ),
        #fff;
    }

    .assetWorldLogistics {
      background:
        radial-gradient(
          500px 230px at 100% 0%,
          rgba(40,72,48,.10),
          transparent 65%
        ),
        #fff;
    }

    .assetWorldTop {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.25rem 1.5rem 0;
    }

    .assetWorldNumber {
      color: rgba(40,72,48,.18);
      font-size: 1.8rem;
      font-weight: 900;
    }

    .assetWorldStatus {
      padding: .35rem .6rem;
      border-radius: 999px;
      background: rgba(216,120,8,.10);
      color: var(--c-accent);
      font-size: .63rem;
      font-weight: 800;
      letter-spacing: .08em;
    }

    .assetWorldStatusNeutral {
      background: rgba(40,72,48,.08);
      color: var(--c-primary);
    }

    .assetWorldSymbol {
      height: 155px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: .5rem 1.5rem 0;
      border-radius: 18px;
      background: rgba(40,72,48,.035);
    }

    .assetWorldContent {
      padding: 1.5rem;
    }

    .assetWorldEyebrow {
      margin-bottom: .5rem;
      color: var(--c-accent);
      font-size: .68rem;
      font-weight: 800;
      letter-spacing: .1em;
    }

    .assetWorldContent h3 {
      margin: 0 0 .8rem;
      color: var(--c-primary);
      font-size: 1.45rem;
    }

    .assetWorldContent > p {
      color: rgba(40,72,48,.70);
      line-height: 1.65;
    }

    .assetWorldQuestion {
      margin-top: 1.2rem;
      padding: .9rem 1rem;
      border-radius: 13px;
      background: rgba(40,72,48,.045);
      color: rgba(40,72,48,.72);
      font-size: .84rem;
      line-height: 1.5;
    }

    .assetWorldQuestion span {
      color: var(--c-primary);
      font-weight: 800;
    }

    .assetWorldLink {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      margin-top: 1.25rem;
      padding-top: 1rem;
      border-top: 1px solid rgba(40,72,48,.09);
      color: var(--c-primary);
      font-weight: 800;
    }

    .assetWorldLink:hover {
      text-decoration: none;
      color: var(--c-accent);
    }

    .assetWorldComing {
      margin-top: 1.25rem;
      padding-top: 1rem;
      border-top: 1px solid rgba(40,72,48,.09);
      color: rgba(40,72,48,.46);
      font-size: .82rem;
      font-weight: 700;
    }


    /* ----------------------------------------------------- */
    /* GARAGE SYMBOL                                         */
    /* ----------------------------------------------------- */

    .garageSymbol {
      flex-direction: column;
    }

    .garageRoof {
      width: 150px;
      height: 10px;
      border-radius: 5px 5px 2px 2px;
      background: var(--c-primary);
    }

    .garageBody {
      width: 135px;
      height: 82px;
      padding: 10px 13px 0;
      background: rgba(40,72,48,.15);
    }

    .garageDoor {
      width: 100%;
      height: 72px;
      display: grid;
      grid-template-rows: repeat(3,1fr);
      gap: 4px;
      padding: 7px;
      border: 2px solid var(--c-primary);
      background: #fff;
    }

    .garageDoor span {
      background: rgba(40,72,48,.09);
      border-top: 1px solid rgba(40,72,48,.15);
    }


    /* ----------------------------------------------------- */
    /* CONTAINER SYMBOL                                      */
    /* ----------------------------------------------------- */

    .containerShape {
      display: flex;
      gap: 5px;
      width: 175px;
      height: 88px;
      padding: 8px;
      border: 3px solid var(--c-primary);
      background: rgba(40,72,48,.07);
      box-shadow: 8px 8px 0 rgba(216,120,8,.12);
    }

    .containerShape span {
      flex: 1;
      border-left: 2px solid rgba(40,72,48,.32);
      border-right: 1px solid rgba(40,72,48,.12);
    }


    /* ----------------------------------------------------- */
    /* CLOSING                                               */
    /* ----------------------------------------------------- */

    .sachwerteClosing {
      padding-top: 1rem;
    }

    .closingPanel {
      padding: clamp(2rem, 5vw, 4rem);
      border-radius: 30px;
      background:
        radial-gradient(
          650px 300px at 100% 0%,
          rgba(216,120,8,.16),
          transparent 65%
        ),
        linear-gradient(
          150deg,
          #284830,
          #1b3423
        );
      box-shadow: 0 24px 65px rgba(24,45,30,.15);
      color: #fff;
      text-align: center;
    }

    .closingEyebrow {
      margin-bottom: .8rem;
      color: #efad5f;
      font-size: .7rem;
      font-weight: 800;
      letter-spacing: .12em;
    }

    .closingPanel h2 {
      margin: 0;
      color: #fff;
      font-size: clamp(1.8rem, 3.8vw, 2.7rem);
    }

    .closingPanel > p {
      max-width: 720px;
      margin: 1rem auto 0;
      color: rgba(255,255,255,.72);
      line-height: 1.65;
    }

    .closingQuestion {
      display: grid;
      gap: .55rem;
      max-width: 760px;
      margin: 2rem auto;
      padding: 1.5rem;
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 20px;
      background: rgba(255,255,255,.055);
    }

    .closingQuestion span {
      color: rgba(255,255,255,.56);
      font-size: .78rem;
    }

    .closingQuestion del {
      color: rgba(255,255,255,.50);
      font-size: 1rem;
    }

    .closingQuestion strong {
      margin-top: .35rem;
      color: #fff;
      font-size: clamp(1.2rem, 2.6vw, 1.65rem);
      line-height: 1.35;
      text-decoration: none;
    }

    .closingText {
      color: rgba(255,255,255,.72) !important;
    }

    .closingButtons {
      justify-content: center;
      margin-top: 1.6rem;
    }

    .closingPanel .btnSecondary {
      border-color: rgba(255,255,255,.35);
      background: transparent;
      color: #fff;
    }

    .closingPanel .btnSecondary:hover {
      background: rgba(255,255,255,.08);
    }

    .closingNote {
      margin-top: .8rem !important;
      color: rgba(255,255,255,.48) !important;
    }


    /* ----------------------------------------------------- */
    /* RESPONSIVE                                            */
    /* ----------------------------------------------------- */

    @media (max-width: 1050px) {

      .checkGrid {
        grid-template-columns: repeat(2, minmax(0,1fr));
      }

      .processGrid {
        grid-template-columns: 1fr;
      }

      .processArrow {
        transform: rotate(90deg);
      }

      .processCard {
        min-height: auto;
      }

      .irrPanel {
        grid-template-columns: 1fr;
      }

    }


    @media (max-width: 900px) {

      .sachwerteHeroGrid {
        grid-template-columns: 1fr;
      }

      .comparisonGrid {
        grid-template-columns: 1fr;
      }

      .comparisonCenter {
        min-height: 70px;
