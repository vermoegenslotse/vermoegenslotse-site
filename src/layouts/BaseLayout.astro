      /* ----------------------------------------------------- */
      /* TABLET / KLEINER DESKTOP                              */
      /* ----------------------------------------------------- */

      @media (max-width: 1080px) {

        .site-nav {
          gap: 1px;
        }

        .navLink,
        .navDropdownTrigger {
