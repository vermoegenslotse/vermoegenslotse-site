---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Altersvorsorgedepot-Rechner | Vermögenslotse">
  <main class="avd-page">
    <section class="avd-hero">
      <div class="container hero-grid">
        <div>
          <img src="/images/vermoegenslotse-logo.png" alt="Vermögenslotse" class="logo" />
          <p class="eyebrow">Altersvorsorgedepot-Rechner</p>
          <h1>Was kann das neue Altersvorsorgedepot für Sie leisten?</h1>
          <p class="lead">
            Vergleichen Sie Ihre mögliche staatlich geförderte Vorsorge mit einem ungeförderten ETF-Depot.
            Die Berechnung dient der ersten Orientierung - nicht als Empfehlung.
          </p>
        </div>

        <div class="retirementHeroVisual mediaCard mediaCard--soft">
          <img
            src="/images/ihr-vermoegen-in-sicheren-bahnen.png"
            alt="Ihr Vermögen in sicheren Bahnen – systematisch zu Ihrem Anlageziel"
            loading="eager"
          />
        </div>
      </div>
    </section>

    <section class="section calculator-section">
      <div class="container calculator-grid">
        <div class="card input-card">
          <p class="eyebrow">Rechner</p>
          <h2>Ihre Eingaben</h2>

          <label class="fieldLabel">
            Monatliche Sparrate
            <button class="infoBtn" type="button" data-tip="sparrate">i</button>
          </label>

          <div class="moneyInput">
            <input id="monthly" type="number" value="150" min="0" step="10" />
            <span>€</span>
          </div>

          <p class="helpText">
            Die maximale Kinderzulage (300 € pro Kind/Jahr) wird ab 25 € monatlich erreicht.
            Die Grundzulage für den Sparer ist bei 150 € am höchsten.
          </p>

          <div class="quickButtons">
            <button type="button" data-value="10">10 €<small>Mindestbeitrag</small></button>
            <button type="button" data-value="150" class="active">150 €<small>Fördergrenze</small></button>
            <button type="button" data-value="570">570 €<small>Maximum</small></button>
          </div>

          <label class="fieldLabel">
            Bruttojahreseinkommen
            <button class="infoBtn" type="button" data-tip="income">i</button>
          </label>

          <div class="moneyInput">
            <input id="income" type="number" value="35000" min="0" step="1000" />
            <span>€</span>
          </div>

          <label class="fieldLabel">
            Geburtsjahr
            <button class="infoBtn" type="button" data-tip="birthyear">i</button>
          </label>

          <input id="birthyear" type="number" value="1990" min="1950" max="2010" />

          <label class="fieldLabel">
            Renteneintrittsalter
            <button class="infoBtn" type="button" data-tip="retirement">i</button>
          </label>

          <input id="retirementAge" type="number" value="67" min="60" max="70" />

          <label class="fieldLabel">
            Rendite nach Kosten
            <button class="infoBtn" type="button" data-tip="return">i</button>
            <span id="returnLabel" class="pillValue">5,0 %</span>
          </label>

          <input id="returnRate" type="range" value="5" min="0" max="10" step="0.1" />

          <div class="rangeEnds">
            <span>0 %</span>
            <span>10 %</span>
          </div>

          <p class="helpText">
            Die Rendite wird jährlich angenommen und monatlich verzinst.
          </p>

          <label class="fieldLabel">
            Inflation
            <button class="infoBtn" type="button" data-tip="inflation">i</button>
            <span id="inflationLabel" class="pillValue">2,0 %</span>
          </label>

          <input id="inflationRate" type="range" value="2" min="0" max="6" step="0.1" />

          <label class="fieldLabel">
            Kinder
            <button class="infoBtn" type="button" data-tip="children">i</button>
          </label>

          <input id="children" type="number" value="0" min="0" max="10" />

          <button class="btn" id="calculateBtn" type="button">Berechnung aktualisieren</button>

          <div id="tooltip" class="tooltip" hidden></div>
        </div>

        <div class="results-column">
          <div class="card result-card">
            <p class="eyebrow">Altersvorsorgedepot</p>
            <h2 id="headline">Brutto-Vermögen mit 67</h2>

            <div class="result-tiles">
              <div>
                <span>Gesamtförderung</span>
                <strong id="totalSubsidy">0 €</strong>
              </div>
              <div class="highlight">
                <span>Brutto-Vermögen</span>
                <strong id="avdFinal">0 €</strong>
              </div>
              <div>
                <span>Heutige Kaufkraft</span>
                <strong id="realValue">0 €</strong>
              </div>
            </div>

            <p class="muted" id="summaryText"></p>
          </div>

          <div class="card result-card">
            <p class="eyebrow">Vergleich</p>
            <h2>AVD vs. ETF-Depot</h2>

            <div class="comparison">
              <div>
                <span>Altersvorsorgedepot</span>
                <strong id="compareAvd">0 €</strong>
              </div>
              <div>
                <span>ETF-Depot ohne Förderung</span>
                <strong id="compareEtf">0 €</strong>
              </div>
              <div class="highlight">
                <span>Vorteil durch Förderung</span>
                <strong id="advantage">0 €</strong>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="container chart-grid">
        <div class="card chart-card">
          <p class="eyebrow">Verlauf</p>
          <h2>Kapitalaufbau bis Rentenbeginn</h2>
          <canvas id="growthChart"></canvas>
        </div>

        <div class="card lead-card">
          <p class="eyebrow">Nächster Schritt</p>
          <h2>Ergebnis als PDF erhalten</h2>
          <p>
            Im nächsten Schritt kann dieses Formular mit Zoho CRM verbunden werden.
            Der Nutzer erhält dann seine persönliche Auswertung per E-Mail.
          </p>

          <form id="leadForm">
            <input type="text" name="name" placeholder="Ihr Name" />
            <input type="email" name="email" placeholder="Ihre E-Mail-Adresse" />
            <input type="tel" name="phone" placeholder="Telefon optional" />
            <button class="btn" type="submit">PDF-Auswertung anfordern</button>
          </form>

          <p class="small">
            [Zoho-CRM-Webform oder Zoho-Flow-Anbindung hier einfügen]
          </p>
        </div>
      </div>
    </section>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <script>
    const euro = new Intl.NumberFormat("de-DE", {
      style: "currency",
      currency: "EUR",
      maximumFractionDigits: 0
    });

    const els = {
      monthly: document.getElementById("monthly"),
      income: document.getElementById("income"),
      birthyear: document.getElementById("birthyear"),
      retirementAge: document.getElementById("retirementAge"),
      children: document.getElementById("children"),
      returnRate: document.getElementById("returnRate"),
      inflationRate: document.getElementById("inflationRate"),
      returnLabel: document.getElementById("returnLabel"),
      inflationLabel: document.getElementById("inflationLabel"),
      totalSubsidy: document.getElementById("totalSubsidy"),
      avdFinal: document.getElementById("avdFinal"),
      realValue: document.getElementById("realValue"),
      compareAvd: document.getElementById("compareAvd"),
      compareEtf: document.getElementById("compareEtf"),
      advantage: document.getElementById("advantage"),
      summaryText: document.getElementById("summaryText"),
      headline: document.getElementById("headline"),
      calculateBtn: document.getElementById("calculateBtn"),
      leadForm: document.getElementById("leadForm")
    };

    let chart;

    const tooltipTexts = {
      sparrate: "Ihr monatlicher Eigenbeitrag. Jeder andere Betrag kann frei eingetragen werden.",
      income: "Das Bruttojahreseinkommen dient der späteren steuerlichen Einordnung. In dieser Version wird es noch nicht steuerlich optimiert.",
      birthyear: "Aus dem Geburtsjahr wird der Zeitraum bis zum Renteneintritt abgeleitet. Die Berechnung startet aktuell mit 2027.",
      retirement: "Standardmäßig wird mit Renteneintritt 67 gerechnet. Sie können den Wert anpassen.",
      return: "Angenommene jährliche Rendite nach Kosten. Die Berechnung erfolgt modellhaft mit monatlicher Verzinsung.",
      inflation: "Inflation reduziert die Kaufkraft des späteren Vermögens. Standardwert: 2 % pro Jahr.",
      children: "Für Kinder wird modellhaft eine Kinderzulage von bis zu 300 € pro Kind und Jahr berücksichtigt."
    };

    const tooltip = document.getElementById("tooltip");

    function annualSubsidy(monthly, children) {
      const yearly = monthly * 12;

      const stage1 = Math.min(yearly, 360) * 0.5;
      const stage2 = Math.max(0, Math.min(yearly, 1800) - 360) * 0.25;

      const childSubsidy = Math.min(monthly * 12, children * 300);

      return stage1 + stage2 + childSubsidy;
    }

    function compoundMonthly(monthlyContribution, yearlySubsidy, years, annualReturn) {
      const r = annualReturn / 100 / 12;
      let capital = 0;
      const labels = [];
      const deposits = [];
      const subsidies = [];
      const total = [];

      for (let y = 0; y <= years; y++) {
        labels.push(String(new Date().getFullYear() + y));
        deposits.push(monthlyContribution * 12 * y);
        subsidies.push(yearlySubsidy * y);
        total.push(capital);

        for (let m = 0; m < 12 && y < years; m++) {
          capital = capital * (1 + r) + monthlyContribution + yearlySubsidy / 12;
        }
      }

      return {
        final: capital,
        labels,
        deposits,
        subsidies,
        total
      };
    }

    function calculate() {
      const monthly = Number(els.monthly.value || 0);
      const birthyear = Number(els.birthyear.value || 1990);
      const retirementAge = Number(els.retirementAge.value || 67);
      const children = Number(els.children.value || 0);
      const returnRate = Number(els.returnRate.value || 5);
      const inflation = Number(els.inflationRate.value || 2);

      const currentYear = 2027;
      const age = currentYear - birthyear;
      const years = Math.max(0, retirementAge - age);

      const subsidy = annualSubsidy(monthly, children);
      const avd = compoundMonthly(monthly, subsidy, years, returnRate);
      const etf = compoundMonthly(monthly, 0, years, returnRate);

      const realValue = avd.final / Math.pow(1 + inflation / 100, years);
      const advantage = avd.final - etf.final;

      els.returnLabel.textContent = returnRate.toFixed(1).replace(".", ",") + " %";
      els.inflationLabel.textContent = inflation.toFixed(1).replace(".", ",") + " %";

      els.headline.textContent = `Brutto-Vermögen mit ${retirementAge}`;
      els.totalSubsidy.textContent = euro.format(subsidy * years);
      els.avdFinal.textContent = euro.format(avd.final);
      els.realValue.textContent = euro.format(realValue);
      els.compareAvd.textContent = euro.format(avd.final);
      els.compareEtf.textContent = euro.format(etf.final);
      els.advantage.textContent = euro.format(advantage);

      els.summaryText.innerHTML =
        `Bei Renteneintritt mit <strong>${retirementAge}</strong> und ` +
        `<strong>${returnRate.toFixed(1).replace(".", ",")} %</strong> Rendite nach Kosten ` +
        `beträgt Ihr geschätztes Brutto-Vermögen im Altersvorsorgedepot ` +
        `<strong>${euro.format(avd.final)}</strong>. Bei ` +
        `<strong>${inflation.toFixed(1).replace(".", ",")} %</strong> Inflation entspricht dies ` +
        `einer heutigen Kaufkraft von <strong>${euro.format(realValue)}</strong>.`;

      drawChart(avd.labels, avd.deposits, avd.subsidies, avd.total);
    }

    function drawChart(labels, deposits, subsidies, total) {
      const ctx = document.getElementById("growthChart");

      if (chart) chart.destroy();

      chart = new Chart(ctx, {
        type: "line",
        data: {
          labels,
          datasets: [
            {
              label: "Einzahlungen",
              data: deposits,
              borderColor: "#8d969d",
              backgroundColor: "rgba(141,150,157,.15)",
              fill: true,
              tension: 0.25
            },
            {
              label: "Förderung",
              data: subsidies,
              borderColor: "#1e88c8",
              backgroundColor: "rgba(30,136,200,.18)",
              fill: true,
              tension: 0.25
            },
            {
              label: "Gesamtvermögen",
              data: total,
              borderColor: "#1f6b3a",
              backgroundColor: "rgba(31,107,58,.18)",
              fill: true,
              tension: 0.25
            }
          ]
        },
        options: {
          responsive: true,
          plugins: {
            legend: { position: "bottom" }
          },
          scales: {
            y: {
              ticks: {
                callback: value => euro.format(value)
              }
            }
          }
        }
      });
    }

    document.querySelectorAll("input").forEach(input => {
      input.addEventListener("input", calculate);
    });

    document.querySelectorAll(".quickButtons button").forEach((button) => {
      button.addEventListener("click", () => {
        document.querySelectorAll(".quickButtons button").forEach((b) => b.classList.remove("active"));
        button.classList.add("active");
        els.monthly.value = button.dataset.value;
        calculate();
      });
    });

    els.monthly.addEventListener("input", () => {
      document.querySelectorAll(".quickButtons button").forEach((b) => {
        b.classList.toggle("active", b.dataset.value === els.monthly.value);
      });
    });

    document.querySelectorAll(".infoBtn").forEach((btn) => {
      btn.addEventListener("click", (event) => {
        event.stopPropagation();

        tooltip.textContent = tooltipTexts[btn.dataset.tip] || "";
        tooltip.hidden = false;

        const rect = btn.getBoundingClientRect();
        const parentRect = document.querySelector(".input-card").getBoundingClientRect();

        tooltip.style.left = `${rect.left - parentRect.left - 10}px`;
        tooltip.style.top = `${rect.bottom - parentRect.top + 10}px`;
      });
    });

    document.addEventListener("click", (e) => {
      if (!e.target.closest(".infoBtn") && !e.target.closest(".tooltip")) {
        tooltip.hidden = true;
      }
    });

    els.calculateBtn.addEventListener("click", calculate);

    els.leadForm.addEventListener("submit", e => {
      e.preventDefault();
      alert("Platzhalter: Hier wird später Zoho CRM / Zoho Flow angebunden.");
    });

    calculate();
  </script>

  <style>
    :root {
      --blue: #1e2f4a;
      --green: #1f5b35;
      --gold: #c79652;
      --light: #eef6fb;
      --card: #ffffff;
      --muted: #6d7582;
      --line: #dfe6ec;
      --shadow: 0 18px 45px rgba(30,47,74,.12);
    }

    .avd-page {
      background: var(--light);
      color: var(--blue);
    }

    .container {
      width: min(1180px, calc(100% - 32px));
      margin: 0 auto;
    }

    .avd-hero {
      padding: 72px 0 48px;
      background: linear-gradient(180deg, #ffffff 0%, #eef6fb 100%);
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1fr .9fr;
      gap: 32px;
      align-items: center;
    }

    .calculator-grid {
      display: grid;
      grid-template-columns: 1.18fr .82fr;
      gap: 32px;
      align-items: start;
    }

    .chart-grid {
      display: grid;
      grid-template-columns: 1.4fr .8fr;
      gap: 32px;
      align-items: start;
      margin-top: 32px;
    }

    .logo {
      max-width: 260px;
      margin-bottom: 28px;
    }

    .eyebrow {
      color: #2588c4;
      text-transform: uppercase;
      letter-spacing: .18em;
      font-weight: 800;
      font-size: .85rem;
      margin-bottom: 10px;
    }

    h1, h2 {
      margin: 0 0 18px;
      line-height: 1.05;
      color: #111827;
    }

    h1 {
      font-size: clamp(2.4rem, 5vw, 4.8rem);
      max-width: 850px;
    }

    h2 {
      font-size: clamp(1.8rem, 3vw, 2.7rem);
    }

    .lead {
      font-size: 1.2rem;
      line-height: 1.65;
      color: var(--muted);
      max-width: 720px;
    }

    .section {
      padding: 56px 0;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 28px;
      box-shadow: var(--shadow);
      padding: 32px;
    }

    .mediaCard {
      padding: 0;
      overflow: hidden;
      border-radius: 28px;
      box-shadow: var(--shadow);
      border: 1px solid var(--line);
    }

    .mediaCard img {
      width: 100%;
      display: block;
      border-radius: 28px;
    }

    .mediaCard--soft {
      background: #f8faf8;
    }

    .input-card {
      position: relative;
    }

    label {
      display: block;
      font-weight: 800;
      margin: 24px 0 8px;
      color: #111827;
    }

    .fieldLabel {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    input {
      width: 100%;
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 16px 18px;
      font-size: 1.1rem;
      margin-top: 8px;
      background: #fff;
    }

    input[type="range"] {
      accent-color: #2588c4;
    }

    .moneyInput {
      display: flex;
      align-items: center;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: #fff;
      padding-right: 18px;
    }

    .moneyInput input {
      border: 0;
      margin: 0;
    }

    .moneyInput span {
      font-size: 1.2rem;
      font-weight: 800;
      color: #111827;
    }

    .helpText {
      color: var(--muted);
      line-height: 1.6;
      margin: 14px 0 18px;
    }

    .quickButtons {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-bottom: 28px;
    }

    .quickButtons button {
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 14px;
      background: #f4f4f4;
      font-weight: 900;
      font-size: 1.1rem;
      cursor: pointer;
    }

    .quickButtons small {
      display: block;
      font-weight: 500;
      color: var(--muted);
      margin-top: 6px;
    }

    .quickButtons button.active {
      border-color: #2588c4;
      background: #eaf6fc;
      box-shadow: 0 0 0 3px rgba(37,136,196,.12);
    }

    .infoBtn {
      width: 20px;
      height: 20px;
      border: 2px solid #2588c4;
      color: #2588c4;
      background: #fff;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 800;
      cursor: pointer;
      line-height: 1;
    }

    .pillValue {
      margin-left: auto;
      background: #0f73b7;
      color: #fff;
      padding: 8px 14px;
      border-radius: 999px;
      font-weight: 900;
    }

    .rangeEnds {
      display: flex;
      justify-content: space-between;
      color: var(--muted);
      margin-top: 6px;
    }

    .tooltip {
      position: absolute;
      z-index: 20;
      max-width: 340px;
      background: #0f73b7;
      color: #fff;
      padding: 14px 18px;
      border-radius: 14px;
      font-size: .95rem;
      line-height: 1.45;
      box-shadow: 0 14px 30px rgba(15,115,183,.25);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 0;
      border-radius: 999px;
      background: #2588c4;
      color: #fff;
      font-weight: 800;
      padding: 16px 24px;
      margin-top: 24px;
      cursor: pointer;
      text-decoration: none;
      width: 100%;
      font-size: 1rem;
    }

    .btn:hover {
      background: #126ca3;
    }

    .results-column {
      display: grid;
      gap: 28px;
    }

    .result-tiles,
    .comparison {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
      margin: 24px 0;
    }

    .result-tiles div,
    .comparison div {
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 18px;
      background: #fff;
    }

    .result-tiles span,
    .comparison span {
      display: block;
      text-transform: uppercase;
      color: var(--muted);
      font-size: .8rem;
      font-weight: 800;
      margin-bottom: 8px;
    }

    .result-tiles strong,
    .comparison strong {
      font-size: 1.6rem;
      color: #111827;
    }

    .highlight {
      background: #2588c4 !important;
      color: #fff;
      border-color: #2588c4 !important;
    }

    .highlight span,
    .highlight strong {
      color: #fff;
    }

    .muted,
    .small {
      color: var(--muted);
      line-height: 1.6;
    }

    .lead-card form {
      display: grid;
      gap: 12px;
    }

    @media (max-width: 900px) {
      .hero-grid,
      .calculator-grid,
      .chart-grid {
        grid-template-columns: 1fr;
      }

      .result-tiles,
      .comparison {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
