      /* ----------------------------------------------------- */
      /* SEHR KLEINE DISPLAYS                                  */
      /* ----------------------------------------------------- */

      @media (max-width: 560px) {

        .siteHeader {
          position: sticky;
        }


        .site-nav {
          gap: 2px;
        }


        .navLink,
        .navDropdownTrigger {
          padding:
            8px 7px;

          font-size: .78rem;
        }


