      border: 1px solid rgba(216,120,8,.18);
      border-radius: 12px;
      background: rgba(216,120,8,.065);
    }

    .calcRowResult .calcValue {
      color: var(--c-accent);
      font-size: 1.12rem;
    }

    .yieldCard {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 2rem;
      background:
        radial-gradient(
          420px 230px at 100% 0%,
          rgba(216,120,8,.18),
          transparent 65%
        ),
        linear-gradient(
          155deg,
          #284830,
          #1b3423
        );
      color: #fff;
    }

    .yieldEyebrow {
      color: #efad5f;
      font-size: .67rem;
      font-weight: 800;
      letter-spacing: .11em;
    }

    .yieldNumber {
      margin: .5rem 0;
      color: #fff;
      font-size: clamp(2.5rem,5vw,4rem);
      font-weight: 900;
      letter-spacing: -.05em;
      line-height: 1;
    }

    .yieldCard p {
      color: rgba(255,255,255,.70);
      font-size: .88rem;
      line-height: 1.5;
    }

    .yieldFormula {
      display: grid;
      gap: .35rem;
      max-width: 150px;
      margin-top: .8rem;
      color: #fff;
      font-size: .78rem;
      text-align: center;
    }

    .yieldFormula div {
      height: 1px;
      background: rgba(255,255,255,.40);
    }

    .yieldNote {
      margin-top: 1.2rem;
      padding-top: 1rem;
      border-top: 1px solid rgba(255,255,255,.10);
      color: rgba(255,255,255,.48);
      font-size: .68rem;
      line-height: 1.5;
    }

    .calculationMessage {
      max-width: 760px;
      margin: 1.7rem auto 0;
      text-align: center;
    }

    .calculationMessage span {
      display: block;
      margin-bottom: .4rem;
      color: var(--c-accent);
      font-size: .66rem;
      font-weight: 800;
      letter-spacing: .1em;
    }

    .calculationMessage strong {
      display: block;
      color: var(--c-primary);
      font-size: clamp(1.25rem,2.5vw,1.65rem);
    }

    .calculationMessage p {
      margin: .6rem auto 0;
      color: rgba(40,72,48,.66);
      line-height: 1.55;
    }


    /* ----------------------------------------------------- */
    /* LEVELS                                                */
    /* ----------------------------------------------------- */

    .levelsGrid {
      display: grid;
      grid-template-columns:
        minmax(0,1fr)
        50px
        minmax(0,1fr)
        50px
        minmax(0,1fr);
      gap: .6rem;
      align-items: center;
      margin-top: 2rem;
    }

    .levelCard {
      min-height: 290px;
      padding: 1.4rem;
      border: 1px solid rgba(40,72,48,.10);
      border-radius: 20px;
      background: rgba(255,255,255,.78);
    }

    .levelNumber {
      color: rgba(40,72,48,.15);
      font-size: 1.7rem;
      font-weight: 900;
    }

    .levelIcon {
      display: grid;
      place-items: center;
      width: 42px;
      height: 42px;
      margin: .8rem 0;
      border-radius: 12px;
      background: rgba(216,120,8,.09);
      color: var(--c-accent);
      font-weight: 900;
    }

    .levelCard h3 {
      margin: 0 0 .6rem;
      color: var(--c-primary);
    }

    .levelCard p {
      color: rgba(40,72,48,.66);
      font-size: .88rem;
      line-height: 1.55;
    }

    .levelBottom {
      margin-top: 1rem;
      padding-top: .9rem;
      border-top: 1px solid rgba(40,72,48,.08);
      color: rgba(40,72,48,.60);
      font-size: .76rem;
      line-height: 1.45;
    }

    .levelBottom span {
      color: var(--c-primary);
      font-weight: 800;
    }

    .levelPlus {
      color: rgba(40,72,48,.25);
      font-size: 1.8rem;
      font-weight: 300;
      text-align: center;
    }

    .levelsConclusion {
      display: grid;
      gap: .4rem;
      max-width: 750px;
      margin: 2rem auto 0;
      padding: 1.3rem 1.5rem;
      border-radius: 18px;
      background: var(--c-primary);
      text-align: center;
    }

    .levelsConclusion span {
      color: #efad5f;
      font-size: .66rem;
      font-weight: 800;
      letter-spacing: .11em;
    }

    .levelsConclusion strong {
      color: #fff;
      font-size: 1.05rem;
      line-height: 1.5;
    }


    /* ----------------------------------------------------- */
    /* GARAGE CHECK                                          */
    /* ----------------------------------------------------- */

    .garageCheckGrid {
      display: grid;
      grid-template-columns: repeat(4,minmax(0,1fr));
      gap: 1rem;
      margin-top: 2rem;
    }

    .garageCheckCard {
      min-height: 260px;
      padding: 1.3rem;
      border: 1px solid rgba(40,72,48,.10);
      border-radius: 19px;
      background: rgba(255,255,255,.78);
      box-shadow: 0 9px 26px rgba(0,0,0,.03);
    }

    .garageCheckCardAccent {
      border-color: rgba(216,120,8,.23);
      background:
        linear-gradient(
          145deg,
          rgba(216,120,8,.07),
          rgba(255,255,255,.90)
        );
    }

    .garageCheckTop {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }

    .garageCheckTop span {
      color: rgba(40,72,48,.18);
      font-size: 1.5rem;
      font-weight: 900;
    }

    .garageCheckTop strong {
      color: var(--c-accent);
      font-size: .65rem;
      letter-spacing: .1em;
    }

    .garageCheckCard h3 {
      margin: 0 0 .7rem;
      color: var(--c-primary);
      font-size: 1.02rem;
      line-height: 1.4;
    }

    .garageCheckCard p {
      color: rgba(40,72,48,.64);
      font-size: .86rem;
      line-height: 1.55;
    }


    /* ----------------------------------------------------- */
    /* BALANCE                                               */
    /* ----------------------------------------------------- */

    .balanceGrid {
      display: grid;
      grid-template-columns: minmax(0,1fr) 90px minmax(0,1fr);
      gap: 1rem;
      align-items: stretch;
      margin-top: 2rem;
    }

    .balanceCard {
      overflow: hidden;
      border: 1px solid rgba(40,72,48,.10);
      border-radius: 22px;
      background: #fff;
    }

    .balancePotential {
      border-top: 4px solid var(--c-primary);
    }

    .balanceRisk {
      border-top: 4px solid var(--c-accent);
    }

    .balanceHeader {
      padding: 1.4rem 1.5rem 1rem;
    }

    .balanceHeader span {
      display: block;
      margin-bottom: .4rem;
      color: rgba(40,72,48,.48);
      font-size: .65rem;
      font-weight: 800;
      letter-spacing: .09em;
    }

    .balanceHeader h3 {
      margin: 0;
      color: var(--c-primary);
      font-size: 1.25rem;
    }

    .balanceList {
      display: grid;
      gap: 0;
      margin: 0;
      padding: 0 1.5rem 1.4rem;
      list-style: none;
    }

    .balanceList li {
      position: relative;
      padding: .8rem 0 .8rem 1.3rem;
      border-top: 1px solid rgba(40,72,48,.07);
      color: rgba(40,72,48,.68);
      font-size: .88rem;
      line-height: 1.45;
    }

    .balanceList li::before {
      content: "";
      position: absolute;
      top: 1.2rem;
      left: 0;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--c-primary);
    }

    .balanceRisk .balanceList li::before {
      background: var(--c-accent);
    }

    .balanceMiddle {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: .6rem;
    }

    .balanceMiddle div {
      width: 1px;
      height: 60px;
      background: rgba(40,72,48,.15);
    }

    .balanceMiddle span {
      color: rgba(40,72,48,.42);
      font-size: .62rem;
      font-weight: 800;
      letter-spacing: .1em;
      writing-mode: vertical-rl;
      transform: rotate(180deg);
    }


    /* ----------------------------------------------------- */
    /* PROVIDER                                              */
    /* ----------------------------------------------------- */

    .providerSection {
      padding-top: 1rem;
    }

    .providerPanel {
      display: grid;
      grid-template-columns: 1.1fr .9fr;
      gap: 0;
      overflow: hidden;
      border-radius: 28px;
      background:
        radial-gradient(
          600px 280px at 0% 0%,
          rgba(216,120,8,.15),
          transparent 65%
        ),
        linear-gradient(
          150deg,
          #284830,
          #1b3423
        );
      box-shadow: 0 24px 60px rgba(24,45,30,.14);
      color: #fff;
    }

    .providerIntro {
      padding: clamp(1.8rem,4vw,3rem);
    }

    .providerEyebrow {
      margin-bottom: .7rem;
      color: #efad5f;
      font-size: .68rem;
      font-weight: 800;
      letter-spacing: .12em;
    }

    .providerIntro h2 {
      margin: 0 0 .7rem;
      color: #fff;
      font-size: clamp(1.8rem,3.5vw,2.6rem);
    }

    .providerLead {
      color: #fff !important;
      font-size: 1.05rem;
      font-weight: 700;
    }

    .providerIntro p {
      color: rgba(255,255,255,.70);
      line-height: 1.65;
    }

    .providerRole {
      margin-top: 1.5rem;
      padding: 1.2rem;
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 17px;
      background: rgba(255,255,255,.055);
    }

    .providerRole span {
      display: block;
      margin-bottom: .45rem;
      color: #efad5f;
      font-size: .63rem;
      font-weight: 800;
      letter-spacing: .1em;
    }

    .providerRole strong {
      color: #fff;
      font-size: .92rem;
      line-height: 1.55;
    }

    .providerFacts {
      display: grid;
      grid-template-columns: repeat(2,1fr);
      gap: 1px;
      align-content: stretch;
      background: rgba(255,255,255,.09);
    }

    .providerFact {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 155px;
      padding: 1.5rem;
      background: rgba(0,0,0,.10);
    }

    .providerFact strong {
      color: #fff;
      font-size: clamp(1.6rem,3vw,2.3rem);
      line-height: 1;
    }

    .providerFactText strong {
      font-size: 1.2rem;
    }

    .providerFact span {
      margin-top: .45rem;
      color: rgba(255,255,255,.56);
      font-size: .75rem;
    }

    .providerSource {
      grid-column: 1 / -1;
      margin: 0;
      padding: 1rem 1.4rem;
      background: rgba(0,0,0,.14);
      color: rgba(255,255,255,.45);
      font-size: .67rem;
      line-height: 1.5;
    }


    /* ----------------------------------------------------- */
    /* PORTFOLIO                                             */
    /* ----------------------------------------------------- */

    .portfolioPanel {
      display: grid;
      grid-template-columns: .8fr 1.2fr;
      gap: clamp(2rem,5vw,4rem);
      align-items: center;
    }

    .portfolioVisual {
      display: flex;
      justify-content: center;
      padding: 2rem 0;
    }

    .portfolioRing {
      position: relative;
      width: 310px;
      height: 310px;
      border: 1px solid rgba(40,72,48,.13);
      border-radius: 50%;
      background:
        radial-gradient(
          circle,
          rgba(40,72,48,.055) 0 32%,
          transparent 33%
        );
    }

    .portfolioRing::before {
      content: "";
      position: absolute;
      inset: 44px;
      border: 1px dashed rgba(40,72,48,.16);
      border-radius: 50%;
    }

    .portfolioCenter {
      position: absolute;
      top: 50%;
      left: 50%;
      display: grid;
      place-items: center;
      width: 115px;
      height: 115px;
      transform: translate(-50%,-50%);
      border-radius: 50%;
      background: var(--c-primary);
      color: #fff;
      text-align: center;
    }

    .portfolioCenter span {
      font-size: .58rem;
      letter-spacing: .1em;
      color: rgba(255,255,255,.55);
    }

    .portfolioCenter strong {
      font-size: .82rem;
    }

    .portfolioPoint {
      position: absolute;
      padding: .45rem .65rem;
      border: 1px solid rgba(40,72,48,.11);
      border-radius: 999px;
      background: #fff;
      box-shadow: 0 8px 20px rgba(0,0,0,.05);
      color: var(--c-primary);
      font-size: .7rem;
      font-weight: 700;
    }

    .pointLiquid {
      top: 16px;
      left: 50%;
      transform: translateX(-50%);
    }

    .pointMarket {
      top: 50%;
      right: -15px;
      transform: translateY(-50%);
    }

    .pointReal {
      bottom: 18px;
      left: 50%;
      transform: translateX(-50%);
    }

    .pointGarage {
      top: 50%;
      left: -12px;
      transform: translateY(-50%);
      border-color: rgba(216,120,8,.28);
      background: #fff8ef;
      color: var(--c-accent);
    }

    .portfolioQuestion {
      margin: 1.2rem 0;
      padding: 1.1rem 1.2rem;
      border-left: 4px solid var(--c-accent);
      background: rgba(216,120,8,.055);
      color: rgba(40,72,48,.58);
    }

    .portfolioQuestion strong {
      display: block;
      margin-top: .25rem;
      color: var(--c-primary);
      font-size: 1.1rem;
      line-height: 1.45;
    }

    .portfolioContent > p {
      color: rgba(40,72,48,.68);
      line-height: 1.6;
    }

    .textLink {
      display: inline-flex;
      gap: .6rem;
      align-items: center;
      margin-top: .6rem;
      color: var(--c-primary);
      font-weight: 800;
    }

    .textLink:hover {
      color: var(--c-accent);
      text-decoration: none;
    }


    /* ----------------------------------------------------- */
    /* CTA                                                   */
    /* ----------------------------------------------------- */

    .garageCta {
      padding-top: 1rem;
    }

    .ctaIntro {
      max-width: 800px;
      margin-bottom: 2rem;
    }

    .ctaGrid {
      display: grid;
      grid-template-columns: repeat(2,minmax(0,1fr));
      gap: 1.3rem;
    }

    .ctaCard {
      position: relative;
      display: flex;
      flex-direction: column;
      min-height: 470px;
      padding: clamp(1.5rem,3vw,2rem);
      overflow: hidden;
      border: 1px solid rgba(40,72,48,.11);
      border-radius: 24px;
      background: #fff;
      box-shadow: 0 14px 36px rgba(0,0,0,.045);
    }

    .ctaCardPrimary {
      border-top: 4px solid var(--c-primary);
    }

    .ctaCardInfo {
      border-top: 4px solid var(--c-accent);
      background:
        linear-gradient(
          145deg,
          rgba(216,120,8,.045),
          #fff 55%
        );
    }

    .ctaNumber {
      position: absolute;
      top: 1rem;
      right: 1.2rem;
      color: rgba(40,72,48,.10);
      font-size: 2.5rem;
      font-weight: 900;
    }

    .ctaLabel {
      margin-bottom: .65rem;
      color: var(--c-accent);
      font-size: .68rem;
      font-weight: 800;
      letter-spacing: .1em;
    }

    .ctaCard h3 {
      max-width: 480px;
      margin: 0 0 .8rem;
      color: var(--c-primary);
      font-size: 1.35rem;
      line-height: 1.35;
    }

    .ctaCard > p {
      color: rgba(40,72,48,.66);
      line-height: 1.6;
    }

    .ctaList {
      display: grid;
      gap: .55rem;
      margin: 1.2rem 0;
      padding: 1rem 0 0;
      border-top: 1px solid rgba(40,72,48,.08);
      list-style: none;
    }

    .ctaList li {
      position: relative;
      padding-left: 1.2rem;
      color: rgba(40,72,48,.66);
      font-size: .87rem;
    }

    .ctaList li::before {
      content: "";
      position: absolute;
      top: .55em;
      left: 0;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--c-accent);
    }

    .ctaBottom {
      display: grid;
      gap: .7rem;
      margin-top: auto;
      padding-top: 1rem;
    }

    .ctaBottom .btn {
      justify-content: center;
      text-align: center;
    }

    .ctaBottom > span {
      color: rgba(40,72,48,.48);
      font-size: .72rem;
    }

    .ctaFootnote {
      max-width: 850px;
      margin: 1.4rem auto 0;
      color: rgba(40,72,48,.50);
      font-size: .75rem;
      line-height: 1.5;
      text-align: center;
    }


    /* ----------------------------------------------------- */
    /* RESPONSIVE                                            */
    /* ----------------------------------------------------- */

    @media (max-width: 1050px) {

      .whyGrid,
      .garageCheckGrid {
        grid-template-columns: repeat(2,minmax(0,1fr));
      }

      .levelsGrid {
        grid-template-columns: 1fr;
      }

      .levelPlus {
        transform: rotate(90deg);
      }

      .levelCard {
        min-height: auto;
      }

      .providerPanel {
        grid-template-columns: 1fr;
      }

    }


    @media (max-width: 900px) {

      .garageHeroGrid,
      .locationGrid,
      .portfolioPanel {
        grid-template-columns: 1fr;
      }

      .propertyCompare,
      .balanceGrid {
        grid-template-columns: 1fr;
      }

      .propertyDivider {
        min-height: 70px;
      }

      .balanceMiddle {
        flex-direction: row;
        min-height: 50px;
      }

      .balanceMiddle div {
        width: 60px;
        height: 1px;
      }

      .balanceMiddle span {
        writing-mode: horizontal-tb;
        transform: none;
      }

      .calculationBody {
        grid-template-columns: 1fr;
      }

      .ctaGrid {
        grid-template-columns: 1fr;
      }

      .ctaCard {
        min-height: auto;
      }

    }


    @media (max-width: 680px) {

      .whyGrid,
      .garageCheckGrid {
        grid-template-columns: 1fr;
      }

      .whyCard,
      .garageCheckCard {
        min-height: auto;
      }

      .sceneParameters {
        grid-template-columns: repeat(2,1fr);
      }

      .propertyRow {
        flex-direction: column;
        gap: .25rem;
      }

      .propertyRow strong {
        text-align: left;
      }

      .calculationHeader {
        flex-direction: column;
      }

      .calculationLocation {
        text-align: left;
      }

      .calcRow {
        align-items: flex-start;
      }

      .calcRow > div {
        align-items: flex-start;
      }

      .providerFacts {
        grid-template-columns: 1fr;
      }

      .providerSource {
        grid-column: auto;
      }

      .portfolioRing {
        width: 270px;
        height: 270px;
      }

      .garageStatement {
        grid-template-columns: 1fr;
      }

    }

  </style>

</BaseLayout>
