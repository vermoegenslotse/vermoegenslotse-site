        }


        .logoImg {
          height: 42px;
        }


        .site-nav {
          width: 100%;

          justify-content: flex-start;

          flex-wrap: wrap;

          padding-top: 4px;
        }


        .navLink,
        .navDropdownTrigger {
          min-height: 38px;

          font-size: .84rem;
        }


        .toolboxDropdownPanel,
        .contactDropdownPanel {
          position: fixed;

          z-index: 2000;

          top: 108px;

          left: 16px;
          right: 16px;

          width: auto;

          max-height:
            calc(100vh - 125px);

          overflow-y: auto;

          transform: translateY(-5px);
        }


        .toolboxDropdownPanel {
          grid-template-columns: 1fr;
        }


        .dropdownIntro {
          padding: 20px;
        }


        .toolboxDropdownContent {
          padding: 18px;
        }

