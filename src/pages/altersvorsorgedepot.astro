          )
        );


      const yearsToRetirement =
        Math.max(
          1,
          retirementAge -
          currentAge
        );


      const payoutYears =
        Math.max(
          1,
          payoutUntil -
          retirementAge
        );


      const avdNetReturn =
        Math.max(
          -0.99,
          (
            Number(
              el.avdReturn.value
            ) -
            Number(
              el.avdCosts.value
            )
          ) /
          100
        );


      const etfNetReturn =
        Math.max(
          -0.99,
          (
            Number(
              el.etfReturn.value
            ) -
            Number(
              el.etfCosts.value
            )
          ) /
          100
        );


      const inflation =
        Number(
          el.inflationRate.value
        ) /
        100;


      const taxNow =
        Number(
          el.taxRateNow.value
        );


      const taxRetirement =
        Number(
          el.taxRateRetirement.value
        ) /
        100;


      const payoutReturn =
        Number(
          el.payoutReturn.value
        );


      const taxAllowance =
        Number(
          el.taxAllowance.value
        );


      let avdFunded =
        riesterTransfer;


      let avdUnfunded =
        0;


      let avdUnfundedBasis =
        0;


      let etfCapital =
        0;


      let totalOwn =
        0;


      let totalAllowances =
        0;


      let totalTaxBenefits =
        0;


      const labels =
        [];


      const avdSeries =
        [];


      const etfSeries =
        [];


      const annualRows =
        [];


      for (
        let yearIndex = 0;
        yearIndex <= yearsToRetirement;
        yearIndex++
      ) {

        const calendarYear =
          2027 +
          yearIndex;


        const age =
          currentAge +
          yearIndex;


        labels.push(
          String(age)
        );


        avdSeries.push(
          avdFunded +
          avdUnfunded
        );


        etfSeries.push(
          etfCapital
        );


        if (
          yearIndex ===
          yearsToRetirement
        ) {
          break;
        }


        const fundedOwn =
          Math.min(
            yearlyContribution,
            1800
          );


        const unfundedOwn =
          Math.max(
            0,
            yearlyContribution -
            fundedOwn
          );


        const allowance =
          totalAllowance(
            fundedOwn,
            calendarYear
          );


        const taxRefund =
          taxBenefit(
            fundedOwn,
            allowance,
            taxNow
          );


        totalOwn +=
          yearlyContribution;


        totalAllowances +=
          allowance;


        totalTaxBenefits +=
          taxRefund;


        annualRows.push({
          calendarYear,
          allowance,
          taxRefund
        });


        /* AVD geförderter Topf */

        avdFunded +=
          fundedOwn +
          allowance;


        avdFunded *=
          (
            1 +
            avdNetReturn
          );


        /* Nicht geförderter Teil + Steuererstattung */

        avdUnfunded +=
          unfundedOwn +
          taxRefund;


        avdUnfundedBasis +=
          unfundedOwn +
          taxRefund;


        avdUnfunded *=
          (
            1 +
            avdNetReturn
          );


        /* Vergleichs-ETF */

        const etfBeforeGain =
          etfCapital +
          yearlyContribution;


        const etfAfterGain =
          etfBeforeGain *
          (
            1 +
            etfNetReturn
          );


        etfCapital =
          applyEtfYearTax(
            etfBeforeGain,
            etfAfterGain,
            taxAllowance
          );

      }


      const avdCapital =
        avdFunded +
        avdUnfunded;


      const realCapital =
        avdCapital /
        Math.pow(
          1 +
          inflation,
          yearsToRetirement
        );


      /* -------------------------------------------
         AVD NETTO ZUM AUSZAHLSTART
      -------------------------------------------- */

      const fundedNetCapital =
        avdFunded *
        (
          1 -
          taxRetirement
        );


      const unfundedGain =
        Math.max(
          0,
          avdUnfunded -
          avdUnfundedBasis
        );


      const effectiveCapitalGainTax =
        0.26375 *
        0.70;


      const unfundedNetCapital =
        avdUnfundedBasis +
        unfundedGain *
        (
          1 -
          effectiveCapitalGainTax
        );


      const avdNetCapitalForPayout =
        fundedNetCapital +
        unfundedNetCapital;


      const avdMonthlyNet =
        annuityPayment(
          avdNetCapitalForPayout,
          payoutYears,
          payoutReturn
        );


      /* ETF-Auszahlung */

      const etfPayoutReturn =
        payoutReturn *
        (
          1 -
          effectiveCapitalGainTax
        );


      const etfMonthlyNet =
        annuityPayment(
          etfCapital,
          payoutYears,
          etfPayoutReturn
        );


      const firstYear =
        annualRows[0] ||
        {
          allowance: 0,
          taxRefund: 0
        };


      const effectiveOwnCost =
        Math.max(
          0,
          (
            yearlyContribution -
            firstYear.allowance -
            firstYear.taxRefund
          ) /
          12
        );


      const investmentGrowth =
        avdCapital -
        totalOwn -
        totalAllowances -
        totalTaxBenefits -
        riesterTransfer;


      return {

        monthly,
        yearlyContribution,
        riesterTransfer,
        currentAge,
        retirementAge,
        payoutUntil,
        yearsToRetirement,
        payoutYears,

        avdCapital,
        etfCapital,
        realCapital,

        avdMonthlyNet,
        etfMonthlyNet,

        effectiveOwnCost,

        totalOwn,
        totalAllowances,
        totalTaxBenefits,

        investmentGrowth,

        firstYearAllowance:
          firstYear.allowance,

        firstYearTaxBenefit:
          firstYear.taxRefund,

        labels,
        avdSeries,
        etfSeries

      };

    }


    /* ---------------------------------------------------------
       UI
    ---------------------------------------------------------- */

    function updateUI(
      result
    ) {

      latestResult =
        result;


      el.monthlyLabel.textContent =
        euro.format(
          result.monthly
        );


      el.riesterLabel.textContent =
        euro.format(
          result.riesterTransfer
        );


      el.payoutLabel.textContent =
        result.payoutUntil;


      el.riesterNotice.hidden =
        result.riesterTransfer <= 0;


      el.netMonthlyPension.textContent =
        euro.format(
          result.avdMonthlyNet
        );


      el.effectiveOwnCost.textContent =
        euro.format(
          result.effectiveOwnCost
        ) +
        " / Monat";


      el.heroCapital.textContent =
        euro.format(
          result.avdCapital
        );


      el.heroRealCapital.textContent =
        euro.format(
          result.realCapital
        );


      el.heroRetirementAge.textContent =
        `mit ${result.retirementAge} Jahren`;


      el.heroSummary.innerHTML =
        `Bis zum Rentenbeginn mit <strong>${result.retirementAge}</strong> Jahren ` +
        `ergibt die Modellrechnung ein Vermögen von <strong>${euro.format(result.avdCapital)}</strong>. ` +
        `Davon stammen insgesamt <strong>${euro.format(result.totalAllowances)}</strong> aus Zulagen ` +
        `und modellhaft <strong>${euro.format(result.totalTaxBenefits)}</strong> aus zusätzlichen Steuervorteilen.`;


      const firstYearSupport =
        result.firstYearAllowance +
        result.firstYearTaxBenefit;


      el.annualSupport.textContent =
        euro.format(
          firstYearSupport
        );


      el.annualOwn.textContent =
        euro.format(
          result.yearlyContribution
        );


      el.annualAllowance.textContent =
        euro.format(
          result.firstYearAllowance
        );


      el.annualTaxBenefit.textContent =
        euro.format(
          result.firstYearTaxBenefit
        );


      const supportTotal =
        Math.max(
          1,
          result.yearlyContribution +
          result.firstYearAllowance +
          result.firstYearTaxBenefit
        );


      el.supportOwnBar.style.width =
        (
          result.yearlyContribution /
          supportTotal *
          100
        ) +
        "%";


      el.supportSubsidyBar.style.width =
        (
          result.firstYearAllowance /
          supportTotal *
          100
        ) +
        "%";


      el.supportTaxBar.style.width =
        (
          result.firstYearTaxBenefit /
          supportTotal *
          100
        ) +
        "%";


      const supportRate =
        result.yearlyContribution > 0
          ? firstYearSupport /
            result.yearlyContribution *
            100
          : 0;


      el.supportExplanation.textContent =
        `Zulagen und modellhafter zusätzlicher Steuervorteil entsprechen im ersten Jahr rund ${supportRate.toFixed(0)} % Ihres Eigenbeitrags.`;


      el.totalOwnContributions.textContent =
        euro.format(
          result.totalOwn
        );


      el.totalAllowances.textContent =
        euro.format(
          result.totalAllowances
        );


      el.totalTaxBenefits.textContent =
        euro.format(
          result.totalTaxBenefits
        );


      el.totalRiester.textContent =
        euro.format(
          result.riesterTransfer
        );


      el.investmentGrowth.textContent =
        euro.format(
          result.investmentGrowth
        );


      el.compositionTotal.textContent =
        euro.format(
          result.avdCapital
        );


      const capitalDiff =
        result.avdCapital -
        result.etfCapital;


      const pensionDiff =
        result.avdMonthlyNet -
        result.etfMonthlyNet;


      el.capitalDifference.textContent =
        (
          capitalDiff >= 0
            ? "+"
            : ""
        ) +
        euro.format(
          capitalDiff
        );


      el.pensionDifference.textContent =
        (
          pensionDiff >= 0
            ? "+"
            : ""
        ) +
        euro.format(
          pensionDiff
        ) +
        " / Monat";


      el.capitalDifference.classList.toggle(
        "positiveValue",
        capitalDiff >= 0
      );


      el.capitalDifference.classList.toggle(
        "negativeValue",
        capitalDiff < 0
      );


      el.pensionDifference.classList.toggle(
        "positiveValue",
        pensionDiff >= 0
      );


      el.pensionDifference.classList.toggle(
        "negativeValue",
        pensionDiff < 0
      );


      el.avdCapitalCompare.textContent =
        euro.format(
          result.avdCapital
        );


      el.etfCapitalCompare.textContent =
        euro.format(
          result.etfCapital
        );


      const maxCapital =
        Math.max(
          result.avdCapital,
          result.etfCapital,
          1
        );


      el.avdCapitalBar.style.width =
        (
          result.avdCapital /
          maxCapital *
          100
        ) +
        "%";


      el.etfCapitalBar.style.width =
        (
          result.etfCapital /
          maxCapital *
          100
        ) +
        "%";


      el.tableAvdCapital.textContent =
        euro.format(
          result.avdCapital
        );


      el.tableEtfCapital.textContent =
        euro.format(
          result.etfCapital
        );


      el.tableAvdPension.textContent =
        euro.format(
          result.avdMonthlyNet
        );


      el.tableEtfPension.textContent =
        euro.format(
          result.etfMonthlyNet
        );


      el.tableAvdSubsidies.textContent =
        euro.format(
          result.totalAllowances
        );


      drawChart(
        result
      );

    }


    /* ---------------------------------------------------------
       CHART
    ---------------------------------------------------------- */

    function drawChart(
      result
    ) {

      const canvas =
        document.getElementById(
          "growthChart"
        );


      if (!canvas) return;


      if (chart) {
        chart.destroy();
      }


      chart =
        new Chart(
          canvas,
          {

            type:
              "line",

            data: {

              labels:
                result.labels,

              datasets: [

                {
                  label:
                    "Altersvorsorgedepot",

                  data:
                    result.avdSeries,

                  borderColor:
                    "#1f5b35",

                  backgroundColor:
                    "rgba(31,91,53,.10)",

                  borderWidth:
                    3,

                  fill:
                    true,

                  pointRadius:
                    0,

                  tension:
                    0.25
                },


                {
                  label:
                    "Normales ETF-Depot",

                  data:
                    result.etfSeries,

                  borderColor:
                    "#8ca8bd",

                  backgroundColor:
                    "rgba(140,168,189,.06)",

                  borderWidth:
                    3,

                  fill:
                    false,

                  pointRadius:
                    0,

                  tension:
                    0.25
                }

              ]

            },


            options: {

              responsive:
                true,

              maintainAspectRatio:
                false,

              interaction: {
                intersect:
                  false,

                mode:
                  "index"
              },


              plugins: {

                legend: {
                  display:
                    false
                },


                tooltip: {

                  callbacks: {

                    label:
                      context =>
                        `${context.dataset.label}: ${euro.format(context.raw)}`

                  }

                }

              },


              scales: {

                x: {

                  title: {
                    display:
                      true,

                    text:
                      "Alter"
                  },

                  grid: {
                    display:
                      false
                  }

                },


                y: {

                  beginAtZero:
                    true,

                  ticks: {

                    callback:
                      value =>
                        euro.format(
                          value
                        )

                  }

                }

              }

            }

          }
        );

    }


    /* ---------------------------------------------------------
       CALCULATE
    ---------------------------------------------------------- */

    function calculate() {

      const result =
        calculateModel();


      updateUI(
        result
      );

    }


    /* ---------------------------------------------------------
       EVENTS
    ---------------------------------------------------------- */

    [
      el.monthly,
      el.riesterTransfer,
      el.currentAge,
      el.retirementAge,
      el.payoutUntil,
      el.avdReturn,
      el.avdCosts,
      el.etfReturn,
      el.etfCosts,
      el.taxRateNow,
      el.taxRateRetirement,
      el.inflationRate,
      el.payoutReturn,
      el.taxAllowance
    ]
      .forEach(
        input => {

          if (!input) return;


          input.addEventListener(
            "input",
            calculate
          );

          input.addEventListener(
            "change",
            calculate
          );

        }
      );


    el.addChildBtn.addEventListener(
      "click",
      () => {

        addChild(
          2015
        );

      }
    );


    el.saveScenarioBtn.addEventListener(
      "click",
      () => {

        if (!latestResult) return;


        savedScenario = {
          capital:
            latestResult.avdCapital,

          pension:
            latestResult.avdMonthlyNet
        };


        el.savedCapital.textContent =
          euro.format(
            savedScenario.capital
          );


        el.savedPension.textContent =
          euro.format(
            savedScenario.pension
          ) +
          " / Monat";


        el.savedScenarioBox.hidden =
          false;

      }
    );


    el.clearScenarioBtn.addEventListener(
      "click",
      () => {

        savedScenario =
          null;

        el.savedScenarioBox.hidden =
          true;

      }
    );


    el.resetCalculatorBtn.addEventListener(
      "click",
      () => {

        el.monthly.value =
          150;

        el.riesterTransfer.value =
          0;

        el.currentAge.value =
          40;

        el.retirementAge.value =
          67;

        el.payoutUntil.value =
          85;

        el.avdReturn.value =
          6;

        el.avdCosts.value =
          1;

        el.etfReturn.value =
          6;

        el.etfCosts.value =
          0.25;

        el.taxRateNow.value =
          30;

        el.taxRateRetirement.value =
          22;

        el.inflationRate.value =
          2;

        el.payoutReturn.value =
          2;

        el.taxAllowance.value =
          1000;


        children =
          [];


        renderChildren();

        calculate();

      }
    );


    document
      .querySelectorAll(
        ".infoBtn"
      )
      .forEach(
        button => {

          button.addEventListener(
            "click",
            event => {

              event.preventDefault();

              event.stopPropagation();


              el.tooltip.textContent =
                tooltipTexts[
                  button.dataset.tip
                ] || "";


              el.tooltip.hidden =
                false;


              const rect =
                button
                  .getBoundingClientRect();


              const parent =
                document
                  .querySelector(
                    ".input-card"
                  );


              const parentRect =
                parent
                  .getBoundingClientRect();


              el.tooltip.style.left =
                Math.max(
                  10,
                  rect.left -
                  parentRect.left -
                  30
                ) +
                "px";


              el.tooltip.style.top =
                (
                  rect.bottom -
                  parentRect.top +
                  10
                ) +
                "px";

            }
          );

        }
      );


    document.addEventListener(
      "click",
      event => {

        if (
          !event.target.closest(
            ".infoBtn"
          ) &&
          !event.target.closest(
            ".tooltip"
          )
        ) {

          el.tooltip.hidden =
            true;

        }

      }
    );


    if (
      el.leadForm
    ) {

      el.leadForm.addEventListener(
        "submit",
        event => {

          event.preventDefault();


          alert(
            "Die Zoho-Forms-/Writer-Anbindung für die persönliche PDF-Auswertung richten wir im nächsten Schritt ein."
          );

        }
      );

    }


    /* ---------------------------------------------------------
       START
    ---------------------------------------------------------- */

    renderChildren();

    calculate();

  </script>


