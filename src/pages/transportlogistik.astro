
---
import BaseLayout from "../layouts/BaseLayout.astro";

// Rein illustrative Modellrechnung, kein konkretes Solvium-Angebot.
const eur = (value: number) => new Intl.NumberFormat("de-DE", { style: "currency", currency: "EUR" }).format(value);
const example = { price: 20000, months: 60, rent: 200, buyback: 14000 };
const totalRent = example.rent * example.months;
const totalReturn = totalRent + example.buyback;
// Monatlicher interner Zinsfuß, anschließend effektive Jahresverzinsung.
const npv = (rate: number) => -example.price + Array.from({length: example.months}, (_, i) => example.rent / (1 + rate) ** (i + 1)).reduce((a, b) => a + b, 0) + example.buyback / (1 + rate) ** example.months;
let lower = 0;
let upper = 0.1;
for (let i = 0; i < 100; i++) {
  const middle = (lower + upper) / 2;
  if (npv(middle) > 0) lower = middle; else upper = middle;
}
const modelIrr = new Intl.NumberFormat("de-DE", {maximumFractionDigits: 2, minimumFractionDigits: 2}).format(((1 + (lower + upper) / 2) ** 12 - 1) * 100);
const checks = [
  ["Ertrag", "Was bleibt über die gesamte Laufzeit?", "Kaufpreis, Agio, Mietzahlungen und Rückkauf gemeinsam betrachten. Die laufende Miete ist keine Renditekennzahl."],
  ["Nachfrage", "Wer nutzt die Container?", "Endnutzer, Einsatzmärkte und Vermietungsstruktur prüfen. Paketlogistik, Straßengüterverkehr und Welthandel haben unterschiedliche Nachfragetreiber und unterliegen Schwankungen."],
  ["Substanz", "Was gehört mir tatsächlich?", "Eigentumsverschaffung, Identifizierbarkeit der Wechselkoffer oder Container und Durchsetzbarkeit der Rechte anhand der Verträge nachvollziehen."],
  ["Aufwand", "Wer trägt welche Kosten?", "Vertraglich klären, wer Wartung, Reparaturen, Verwaltung und Versicherungen bezahlt. Ausschlüsse, Selbstbehalte und Folgen eines Nutzerausfalls gehören in dieselbe Prüfung."],
  ["Zukunftsfähigkeit", "Was kann sich verändern?", "Technische Anforderungen, Gebrauchtpreise, Transportwege und die wirtschaftliche Lage der beteiligten Unternehmen können das Ergebnis beeinflussen."],
  ["Steuern", "Wie sieht das persönliche Ergebnis aus?", "Steuerliche Einordnung, mögliche Abzüge und das persönliche Ergebnis nach Steuern anhand der konkreten Vertragsgestaltung gesondert klären."],
  ["Exit", "Wer bezahlt den Rückkauf?", "Ein vereinbarter Preis ist eine vertragliche Verpflichtung. Seine Zahlung hängt von der Zahlungsfähigkeit des Vertragspartners ab."],
  ["Portfolio", "Wie viel Bindung passt zu meinem Vermögen?", "Liquiditätsreserve, bestehende Risiken und Anlagehorizont bestimmen, ob und in welcher Größe dieser Baustein sinnvoll sein kann."],
];
const contact = "mailto:ch.gradt@gradt-consulting.de?subject=" + encodeURIComponent("Transportlogistik – Solvium-Direktanlagen prüfen");
---

<BaseLayout title="Transportlogistik & Solvium-Direktanlagen | Vermögenslotse">
  <div class="transportPage">
    <section class="tlHero" aria-labelledby="tl-title">
      <nav class="tlBreadcrumb" aria-label="Brotkrumennavigation"><a href="/sachwerte">Sachwerte & Direktanlagen</a><span aria-hidden="true">/</span><span>Transportlogistik</span></nav>
      <div class="tlHeroGrid">
        <div>
          <p class="tlEyebrow">TRANSPORTLOGISTIK · DIREKTANLAGEN</p>
          <h1 id="tl-title">Waren bewegen.<br /><span>Vermögen durchdacht ergänzen.</span></h1>
          <p class="tlLead">Wechselkoffer und Container halten Warenströme in Bewegung. Als Direktanlagen können sie laufende Mietzahlungen in Ihr Vermögen bringen.</p>
          <p>Doch aus einem weltweit benötigten Transportmittel wird nicht automatisch eine gute Kapitalanlage. Entscheidend sind Kaufpreis, Vertragsstruktur, Zahlungsfähigkeit der Partner und der Rückfluss am Ende.</p>
          <div class="tlButtons"><a class="tlButton" href="#anlageformen">Wechselkoffer & Container verstehen <span aria-hidden="true">↗</span></a><a class="tlTextLink" href="#pruefung">Mein Prüfrahmen ↓</a></div>
          <p class="tlSmall">Sachwerte verstehen. Zahlungsströme prüfen. Bewusst entscheiden.</p>
        </div>
        <div class="tlVisual">
          <p class="tlEyebrow">DER WIRTSCHAFTLICHE KREISLAUF</p>
          <div class="tlContainers" aria-hidden="true"><div class="tlContainer tlContainerTop">NUTZWERT</div><div class="tlContainerRow"><div class="tlContainer">SUBSTANZ</div><div class="tlContainer tlContainerOrange">ERTRAG</div></div></div>
          <div class="tlRoute"><span>Erwerben</span><b aria-hidden="true">→</b><span>Vermieten</span><b aria-hidden="true">→</b><span>Rückkauf</span></div>
          <p class="tlVisualStatement">Reales Eigentum.<br /><strong>Vertragliche Abhängigkeiten.</strong></p>
          <p class="tlVisualNote">Beides gehört in dieselbe Entscheidung.</p>
        </div>
      </div>
      <aside class="tlRisk"><strong>Wichtiger Risikohinweis</strong><p>Der Erwerb dieser Vermögensanlage ist mit erheblichen Risiken verbunden und kann zum vollständigen Verlust des eingesetzten Vermögens führen. Der in Aussicht gestellte Ertrag ist nicht gewährleistet und kann auch niedriger ausfallen.</p></aside>
    </section>

    <section class="tlSection" aria-labelledby="funktion-title">
      <p class="tlEyebrow">VOM TRANSPORTMITTEL ZUM INVESTMENT</p>
      <h2 id="funktion-title">Sie investieren in die Ausrüstung.<br />Und in das Funktionieren der Verträge.</h2>
      <div class="tlSplit"><p class="tlLead">Die Grundidee ist greifbar: Sie erwerben Wechselkoffer oder Container, vermieten diese und erhalten dafür vereinbarte Zahlungen.</p><p>Bei einem entsprechend ausgestalteten Solvium-Direktinvestment erwerben Sie Transportausrüstung und vermieten sie an die jeweilige Emittentin. Diese organisiert die weitere Vermietung beziehungsweise Nutzung. Mietdauer, Zahlungstermine, Kostenverteilung und ein möglicher Rückkauf werden vertraglich festgelegt. Eigentum am Sachwert ersetzt dabei nicht die Prüfung der Vertragspartner.</p></div>
      <ol class="tlSteps">
        <li><span>01 / KAUF</span><h3>Konkrete Transportausrüstung</h3><p>Je nach Verfügbarkeit erwerben Sie Wechselkoffer oder Container. Welche Einheiten Ihnen gehören und wie Eigentum übertragen und dokumentiert wird, regelt der konkrete Vertrag.</p></li>
        <li><span>02 / MIETE</span><h3>Monatliche Zahlungen</h3><p>Bei monatlich zahlenden Konzepten erhalten Sie die vereinbarte Miete regelmäßig nachschüssig. Der konkrete Zahlungsbeginn und die Termine stehen im Vertrag. Die tatsächlichen Zahlungen hängen von der Leistungsfähigkeit der Vertragspartner ab.</p></li>
        <li><span>03 / RÜCKKAUF</span><h3>Ein vereinbarter Endpunkt</h3><p>Sieht das Angebot einen Rückkauf vor, sind Preis und Zeitpunkt vertraglich zu prüfen. Eine mögliche Verlängerung hat eigene Bedingungen. Beides hängt vom jeweiligen Konzept ab und beeinflusst die gesamte Zahlungsreihe.</p></li>
      </ol>
    </section>

    <section class="tlSection tlTint" id="anlageformen" aria-labelledby="anlageformen-title">
      <p class="tlEyebrow">ZWEI ANLAGEWELTEN · EIN PRÜFMASSSTAB</p>
      <h2 id="anlageformen-title">Wechselkoffer und Container.<br />Ähnliches Prinzip. Unterschiedliche Einsatzmärkte.</h2>
      <p class="tlIntro">Im Mittelpunkt stehen für mich Wechselkoffer und Container – je nach Verfügbarkeit und Qualität des konkreten Angebots. Entscheidend ist, wie die Transportausrüstung genutzt wird und ob die Vertragsstruktur zu dieser Nutzung passt.</p>
      <div class="tlSplit">
        <article class="tlAssetType"><p class="tlEyebrow">01 / WECHSELKOFFER</p><h3>Flexibilität auf der Straße.</h3><p>Wechselkoffer sind austauschbare Ladebehälter, die vom Trägerfahrzeug getrennt und auf eigenen Stützbeinen abgestellt werden können. Der Laderaum kann be- oder entladen werden, während das Fahrzeug mit einer anderen Einheit weiterfährt.</p><p>Sie kommen insbesondere im europäischen Straßengüterverkehr sowie in Paket- und Stückgutnetzen zum Einsatz. Ihr wirtschaftlicher Nutzen liegt in effizienten Fahrzeugwechseln und Transportabläufen.</p><strong>In der Prüfung:</strong><p class="tlSmall">Nutzerstruktur, Zustand, Alter, Wartung, Auslastung und Wiederverwendbarkeit im jeweiligen Logistiknetz.</p></article>
        <article class="tlAssetType"><p class="tlEyebrow">02 / CONTAINER</p><h3>Standardisierung über Grenzen hinweg.</h3><p>Standardcontainer ermöglichen den Transport von Gütern über unterschiedliche Verkehrsträger hinweg. Spezialcontainer, etwa Tank- oder Gas-Tankcontainer, erfüllen zusätzliche Anforderungen bestimmter Ladungen.</p><p>Je nach Bauart unterscheiden sich Einsatzmärkte, Kaufpreise, technische Prüfungen und Verwertungsmöglichkeiten. Deshalb verdient jeder Typ eine eigene wirtschaftliche Betrachtung.</p><strong>In der Prüfung:</strong><p class="tlSmall">Containertyp, Einsatzgebiet, Nutzer, technischer Zustand, Prüfpflichten und realistischer Zweitmarktwert.</p></article>
      </div>
      <p class="tlSmall">Diese Seite erklärt das Anlageprinzip. Sie stellt keine aktuell verfügbaren Einzelangebote dar. Welche Direktanlagen sich konkret prüfen lassen, klären wir im persönlichen Gespräch.</p>
    </section>

    <section class="tlSection" id="zahlungsstroeme" aria-labelledby="rendite-title">
      <div class="tlSplit tlExampleIntro"><div><p class="tlEyebrow">RENDITE RICHTIG LESEN</p><h2 id="rendite-title">12 % laufende Miete.<br /><span>Was bleibt tatsächlich?</span></h2></div><div><p class="tlLead">Eine Mietzahlung ist noch keine Anlagerendite.</p><p>Für die Gesamtrechnung zählen der Kaufpreis einschließlich Nebenkosten, sämtliche Mietzahlungen und der verbleibende Wert am Ende. Liegt der Rückkaufpreis unter dem Kaufpreis, muss dieser Wertverlust mitgerechnet werden.</p></div></div>
      <div class="tlCalculation"><p class="tlEyebrow">FREI GEWÄHLTE MODELLANNAHMEN · KEIN KONKRETES ANGEBOT</p><p>Gedankliches Beispiel für Transportausrüstung: fünf Jahre Laufzeit, monatliche Zahlung am Monatsende, vollständiger Rückkauf am Ende des 60. Monats. Alle Zahlen sind ausschließlich zur Erklärung gewählt und gelten weder speziell für Wechselkoffer noch für Container.</p><dl><div><dt>Kaufpreis zu Beginn</dt><dd>− {eur(example.price)}</dd></div><div><dt>60 Monatsmieten à {eur(example.rent)}</dt><dd>+ {eur(totalRent)}</dd></div><div><dt>Angenommener Rückkauf nach 60 Monaten</dt><dd>+ {eur(example.buyback)}</dd></div><div class="tlTotal"><dt>Rechnerischer Überschuss vor Kosten und Steuern</dt><dd>{eur(totalReturn - example.price)}</dd></div></dl><p>Gesamtrückfluss: <strong>{eur(totalReturn)}</strong>. Die jährliche Miete beträgt rechnerisch 12 % des Kaufpreises. Der interne Zinsfuß der gesamten Modellzahlungsreihe beträgt dagegen rund <strong>{modelIrr} % p. a.</strong> (effektive Jahresverzinsung).</p><p class="tlSmall">Vereinfachend ohne Agio, sonstige Kosten und Steuern; diese vermindern das Ergebnis. Der erste Mietzufluss erfolgt im Modell einen Monat nach Kauf. Verzögerungen oder Ausfälle verschlechtern das Ergebnis. Die Modellwerte sind weder Prognose noch Zusage und sagen nichts über Konditionen oder Verfügbarkeit realer Angebote aus.</p></div>
    </section>

    <section class="tlSection tlDark" aria-labelledby="solvium-title"><div class="tlSplit"><div><p class="tlEyebrow">DEN ANBIETER EINORDNEN</p><h2 id="solvium-title">Solvium liefert das Konzept.<br />Der Prüfmaßstab bleibt Ihrer.</h2></div><div><p>Solvium ist seit 2011 im Bereich Logistikinvestments tätig. Zum Anlageuniversum gehören unter anderem Wechselkoffer, Standardcontainer und Spezialcontainer. Die jeweilige Anlageform ist gesondert zu prüfen: Ein Direktinvestment unterscheidet sich von einer Fondsbeteiligung oder einem Zinsprodukt.</p><p>Solvium organisiert im Rahmen seiner Konzepte die Beschaffung und Bewirtschaftung von Transportausrüstung. Welche Gesellschaft Ihr Vertragspartner ist, wie sie wirtschaftlich aufgestellt ist und welche Rechte Sie besitzen, ergibt sich aus den jeweiligen Unterlagen. Historische Ergebnisse ersetzen diese Prüfung nicht.</p><p class="tlDarkStatement">Nicht die Geschichte allein entscheidet.<br /><strong>Sondern die Tragfähigkeit des konkreten Angebots.</strong></p></div></div></section>

    <section class="tlSection" id="pruefung" aria-labelledby="check-title"><p class="tlEyebrow">DER VERMÖGENSLOTSE-CHECK</p><h2 id="check-title">Acht Fragen vor der Entscheidung.</h2><p class="tlIntro">Der Prüfrahmen der Sachwertseite wird hier konkret: am Wechselkoffer oder Container, am Vertrag und an Ihrer Vermögensstruktur.</p><div class="tlChecks">{checks.map(([title, question, text], index) => <article><span class="tlCheckNumber">{String(index + 1).padStart(2, "0")}</span><h3>{title}</h3><strong>{question}</strong><p>{text}</p></article>)}</div></section>

    <section class="tlSection tlTint" aria-labelledby="risiken-title"><p class="tlEyebrow">CHANCEN UND GRENZEN</p><h2 id="risiken-title">Ein Sachwert bleibt eine Investition mit Risiko.</h2><div class="tlSplit"><div><h3>Was den Baustein interessant machen kann</h3><ul class="tlList"><li>Bei entsprechender Vertragsgestaltung direktes Eigentum an wirtschaftlich genutzten Wechselkoffern oder Containern.</li><li>Vertraglich vereinbarte monatliche Mietzahlungen.</li><li>Ein vertraglich definierter Rückkaufpreis, soweit das Konzept einen Rückkauf vorsieht.</li><li>Eine zusätzliche Ertragsquelle außerhalb des Wertpapierdepots.</li></ul></div><div><h3>Was Sie dafür tragen</h3><ul class="tlList"><li>Ausfall- und Insolvenzrisiken der beteiligten Unternehmen, bis hin zum Totalverlust.</li><li>Kapitalbindung und eingeschränkte Möglichkeiten eines vorzeitigen Verkaufs.</li><li>Risiken aus Marktentwicklung, Verwertung und Durchsetzung von Eigentumsrechten.</li><li>Versicherungslücken sowie Abhängigkeit von der tatsächlichen Erfüllung der Miet- und Rückkaufverpflichtungen.</li></ul></div></div><p class="tlSmall">Eigentum am Sachwert ist keine Zahlungsgarantie. Eine Sachversicherung ersetzt keine Absicherung gegen den Ausfall des Miet- oder Rückkaufpartners; ihr Leistungsumfang ist gesondert zu prüfen. Ob die Anlage zu einer besseren Streuung führt, hängt vom gesamten Portfolio ab.</p></section>

    <section class="tlSection" aria-labelledby="faq-title"><p class="tlEyebrow">HÄUFIGE FRAGEN</p><h2 id="faq-title">Vor dem Kauf Klarheit schaffen.</h2><div class="tlFaq">
      <details><summary>Ist der vereinbarte Rückkauf garantiert?</summary><p>Die Emittentin verpflichtet sich vertraglich zum Rückkauf. Das ist keine unabhängige Zahlungsgarantie. Kann der Vertragspartner seine Verpflichtung nicht erfüllen, kann der tatsächliche Rückfluss geringer ausfallen oder ausbleiben.</p></details>
      <details><summary>Kann ich vorzeitig über mein Geld verfügen?</summary><p>Planen Sie mit einer Bindung über die vereinbarte Laufzeit. Eine jederzeitige Veräußerung zu einem bestimmten Preis ist nicht zugesichert. Kündigungs- und Übertragungsmöglichkeiten sind anhand des jeweiligen Vertrags zu prüfen.</p></details>
      <details><summary>Wie funktioniert eine Verlängerung?</summary><p>Ob eine Verlängerung vorgesehen ist, ergibt sich aus dem konkreten Vertrag. Eine einvernehmliche Verlängerung setzt die Zustimmung beider Seiten voraus. Neue Miet- und Rückkaufkonditionen müssen als eigene Zahlungsreihe bewertet werden.</p></details>
      <details><summary>Welche Unterlagen brauche ich für die Entscheidung?</summary><p>Die vollständigen Angebots- und Vertragsunterlagen einschließlich Risikodarstellung, Angaben zur Emittentin, Eigentumsverschaffung, Versicherung und sämtlichen Kosten. Eine kurze Werbeübersicht ersetzt diese Prüfung nicht.</p></details>
    </div></section>

    <section class="tlContact" aria-labelledby="kontakt-title"><div><p class="tlEyebrow">ERST EINORDNEN. DANN ENTSCHEIDEN.</p><h2 id="kontakt-title">Passt Transportlogistik<br />in Ihre Vermögensstruktur?</h2><p>Wir prüfen gemeinsam das konkrete Angebot, seine Zahlungsströme und Risiken – und welche Kapitalbindung zu Ihrer Planung passt.</p></div><div class="tlContactActions"><a class="tlButton" href={contact}>Solvium-Direktanlage besprechen <span aria-hidden="true">→</span></a><a class="tlTextLink" href="/kontakt">Zum Kontaktformular</a><span class="tlSmall">Christian Gradt · Dipl.-Betriebswirt</span></div></section>
    <p class="tlSources">Allgemeine Informationen zum Anlageprinzip, keine Darstellung aktuell verfügbarer Angebote. Anbieterinformationen: <a href="https://www.solvium-capital.de/investment/privatanleger/">Solvium: Transportausrüstung und Bewirtschaftung</a>. Konkrete Rechte, Kosten und Risiken ergeben sich ausschließlich aus den jeweiligen Angebots- und Vertragsunterlagen. Die Beispielkalkulation verwendet frei gewählte Annahmen und ist keine Renditeprognose.</p>
  </div>
</BaseLayout>

<style>
  .transportPage{--tl-green:var(--c-primary,#284830);--tl-orange:var(--c-accent,#d87808);--tl-line:#dce3da;color:var(--tl-green);line-height:1.7;padding-bottom:30px}
  .transportPage *{box-sizing:border-box}.transportPage p{margin:0 0 1.1em}.transportPage h1,.transportPage h2,.transportPage h3{color:var(--tl-green);line-height:1.15;letter-spacing:-.035em}.transportPage h1{font-size:clamp(2.25rem,4.7vw,4.1rem);margin:20px 0 24px}.transportPage h1 span,.tlExampleIntro h2 span{color:#61745f}.transportPage h2{font-size:clamp(1.9rem,3.2vw,2.9rem);margin:10px 0 28px}.transportPage h3{font-size:1.22rem;margin:12px 0 16px;letter-spacing:-.02em}.transportPage a{color:inherit}.transportPage a:focus-visible,.transportPage summary:focus-visible{outline:3px solid var(--tl-orange);outline-offset:5px}
  .tlHero{padding:30px 0 0}.tlBreadcrumb{display:flex;flex-wrap:wrap;gap:12px;font-size:.8rem;margin-bottom:38px}.tlBreadcrumb a{text-decoration:underline;text-underline-offset:4px}.tlHeroGrid{display:grid;grid-template-columns:1.15fr 1fr;gap:48px;align-items:center}.tlEyebrow{font-size:.69rem;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:#905005;margin-bottom:14px!important}.tlLead{font-size:1.18rem;line-height:1.65}.tlButtons{display:flex;flex-wrap:wrap;gap:23px;align-items:center;margin:28px 0 20px}.tlButton{display:inline-flex;justify-content:space-between;align-items:center;gap:22px;background:var(--tl-green);color:#fff!important;border-radius:11px;padding:14px 20px;font-weight:750;font-size:.94rem;text-decoration:none;transition:transform .15s}.tlButton:hover{transform:translateY(-2px)}.tlTextLink{font-size:.88rem;font-weight:700;text-underline-offset:5px}.tlSmall{font-size:.79rem;line-height:1.65;color:#53634f}.tlVisual{background:#eef1e9;padding:32px;border:1px solid var(--tl-line);border-radius:22px;overflow:hidden}.tlContainers{padding:36px 0 26px}.tlContainer{position:relative;display:flex;align-items:center;justify-content:center;min-height:100px;background:repeating-linear-gradient(90deg,transparent 0 14px,#ffffff1a 14px 17px),#284830;color:#fff;border:5px solid #36563b;box-shadow:inset 0 0 0 2px #ffffff30;font-size:.7rem;font-weight:800;letter-spacing:.15em}.tlContainerTop{width:54%;margin-left:8%;margin-bottom:7px;transform:rotate(-3deg)}.tlContainerRow{display:grid;grid-template-columns:1fr 1fr;gap:7px}.tlContainerOrange{background:repeating-linear-gradient(90deg,transparent 0 14px,#ffffff29 14px 17px),#ad5b00;border-color:#b76a13}.tlRoute{display:flex;justify-content:space-between;gap:8px;font-size:.8rem;border-bottom:1px solid #cad3c5;padding:14px 0 22px}.tlRoute b{color:#8e4e00}.tlVisualStatement{font-size:1.6rem;letter-spacing:-.03em;line-height:1.3;margin:25px 0 12px!important}.tlVisualNote{font-size:.83rem;margin-bottom:0!