    <!-- ===================================================== -->
    <!-- NAVIGATION STYLES                                    -->
    <!-- ===================================================== -->

    <style>

      /* ----------------------------------------------------- */
      /* HEADER                                                */
      /* ----------------------------------------------------- */

      .siteHeader {
        position: sticky;
        top: 0;
        z-index: 1000;
        overflow: visible;
      }

      .headerInner {
        position: relative;
      }


      /* ----------------------------------------------------- */
      /* HAUPTNAVIGATION                                       */
      /* ----------------------------------------------------- */

      .site-nav {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 4px;
      }


      .navLink,
      .navDropdownTrigger {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;

        min-height: 42px;

        padding: 9px 10px;

        border: 0;
        border-radius: 11px;

        background: transparent;

        color: var(--c-primary);

        font: inherit;
        font-size: .94rem;
        font-weight: 700;

        line-height: 1;

        white-space: nowrap;

        cursor: pointer;

        transition:
          background .15s ease,
          color .15s ease,
          transform .15s ease;
      }


      .navLink:hover,
      .navDropdownTrigger:hover {
        text-decoration: none;

        background: rgba(40,72,48,.07);
      }


      .navLink.active,
      .navDropdown.active > .navDropdownTrigger {
        background: rgba(40,72,48,.09);

        color: var(--c-primary);
      }


      /* ----------------------------------------------------- */
      /* DROPDOWN BASIS                                        */
      /* ----------------------------------------------------- */

      .navDropdown {
        position: relative;
      }


      .navChevron {
        display: inline-block;

        margin-top: -1px;

        font-size: .72rem;

        transition: transform .18s ease;
      }


      .navDropdown.isOpen .navChevron,
      .navDropdown:focus-within .navChevron {
        transform: rotate(180deg);
      }


      .navDropdownPanel {
        position: absolute;

        top: calc(100% + 10px);
        right: 0;

        visibility: hidden;

        opacity: 0;

        pointer-events: none;

        transform: translateY(-5px);

        transition:
          opacity .16s ease,
          transform .16s ease,
          visibility .16s ease;
      }


      /*
       * Kleiner unsichtbarer Übergangsbereich.
       * Dadurch schließt sich das Menü nicht,
       * wenn der Cursor vom Button zum Panel bewegt wird.
       */

      .navDropdownPanel::before {
        content: "";

        position: absolute;

        top: -12px;
        left: 0;
        right: 0;

        height: 14px;
      }


      .navDropdown:hover > .navDropdownPanel,
      .navDropdown:focus-within > .navDropdownPanel,
      .navDropdown.isOpen > .navDropdownPanel {
        visibility: visible;

        opacity: 1;

        pointer-events: auto;

        transform: translateY(0);
      }


      /* ----------------------------------------------------- */
      /* TOOLBOX DROPDOWN                                      */
      /* ----------------------------------------------------- */

      .toolboxDropdownPanel {
        display: grid;

        grid-template-columns: 235px 1fr;

        width: min(680px, calc(100vw - 40px));

        overflow: hidden;

        border: 1px solid rgba(40,72,48,.13);
        border-radius: 20px;

        background: #ffffff;

        box-shadow:
          0 22px 65px rgba(0,0,0,.13);
      }


      .dropdownIntro {
        padding: 26px 24px;

        background:
          radial-gradient(
            340px 180px at 0% 0%,
            rgba(216,120,8,.18),
            transparent 65%
          ),
          linear-gradient(
            160deg,
            #284830 0%,
            #1d3725 100%
          );

        color: #ffffff;
      }


      .dropdownEyebrow {
        margin: 0 0 10px;

        font-size: .68rem;

        font-weight: 800;

        letter-spacing: .1em;

        color: var(--c-accent);
      }


      .dropdownIntro h2 {
        margin: 0 0 12px;

        font-size: 1.35rem;

        line-height: 1.2;

        color: #ffffff;
      }


