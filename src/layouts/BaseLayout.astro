        border-radius: 12px;

        background: var(--c-accent);

        color: #ffffff;

        font-size: .84rem;

        font-weight: 800;

        box-shadow:
          0 10px 26px rgba(216,120,8,.20);
      }


      .contactBookingButton:hover {
        text-decoration: none;

