    function basicAllowance(
      yearlyContribution
    ) {

      if (
        yearlyContribution <
        120
      ) {
        return 0;
      }


      const funded =
        Math.min(
          yearlyContribution,
          1800
        );


      const firstStage =
        Math.min(
          funded,
          360
        ) *
        0.50;


      const secondStage =
        Math.max(
          0,
          funded -
          360
        ) *
        0.25;


      return (
        firstStage +
        secondStage
      );

    }


    function eligibleChildrenForYear(
      year
    ) {

      return children.filter(
        child => {

          const age =
            year -
            child.birthYear;


          return (
            age >= 0 &&
            age < 25
          );

        }
      ).length;

    }


    function childAllowance(
      yearlyContribution,
      year
    ) {

      if (
        yearlyContribution <
        120
      ) {
        return 0;
      }


      const childCount =
        eligibleChildrenForYear(
          year
        );


      const allowancePerChild =
        Math.min(
          yearlyContribution,
          300
        );


      return (
        childCount *
        allowancePerChild
      );

    }


    function taxBenefit(
      yearlyContribution,
      allowance,
      taxRate
    ) {

      const fundedContribution =
        Math.min(
          yearlyContribution,
          1800
        );


      const deductible =
        fundedContribution +
        allowance;


      const grossTaxEffect =
        deductible *
        (
          taxRate /
          100
        );


      return Math.max(
        0,
        grossTaxEffect -
        allowance
      );

    }


    function applyFundYearTax(
      capitalBeforeGain,
      capitalAfterGain,
      taxAllowance
    ) {

      const gain =
        Math.max(
          0,
          capitalAfterGain -
          capitalBeforeGain
        );


      const taxableGain =
        Math.max(
          0,
          gain *
          0.70 -
          taxAllowance
        );


      const taxRate =
        0.26375;


      const tax =
        taxableGain *
        taxRate;


      return Math.max(
        0,
        capitalAfterGain -
        tax
      );

    }


    function annuityPayment(
      capital,
      years,
      annualReturn
    ) {

      const months =
        Math.max(
          1,
          years *
          12
        );


      const monthlyRate =
        annualReturn /
        100 /
        12;


      if (
        monthlyRate <=
        0
      ) {

        return (
          capital /
          months
        );

      }


      return (
        capital *
        monthlyRate /
        (
          1 -
          Math.pow(
            1 +
            monthlyRate,
            -months
          )
        )
      );

    }


    function calculateModel() {

      const monthly =
        Number(
          el.monthly.value
        );


      const yearlyContribution =
        monthly *
        12;


      const riesterTransfer =
        Number(
          el.riesterTransfer.value
        );


      const currentAge =
        Number(
          el.currentAge.value
        );


      const retirementAge =
        Math.max(
          65,
          Number(
            el.retirementAge.value
          )
        );


      const payoutUntil =
        Math.max(
          85,
          Number(
            el.payoutUntil.value
          )
        );


      const yearsToRetirement =
        Math.max(
          1,
          retirementAge -
          currentAge
        );


      const payoutYears =
        Math.max(
          1,
          payoutUntil -
          retirementAge
        );


      const avdReturnInput =
        Number(
          el.avdReturn.value
        );


      const avdCostsInput =
        Number(
          el.avdCosts.value
        );


      const fundReturnInput =
        Number(
          el.fundReturn.value
        );


      const fundCostsInput =
        Number(
          el.fundCosts.value
        );


      const taxNowInput =
        Number(
          el.taxRateNow.value
        );


      const taxRetirementInput =
        Number(
          el.taxRateRetirement.value
        );


      const inflationInput =
        Number(
          el.inflationRate.value
        );


      const payoutReturnInput =
        Number(
          el.payoutReturn.value
        );


      const taxAllowanceInput =
        Number(
          el.taxAllowance.value
        );


      const avdNetReturn =
        Math.max(
          -0.99,
          (
            avdReturnInput -
            avdCostsInput
          ) /
          100
        );


      const fundNetReturn =
        Math.max(
          -0.99,
          (
            fundReturnInput -
            fundCostsInput
          ) /
          100
        );


      const inflation =
        inflationInput /
        100;


      const taxRetirement =
        taxRetirementInput /
        100;


      let avdFunded =
        riesterTransfer;


      let avdUnfunded =
        0;


      let avdUnfundedBasis =
        0;


      let fundCapital =
        0;


      let totalOwn =
        0;


      let totalAllowances =
        0;


      let totalBasicAllowances =
        0;


      let totalChildAllowances =
        0;


      let totalTaxBenefits =
        0;


      const labels =
        [];


      const avdSeries =
        [];


      const fundSeries =
        [];


      const annualRows =
        [];


      for (
        let yearIndex = 0;
        yearIndex <= yearsToRetirement;
        yearIndex++
      ) {

        const calendarYear =
          2027 +
          yearIndex;


        const age =
          currentAge +
          yearIndex;


        labels.push(
          String(
            age
          )
        );


        avdSeries.push(
          avdFunded +
          avdUnfunded
        );


        fundSeries.push(
          fundCapital
        );


        if (
          yearIndex ===
          yearsToRetirement
        ) {
          break;
        }


        const fundedOwn =
          Math.min(
            yearlyContribution,
            1800
          );


        const unfundedOwn =
          Math.max(
            0,
            yearlyContribution -
            fundedOwn
          );


        const basic =
          basicAllowance(
            fundedOwn
          );


        const child =
          childAllowance(
            fundedOwn,
            calendarYear
          );


        const allowance =
          basic +
          child;


        const taxRefund =
          taxBenefit(
            fundedOwn,
            allowance,
            taxNowInput
          );


        totalOwn +=
          yearlyContribution;


        totalBasicAllowances +=
          basic;


        totalChildAllowances +=
          child;


        totalAllowances +=
          allowance;


        totalTaxBenefits +=
          taxRefund;


        annualRows.push({
          calendarYear,
          basic,
          child,
          allowance,
          taxRefund
        });


        avdFunded +=
          fundedOwn +
          allowance;


        avdFunded *=
          (
            1 +
            avdNetReturn
          );


        avdUnfunded +=
          unfundedOwn +
          taxRefund;


        avdUnfundedBasis +=
          unfundedOwn +
          taxRefund;


        avdUnfunded *=
          (
            1 +
            avdNetReturn
          );


        const fundBeforeGain =
          fundCapital +
          yearlyContribution;


        const fundAfterGain =
          fundBeforeGain *
          (
            1 +
            fundNetReturn
          );


        fundCapital =
          applyFundYearTax(
            fundBeforeGain,
            fundAfterGain,
            taxAllowanceInput
          );

      }


      const avdCapital =
        avdFunded +
        avdUnfunded;


      const realCapital =
        avdCapital /
        Math.pow(
          1 +
          inflation,
          yearsToRetirement
        );


      const fundedNetCapital =
        avdFunded *
        (
          1 -
          taxRetirement
        );


      const unfundedGain =
        Math.max(
          0,
          avdUnfunded -
          avdUnfundedBasis
        );


      const effectiveCapitalGainTax =
        0.26375 *
        0.70;


      const unfundedNetCapital =
        avdUnfundedBasis +
        unfundedGain *
        (
          1 -
          effectiveCapitalGainTax
        );


      const avdNetCapitalForPayout =
        fundedNetCapital +
        unfundedNetCapital;


      const avdMonthlyNet =
        annuityPayment(
          avdNetCapitalForPayout,
          payoutYears,
          payoutReturnInput
        );


      const fundPayoutReturn =
        payoutReturnInput *
        (
          1 -
          effectiveCapitalGainTax
        );


      const fundMonthlyNet =
        annuityPayment(
          fundCapital,
          payoutYears,
          fundPayoutReturn
        );


      const firstYear =
        annualRows[0] ||
        {
          basic: 0,
          child: 0,
          allowance: 0,
          taxRefund: 0
        };


      const effectiveOwnCost =
        Math.max(
          0,
          (
            yearlyContribution -
            firstYear.allowance -
            firstYear.taxRefund
          ) /
          12
        );


      const investmentGrowth =
        avdCapital -
        totalOwn -
        totalAllowances -
        totalTaxBenefits -
        riesterTransfer;


      const firstYearSupport =
        firstYear.allowance +
        firstYear.taxRefund;


      const firstYearSupportRate =
        yearlyContribution >
        0
          ? (
              firstYearSupport /
              yearlyContribution
            ) *
            100
          : 0;


      const childBirthYears =
        children.map(
          child =>
            Number(
              child.birthYear
            )
        );


      return {

        monthly,
        yearlyContribution,

        riesterTransfer,

        currentAge,
        retirementAge,
        payoutUntil,

        yearsToRetirement,
        payoutYears,

        childCount:
          children.length,

        childBirthYears,

        avdReturnInput,
        avdCostsInput,

        fundReturnInput,
        fundCostsInput,

        taxNowInput,
        taxRetirementInput,

        inflationInput,
        payoutReturnInput,

        taxAllowanceInput,

        avdCapital,
        fundCapital,

        realCapital,

        avdMonthlyNet,
        fundMonthlyNet,

        effectiveOwnCost,

        totalOwn,

        totalBasicAllowances,
        totalChildAllowances,
        totalAllowances,

        totalTaxBenefits,

        investmentGrowth,

        firstYearBasicAllowance:
          firstYear.basic,

        firstYearChildAllowance:
          firstYear.child,

        firstYearAllowance:
          firstYear.allowance,

        firstYearTaxBenefit:
          firstYear.taxRefund,

        firstYearSupportRate,

        labels,
        avdSeries,
        fundSeries

      };

    }


