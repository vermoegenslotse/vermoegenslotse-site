---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Vermögenslotse – Strategische Vermögensarchitektur">

  <!-- ===================================================== -->
  <!-- HERO                                                  -->
  <!-- ===================================================== -->

  <section class="homeHero">

    <div class="homeHeroGrid">

      <div class="homeHeroContent">

        <p class="homeEyebrow">
          ARCHITEKTUR + KAPITALMARKTLOGIK
        </p>

        <h1>
          Sie haben Vermögen aufgebaut.<br />
          <span>Aber ist es auch bereit für das, was vor Ihnen liegt?</span>
        </h1>

        <p class="homeHeroLead">
          Vermögen wächst oft über viele Jahre.
          Was dabei nicht automatisch entsteht, ist eine klare Architektur.
        </p>

        <p class="homeHeroText">
          Ich verbinde Vermögensstruktur, Kapitalmarktlogik und
          nachvollziehbare Risikogrenzen zu einem System,
          das Entscheidungen planbarer macht und unnötige Überraschungen reduziert.
        </p>

        <div class="homeHeroActions">

          <a
            class="homePrimaryButton"
            href="/vermoegen-strukturieren"
          >
            Vermögensarchitektur verstehen
            <span aria-hidden="true">→</span>
          </a>

          <a
            class="homeTextLink"
            href="/so-arbeite-ich"
          >
            So arbeite ich
          </a>

        </div>

        <div class="homeHeroMeta">

          <span>Struktur statt Produktlogik</span>
          <span>Risiko in Euro denken</span>
          <span>Regeln statt Bauchgefühl</span>

        </div>

      </div>


      <div class="homeHeroSide">

        <div class="homeHeroPhoto">

          <img
            src="/images/christian-hero.png"
            alt="Christian Gradt"
            loading="eager"
          />

        </div>

        <aside class="homeHeroPanel">

          <p class="homePanelLabel">
            WORUM ES MIR GEHT
          </p>

          <ul>
            <li>
              Vermögen als Gesamtsystem betrachten
            </li>

            <li>
              jedem Baustein eine klare Funktion geben
            </li>

            <li>
              Risiken sichtbar und belastbar machen
            </li>

            <li>
              Entscheidungen nachvollziehbar strukturieren
            </li>
          </ul>

          <p class="homePanelHint">
            Keine Produktshow. Kein „Top-10“.
            Sondern eine belastbare Vermögensarchitektur.
          </p>

        </aside>

      </div>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- WIEDERERKENNUNG                                       -->
  <!-- ===================================================== -->

  <section class="homeRecognition reveal">

    <div class="homeSectionIntro">

      <p class="homeEyebrow">
        VIELLEICHT ERKENNEN SIE SICH HIER WIEDER
      </p>

      <h2>
        Vermögen ist vorhanden – aber die Struktur dahinter ist nicht immer klar.
      </h2>

    </div>


    <div class="homeRecognitionGrid">

      <div class="homeRecognitionItem">

        <span class="homeCheck">
          ✓
        </span>

        <p>
          Mein Depot ist über Jahre gewachsen –
          aber ich habe keinen klaren Gesamtüberblick.
        </p>

      </div>


      <div class="homeRecognitionItem">

        <span class="homeCheck">
          ✓
        </span>

        <p>
          Ich lese viel über Märkte und Geldanlage –
          und werde mit jedem Artikel unsicherer.
        </p>

      </div>


      <div class="homeRecognitionItem">

        <span class="homeCheck">
          ✓
        </span>

        <p>
          Ich möchte Struktur und nachvollziehbare Regeln –
          nicht die nächste Produktempfehlung.
        </p>

      </div>


      <div class="homeRecognitionItem">

        <span class="homeCheck">
          ✓
        </span>

        <p>
          Ich möchte mein Vermögen langfristig steuern können –
          auch im Ruhestand und in schwierigen Marktphasen.
        </p>

      </div>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- VERTRAUEN / PROVENEXPERT                              -->
  <!-- ===================================================== -->

  <section class="homeTrust reveal">

    <div class="homeTrustHeader">

      <div>

        <p class="homeEyebrow">
          ERFAHRUNGEN AUS DER PRAXIS
        </p>

        <h2>
          Vertrauen entsteht nicht durch Versprechen.
        </h2>

        <p>
          Entscheidend ist, wie Mandanten die Zusammenarbeit tatsächlich erleben.
        </p>

      </div>

    </div>


    <div class="homeTrustGrid">

      <div class="homeTrustQuotes">

        <blockquote class="homeQuote">

          <p>
            „Endlich ein Regelwerk statt Einzelentscheidungen.
            Ich weiß jetzt, wann gehandelt wird – und wann nicht.“
          </p>

          <footer>
            Mandant · Unternehmer
          </footer>

        </blockquote>


        <blockquote class="homeQuote">

          <p>
            „Ich verstehe mein Risiko, weil wir es in Euro definiert haben.
            Das macht Entscheidungen deutlich ruhiger.“
          </p>

          <footer>
            Mandantin · Privatanlegerin
          </footer>

        </blockquote>

      </div>


      <div class="homeProvenExpert">

        <p class="homeTrustLabel">
          VERIFIZIERTE BEWERTUNGEN
        </p>

        <div class="homeProvenExpertInner">

          <!-- ProvenExpert Bewertungssiegel -->
          <div id="pewl"></div>

          <script
            is:inline
            type="text/javascript"
            src="https://www.provenexpert.com/widget/landing_christian-gradt-consulting.js?feedback=1&avatar=1&competence=1&language=de-de&style=white"
            async
          ></script>

          <link
            rel="stylesheet"
            type="text/css"
            href="https://www.provenexpert.com/css/widget_landing.css"
            media="screen,print"
          />
          <!-- ProvenExpert Bewertungssiegel Ende -->

        </div>

      </div>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- VERMÖGENSARCHITEKTUR                                  -->
  <!-- ===================================================== -->

  <section class="homeArchitecture reveal">

    <div class="homeArchitectureGrid">

      <div>

        <p class="homeEyebrow">
          DER VERMÖGENSLOTSE-ANSATZ
        </p>

        <h2>
          Gute Einzelanlagen ergeben noch keine gute Vermögensarchitektur.
        </h2>

        <p class="homeArchitectureLead">
          Entscheidend ist nicht nur,
          <strong>was</strong> Sie besitzen –
          sondern welche Aufgabe jeder Baustein übernimmt
          und wie alles zusammenwirkt.
        </p>

        <p>
          Vermögensarchitektur verbindet Ziel, Zeithorizont,
          Liquidität, Renditequellen und Belastungsgrenzen
          zu einer nachvollziehbaren Gesamtstruktur.
        </p>


        <a
          class="homePrimaryButton homeArchitectureButton"
          href="/vermoegen-strukturieren"
        >
          Vermögen strukturieren
          <span aria-hidden="true">
            →
          </span>
        </a>

      </div>


      <div class="homeArchitectureCards">

        <article>

          <span class="homeRuleNumber">
            01
          </span>

          <h3>
            Klare Rollen
          </h3>

          <p>
            Jeder Vermögensbaustein braucht eine Aufgabe.
            Produkte ohne Funktion erhöhen Komplexität,
            aber nicht automatisch die Qualität.
          </p>

        </article>


        <article>

          <span class="homeRuleNumber">
            02
          </span>

          <h3>
            Echte Diversifikation
          </h3>

          <p>
            Unterschiedliche Namen und Fonds sind noch keine Diversifikation.
            Entscheidend sind unterschiedliche Risiken und Ertragsquellen.
          </p>

        </article>


        <article>

          <span class="homeRuleNumber">
            03
          </span>

          <h3>
            Definierte Belastungsgrenzen
          </h3>

          <p>
            Risiko wird erst greifbar,
            wenn klar ist, welche Schwankung und welcher Verlust
            finanziell und emotional tragbar sind.
          </p>

        </article>


        <article>

          <span class="homeRuleNumber">
            04
          </span>

          <h3>
            Regelbasierte Steuerung
          </h3>

          <p>
            Entscheidungen sollten aus einem System entstehen –
            nicht aus Schlagzeilen, Prognosen oder kurzfristigen Emotionen.
          </p>

        </article>

      </div>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- TOOLBOX + WISSEN                                      -->
  <!-- ===================================================== -->

  <section class="homeOrientation reveal">

    <div class="homeSectionIntro">

      <p class="homeEyebrow">
        ORIENTIERUNG OHNE VERPFLICHTUNG
      </p>

      <h2>
        Sie möchten zunächst selbst genauer hinschauen?
      </h2>

      <p>
        Dafür gibt es zwei Wege:
        selbst prüfen oder ein Thema zunächst vertiefen.
      </p>

    </div>


    <div class="homeOrientationGrid">


      <!-- TOOLBOX -->

      <article class="homeOrientationCard homeOrientationToolbox">

        <div class="homeOrientationIcon">
          01
        </div>

        <h3 class="homeOrientationTitle">
          Toolbox
        </h3>

        <p class="homeOrientationSubtitle">
          Rechnen. Prüfen. Einordnen.
        </p>

        <p>
          Interaktive Rechner und Checks helfen dabei,
          einzelne Fragestellungen direkt auf Ihre eigene Situation
          zu übertragen.
        </p>

        <ul>

          <li>
            Vermögenscheck
          </li>

          <li>
            Depotblindfleckencheck
          </li>

          <li>
            Ruhestands-Navigator
          </li>

          <li>
            Altersvorsorgedepot-Rechner
          </li>

        </ul>

        <a
          href="/toolbox"
          class="homeCardLink"
        >
          Toolbox öffnen
          <span aria-hidden="true">
            →
          </span>
        </a>

      </article>


      <!-- WISSEN -->

      <article class="homeOrientationCard homeOrientationKnowledge">

        <div class="homeOrientationIcon">
          02
        </div>

        <h3 class="homeOrientationTitle">
          Wissen
        </h3>

        <p class="homeOrientationSubtitle">
          Lesen. Verstehen. Vertiefen.
        </p>

        <p>
          Broschüren, Leitfäden und Fachinformationen
          helfen Ihnen dabei, finanzielle Zusammenhänge
          zunächst selbst besser zu verstehen.
        </p>

        <ul>

          <li>
            Vermögen & Kapitalanlage
          </li>

          <li>
            Ruhestand & Entnahme
          </li>

          <li>
            Altersvorsorge & Riester
          </li>

          <li>
            Unternehmer & Vermögensschutz
          </li>

        </ul>

        <a
          href="/wissen"
          class="homeCardLink"
        >
          Wissensbereich öffnen
          <span aria-hidden="true">
            →
          </span>
        </a>

      </article>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- AKTUELL: RIESTER 2027 + ALTERSVORSORGEDEPOT           -->
  <!-- ===================================================== -->

  <section class="homeCurrent reveal">

    <div class="homeCurrentGrid">

      <div>

        <div class="homeCurrentBadge">
          AKTUELL · RIESTER 2027 & ALTERSVORSORGEDEPOT
        </div>

        <h2>
          Riester 2027 & Altersvorsorgedepot:
          Was bedeutet die neue Vorsorgewelt für Sie?
        </h2>

        <p class="homeCurrentLead">
          Die private Altersvorsorge steht vor einem grundlegenden Wandel.
          Mit dem Altersvorsorgedepot entstehen neue Möglichkeiten –
          gleichzeitig stellt sich für bestehende Riester-Verträge die Frage,
          wie mit ihnen künftig sinnvoll umgegangen werden sollte.
        </p>

        <p>
          Wer bereits einen Riester-Vertrag besitzt, sollte Garantien,
          Rentenfaktor, Kosten, Restlaufzeit und bestehende Vertragsrechte
          berücksichtigen. Wer bisher keinen Riester-Vertrag hat,
          für den kann das Altersvorsorgedepot einen neuen Zugang
          zur geförderten privaten Altersvorsorge eröffnen.
        </p>

        <p class="homeCurrentPrinciple">
          <strong>
            Entscheidend ist nicht, was neu ist –
            sondern was zur eigenen Situation passt.
          </strong>
        </p>

      </div>


      <div class="homeCurrentActions">

        <a
          class="homeCurrentPrimary"
          href="/altersvorsorgedepot"
        >
          Altersvorsorgedepot verstehen
        </a>

        <a
          class="homeCurrentSecondary"
          href="https://riesterapp.de/a/6AGQYBL"
          target="_blank"
          rel="noopener noreferrer"
        >
          Riester-Vertrag prüfen ↗
        </a>

        <span>
          Riester-Check über externe Prüfplattform
        </span>

      </div>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- UNTERNEHMER                                           -->
  <!-- ===================================================== -->

  <section class="homeEntrepreneur reveal">

    <div class="homeEntrepreneurGrid">

      <div>

        <p class="homeEyebrow">
          SPEZIELL FÜR UNTERNEHMER
        </p>

        <h2>
          Unternehmervermögen hat zusätzliche Ebenen.
        </h2>

        <p class="homeEntrepreneurLead">
          Wer ein Unternehmen aufgebaut hat,
          trägt häufig einen erheblichen Teil seines Vermögens
          und seines Risikos im eigenen Betrieb.
        </p>

        <p>
          Deshalb sollten Privatvermögen, Liquidität,
          Betriebsvermögen, Haftungs- und Umfeldrisiken
          sowie langfristige Vermögensziele nicht isoliert betrachtet werden.
        </p>

        <a
          class="homePrimaryButton"
          href="/vermoegensstrategie-unternehmer"
        >
          Vermögensstrategie für Unternehmer
          <span aria-hidden="true">
            →
          </span>
        </a>

      </div>


      <div class="homeEntrepreneurPoints">

        <div>

          <span>
            01
          </span>

          <p>
            Betriebsvermögen und Privatvermögen
            bewusst voneinander unterscheiden
          </p>

        </div>


        <div>

          <span>
            02
          </span>

          <p>
            Liquidität mit einer klaren Funktion
            statt als zufälligen Rest betrachten
          </p>

        </div>


        <div>

          <span>
            03
          </span>

          <p>
            Risiken aus dem Unternehmensumfeld
            in die Vermögensstrategie integrieren
          </p>

        </div>


        <div>

          <span>
            04
          </span>

          <p>
            Nachfolge und langfristige Vermögensstruktur
            frühzeitig mitdenken
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- ÜBER MICH                                             -->
  <!-- ===================================================== -->

  <section class="homeAbout reveal">

    <div class="homeAboutGrid">

      <div class="homeAboutPhoto">

        <img
          src="/images/christian-hero2.png"
          alt="Christian Gradt"
          loading="lazy"
        />

      </div>


      <div>

        <p class="homeEyebrow">
          ÜBER CHRISTIAN GRADT
        </p>

        <h2>
          Erfahrung hilft vor allem dann,
          wenn sie zu klareren Entscheidungen führt.
        </h2>

        <p class="homeAboutLead">
          Diplom-Betriebswirt mit Studienschwerpunkt Steuer & Revision
          und seit über 30 Jahren in der Beratung tätig.
        </p>

        <p>
          Ich habe unterschiedliche Marktphasen,
          Krisen und Produkttrends erlebt.
          Gerade deshalb arbeite ich heute mit klaren Strukturen,
          definierten Parametern und nachvollziehbaren Entscheidungsregeln.
        </p>

        <p>
          Als Sachverständiger für das Versicherungswesen
          betrachte ich zusätzlich die Risiken,
          die Vermögensziele außerhalb des Kapitalmarktes gefährden können.
        </p>


        <div class="homeAboutPills">

          <span>
            30+ Jahre Beratungserfahrung
          </span>

          <span>
            Diplom-Betriebswirt
          </span>

          <span>
            Sachverständigen-Kompetenz
          </span>

        </div>


        <a
          class="homeTextLink homeAboutLink"
          href="/ueber-mich"
        >
          Mehr über mich und meine Denkweise →
        </a>

      </div>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- ZUSAMMENARBEIT                                        -->
  <!-- ===================================================== -->

  <section class="homeProcess reveal">

    <div class="homeSectionIntro">

      <p class="homeEyebrow">
        ZUSAMMENARBEIT
      </p>

      <h2>
        Vom ersten Überblick zur belastbaren Struktur.
      </h2>

      <p>
        Keine unnötige Komplexität.
        Sondern ein klarer Prozess mit nachvollziehbaren nächsten Schritten.
      </p>

    </div>


    <div class="homeProcessGrid">

      <article>

        <span class="homeProcessNo">
          01
        </span>

        <h3>
          Orientierung
        </h3>

        <p>
          Wir klären Ihre Situation,
          Ziele und die Fragestellungen,
          die tatsächlich relevant sind.
        </p>

      </article>


      <article>

        <span class="homeProcessNo">
          02
        </span>

        <h3>
          Analyse & Architektur
        </h3>

        <p>
          Vermögensbausteine,
          Risiken und Prioritäten werden geordnet
          und zu einer belastbaren Struktur verbunden.
        </p>

      </article>


      <article>

        <span class="homeProcessNo">
          03
        </span>

        <h3>
          Umsetzung & Steuerung
        </h3>

        <p>
          Entscheidungen werden schrittweise umgesetzt
          und langfristig anhand klarer Regeln gesteuert.
        </p>

      </article>

    </div>


    <div class="homeTransparency">

      <div>

        <h3>
          Leistungen & Vergütung transparent dargestellt.
        </h3>

        <p>
          Welche Leistungen Sie erhalten, wie eine Zusammenarbeit
          aufgebaut ist und wie die Vergütung geregelt ist,
          können Sie vorab nachvollziehen.
        </p>

      </div>

      <a
        href="/angebote"
        class="homeTransparencyLink"
      >
        Leistungen & Vergütung ansehen
        <span aria-hidden="true">
          →
        </span>
      </a>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- KONTAKT                                               -->
  <!-- ===================================================== -->

  <section class="homeContact reveal">

    <div class="homeContactInner">

      <p class="homeEyebrow">
        DER NÄCHSTE SCHRITT
      </p>

      <h2>
        Sie müssen nicht gleich einen Termin vereinbaren.
      </h2>

      <p class="homeContactLead">
        Wenn Sie eine Frage haben oder Ihr Anliegen zunächst
        ganz formlos schildern möchten, schreiben Sie mir einfach.
        Ich melde mich persönlich bei Ihnen.
      </p>


      <div class="homeContactActions">

        <a
          class="homePrimaryButton"
          href="/kontakt"
        >
          Nachricht senden
          <span aria-hidden="true">
            →
          </span>
        </a>

        <a
          class="homeSecondaryButton"
          href="https://chgradt-gradt-consulting.zohobookings.eu/#/242656000000190002"
          target="_blank"
          rel="noopener noreferrer"
        >
          Orientierungsgespräch vereinbaren
        </a>

      </div>


      <p class="homeContactMail">
        Alternativ direkt per E-Mail:
        <a href="mailto:ch.gradt@gradt-consulting.de">
          ch.gradt@gradt-consulting.de
        </a>
      </p>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- STYLES                                                -->
  <!-- ===================================================== -->

  <style>

    /* ----------------------------------------------------- */
    /* BASIS                                                 */
    /* ----------------------------------------------------- */

    .homeEyebrow {
      margin: 0 0 9px;
      color: var(--c-accent);
      font-size: .76rem;
      font-weight: 800;
      letter-spacing: .11em;
    }


    .homeSectionIntro {
      max-width: 820px;
      margin-bottom: 28px;
    }


    .homeSectionIntro h2 {
      margin: 0 0 12px;
      color: var(--c-primary);
      font-size: clamp(28px, 3.4vw, 41px);
      line-height: 1.18;
      letter-spacing: -.35px;
    }


    .homeSectionIntro > p:not(.homeEyebrow) {
      margin: 0;
      max-width: 720px;
      color: rgba(20,35,24,.70);
      line-height: 1.7;
    }


    .homePrimaryButton,
    .homeSecondaryButton {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 13px;
      padding: 12px 17px;
      border-radius: 12px;
      font-weight: 800;
      transition:
        transform .15s ease,
        box-shadow .15s ease,
        background .15s ease;
    }


    .homePrimaryButton {
      background: var(--c-accent);
      color: #ffffff;
      box-shadow:
        0 11px 28px rgba(216,120,8,.20);
    }


    .homePrimaryButton:hover {
      text-decoration: none;
      transform: translateY(-1px);
      box-shadow:
        0 15px 33px rgba(216,120,8,.25);
    }


    .homeSecondaryButton {
      background: #ffffff;
      color: var(--c-primary);
      border: 1px solid rgba(40,72,48,.22);
    }


    .homeSecondaryButton:hover {
      text-decoration: none;
      background: rgba(40,72,48,.05);
      transform: translateY(-1px);
    }


    .homeTextLink {
      color: var(--c-primary);
      font-weight: 800;
    }


    /* ----------------------------------------------------- */
    /* HERO                                                  */
    /* ----------------------------------------------------- */

    .homeHero {
      position: relative;
      overflow: hidden;
      padding: 54px 42px;
      border-radius: 26px;
      background:
        radial-gradient(
          850px 360px at 4% 0%,
          rgba(216,120,8,.13),
          transparent 58%
        ),
        radial-gradient(
          700px 340px at 96% 20%,
          rgba(40,72,48,.12),
          transparent 62%
        ),
        linear-gradient(
          180deg,
          #ffffff 0%,
          #f5f8f5 100%
        );
      border: 1px solid rgba(40,72,48,.11);
      box-shadow:
        0 20px 60px rgba(0,0,0,.055);
    }


    .homeHeroGrid {
      display: grid;
      grid-template-columns: 1.25fr .75fr;
      gap: 46px;
      align-items: center;
    }


    .homeHeroContent h1 {
      margin: 0 0 19px;
      max-width: 820px;
      color: var(--c-primary);
      font-size: clamp(40px, 5.2vw, 62px);
      line-height: 1.04;
      letter-spacing: -1px;
    }


    .homeHeroContent h1 span {
      color: rgba(40,72,48,.76);
    }


    .homeHeroLead {
      max-width: 720px;
      margin: 0 0 12px;
      color: rgba(20,35,24,.90);
      font-size: 1.20rem;
      line-height: 1.6;
      font-weight: 700;
    }


    .homeHeroText {
      max-width: 720px;
      margin: 0;
      color: rgba(20,35,24,.69);
      line-height: 1.72;
    }


    .homeHeroActions {
      display: flex;
      align-items: center;
      gap: 18px;
      flex-wrap: wrap;
      margin-top: 23px;
    }


    .homeHeroMeta {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 24px;
    }


    .homeHeroMeta span {
      padding: 7px 10px;
      border-radius: 999px;
