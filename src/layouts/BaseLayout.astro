                  Gesamte Toolbox öffnen
                  <span aria-hidden="true">→</span>
                </a>

              </div>

            </div>

          </div>


          <!-- ================================================= -->
          <!-- RIESTER 2027                                      -->
          <!-- ================================================= -->

          <a
            class:list={[
              "navLink",
              "navRiester",
              { active: isRiesterActive }
            ]}
            href="/altersvorsorgedepot"
          >

            <span
              class="riesterDot"
              aria-hidden="true"
            ></span>

            <span>
              Riester 2027
            </span>

          </a>


          <!-- ================================================= -->
          <!-- KONTAKT DROPDOWN                                  -->
          <!-- ================================================= -->

          <div
            class:list={[
              "navDropdown",
              "navDropdownContact",
              { active: isContactActive }
            ]}
            data-dropdown
          >

            <button
              class="navDropdownTrigger contactTrigger"
              type="button"
              aria-expanded="false"
              aria-haspopup="true"
              data-dropdown-trigger
            >

              <span>Kontakt</span>

              <span
