          <!-- ================================================= -->
          <!-- TOOLBOX DROPDOWN                                  -->
          <!-- ================================================= -->

          <div
            class:list={[
              "navDropdown",
              "navDropdownToolbox",
              { active: isToolboxActive }
            ]}
            data-dropdown
          >

            <button
              class="navDropdownTrigger"
              type="button"
              aria-expanded="false"
              aria-haspopup="true"
              data-dropdown-trigger
            >
              <span>Toolbox</span>

              <span
                class="navChevron"
                aria-hidden="true"
              >
                ▾
              </span>
            </button>


            <div
              class="navDropdownPanel toolboxDropdownPanel"
              data-dropdown-panel
            >

              <div class="dropdownIntro">

                <p class="dropdownEyebrow">
                  VERMÖGENSLOTSE TOOLBOX
                </p>

                <h2>
                  Selbst prüfen.<br />
                  Besser einordnen.
                </h2>

                <p>
                  Rechner, Checks und Fachinformationen
                  für bessere finanzielle Entscheidungen.
                </p>

              </div>


              <div class="toolboxDropdownContent">

                <p class="dropdownSectionLabel">
                  RECHNEN & PRÜFEN
                </p>


                <a
                  class="dropdownTool"
                  href="/vermoegenscheck"
                >
                  <span class="dropdownToolTitle">
                    Vermögenscheck
                  </span>

                  <span class="dropdownToolText">
                    Vermögen und Gesamtstruktur einordnen
                  </span>
                </a>


                <a
                  class="dropdownTool"
                  href="/depotblindfleckencheck"
                >
                  <span class="dropdownToolTitle">
                    Depotblindfleckencheck
                  </span>

                  <span class="dropdownToolText">
                    Strukturelle Schwachstellen erkennen
                  </span>
                </a>


                <a
                  class="dropdownTool"
                  href="/ruhestands-navigator"
                >
                  <span class="dropdownToolTitle">
                    Ruhestands-Navigator
                  </span>

                  <span class="dropdownToolText">
                    Kapitalbedarf und Reichweite modellieren
                  </span>
                </a>


                <a
                  class="dropdownTool"
