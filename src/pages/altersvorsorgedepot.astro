        "Ihr monatlicher Eigenbeitrag. Jeder andere Betrag kann frei eingetragen werden.",

      income:
        "Das Bruttojahreseinkommen dient der späteren steuerlichen Einordnung. In dieser Version wird es noch nicht steuerlich optimiert.",

      birthyear:
        "Aus dem Geburtsjahr wird der Zeitraum bis zum Renteneintritt abgeleitet. Die Berechnung startet modellhaft mit 2027.",

      retirement:
        "Standardmäßig wird mit Renteneintritt 67 gerechnet. Sie können den Wert anpassen.",

      return:
        "Angenommene jährliche Rendite nach Kosten. Die Berechnung erfolgt modellhaft mit monatlicher Verzinsung.",

      inflation:
        "Inflation reduziert die Kaufkraft des späteren Vermögens. Standardwert: 2 % pro Jahr.",

      children:
        "Für Kinder wird modellhaft eine Kinderzulage von bis zu 300 € pro Kind und Jahr berücksichtigt."
    };


    const tooltip =
      document.getElementById(
        "tooltip"
      );


    function annualSubsidy(
      monthly,
      children
    ) {

      const yearly =
        monthly * 12;


      const stage1 =
        Math.min(
          yearly,
          360
        ) * 0.5;


      const stage2 =
        Math.max(
          0,
          Math.min(
            yearly,
            1800
          ) - 360
        ) * 0.25;


      const childSubsidy =
        Math.min(
          monthly * 12,
          children * 300
        );


      return (
        stage1 +
        stage2 +
        childSubsidy
      );
    }


    function compoundMonthly(
      monthlyContribution,
      yearlySubsidy,
      years,
      annualReturn
    ) {

      const r =
        annualReturn /
        100 /
        12;


      let capital =
        0;


      const labels =
        [];

      const deposits =
        [];

      const subsidies =
        [];

      const total =
        [];


      for (
        let y = 0;
        y <= years;
        y++
      ) {

        labels.push(
          String(
            2027 + y
          )
        );


        deposits.push(
          monthlyContribution *
          12 *
          y
        );


        subsidies.push(
          yearlySubsidy *
          y
        );


        total.push(
          capital
        );


        for (
          let m = 0;
          m < 12 &&
          y < years;
          m++
        ) {

          capital =
            capital *
            (1 + r) +
            monthlyContribution +
            yearlySubsidy / 12;
        }
      }


      return {
        final: capital,
        labels,
        deposits,
        subsidies,
        total
      };
    }


    function calculate() {

      const monthly =
        Number(
          els.monthly.value || 0
        );


      const birthyear =
        Number(
          els.birthyear.value || 1990
        );


      const retirementAge =
        Number(
          els.retirementAge.value || 67
        );


      const children =
        Number(
          els.children.value || 0
        );


      const returnRate =
        Number(
          els.returnRate.value || 5
        );


      const inflation =
        Number(
          els.inflationRate.value || 2
        );


      const currentYear =
        2027;


      const age =
        currentYear -
        birthyear;


      const years =
        Math.max(
          0,
          retirementAge -
          age
        );


      const subsidy =
        annualSubsidy(
          monthly,
          children
        );


      const avd =
        compoundMonthly(
          monthly,
          subsidy,
          years,
          returnRate
        );


      const etf =
        compoundMonthly(
          monthly,
          0,
          years,
          returnRate
        );


      const realValue =
        avd.final /
        Math.pow(
          1 +
          inflation / 100,
          years
        );


      const advantage =
        avd.final -
        etf.final;


      els.returnLabel.textContent =
        returnRate
          .toFixed(1)
          .replace(
            ".",
            ","
          ) +
        " %";


      els.inflationLabel.textContent =
        inflation
          .toFixed(1)
          .replace(
            ".",
            ","
          ) +
        " %";


      els.headline.textContent =
        `Brutto-Vermögen mit ${retirementAge}`;


      els.totalSubsidy.textContent =
        euro.format(
          subsidy *
          years
        );


      els.avdFinal.textContent =
        euro.format(
          avd.final
        );


      els.realValue.textContent =
        euro.format(
          realValue
        );


      els.compareAvd.textContent =
        euro.format(
          avd.final
        );


      els.compareEtf.textContent =
        euro.format(
          etf.final
        );


      els.advantage.textContent =
        euro.format(
          advantage
        );


      els.summaryText.innerHTML =
        `Bei Renteneintritt mit <strong>${retirementAge}</strong> und ` +
        `<strong>${returnRate.toFixed(1).replace(".", ",")} %</strong> Rendite nach Kosten ` +
        `beträgt Ihr geschätztes Brutto-Vermögen im Altersvorsorgedepot ` +
        `<strong>${euro.format(avd.final)}</strong>. Bei ` +
        `<strong>${inflation.toFixed(1).replace(".", ",")} %</strong> Inflation entspricht dies ` +
        `einer heutigen Kaufkraft von <strong>${euro.format(realValue)}</strong>.`;


      drawChart(
        avd.labels,
        avd.deposits,
        avd.subsidies,
        avd.total
      );
    }


    function drawChart(
      labels,
      deposits,
      subsidies,
      total
    ) {

      const ctx =
        document.getElementById(
          "growthChart"
        );


      if (chart) {

        chart.destroy();

      }


      chart =
        new Chart(
          ctx,
          {

            type: "line",

            data: {

              labels,

              datasets: [

                {
                  label:
                    "Einzahlungen",

                  data:
                    deposits,

                  borderColor:
                    "#8d969d",

                  backgroundColor:
                    "rgba(141,150,157,.15)",

                  fill:
                    true,

                  tension:
                    0.25
                },


                {
                  label:
                    "Förderung",

                  data:
                    subsidies,

                  borderColor:
                    "#1e88c8",

                  backgroundColor:
                    "rgba(30,136,200,.18)",

                  fill:
                    true,

                  tension:
                    0.25
                },


                {
                  label:
                    "Gesamtvermögen",

                  data:
                    total,

                  borderColor:
                    "#1f6b3a",

                  backgroundColor:
                    "rgba(31,107,58,.18)",

                  fill:
                    true,

                  tension:
                    0.25
                }

              ]
            },


            options: {

              responsive:
                true,


              plugins: {

                legend: {

                  position:
                    "bottom"

                }
              },


              scales: {

                y: {

                  ticks: {

                    callback:
                      value =>
                        euro.format(
                          value
                        )
                  }
                }
              }
            }
          }
        );
    }


    document
      .querySelectorAll(
        "#rechner input"
      )
      .forEach(
        input => {

          input.addEventListener(
            "input",
            calculate
          );

        }
      );


    document
      .querySelectorAll(
        ".quickButtons button"
      )
      .forEach(
        button => {

          button.addEventListener(
            "click",
            () => {

              document
                .querySelectorAll(
                  ".quickButtons button"
                )
                .forEach(
                  b =>
                    b.classList.remove(
                      "active"
                    )
                );


              button.classList.add(
                "active"
              );


              els.monthly.value =
                button.dataset.value;


              calculate();
            }
          );
        }
      );


    els.monthly.addEventListener(
      "input",
      () => {

        document
          .querySelectorAll(
            ".quickButtons button"
          )
          .forEach(
            b => {

              b.classList.toggle(
                "active",
                b.dataset.value ===
                els.monthly.value
              );

            }
          );
      }
    );


    document
      .querySelectorAll(
        ".infoBtn"
      )
      .forEach(
        btn => {

          btn.addEventListener(
            "click",
            event => {

              event.stopPropagation();


              tooltip.textContent =
                tooltipTexts[
                  btn.dataset.tip
                ] || "";


              tooltip.hidden =
                false;


              const rect =
                btn
                  .getBoundingClientRect();


              const parentRect =
                document
                  .querySelector(
                    ".input-card"
                  )
                  .getBoundingClientRect();


              tooltip.style.left =
                `${
                  rect.left -
                  parentRect.left -
                  10
                }px`;


              tooltip.style.top =
                `${
                  rect.bottom -
                  parentRect.top +
                  10
                }px`;
            }
          );
        }
      );


    document.addEventListener(
      "click",
      e => {

        if (
          !e.target.closest(
            ".infoBtn"
          ) &&
          !e.target.closest(
            ".tooltip"
          )
        ) {

          tooltip.hidden =
            true;

        }
      }
    );


    els.calculateBtn.addEventListener(
      "click",
      calculate
    );


    if (els.leadForm) {

      els.leadForm.addEventListener(
        "submit",
        e => {

          e.preventDefault();


          alert(
            "Die persönliche PDF-Auswertung wird im nächsten Schritt mit Zoho Forms und Zoho Writer verbunden."
          );

        }
      );
    }


    calculate();

  </script>


