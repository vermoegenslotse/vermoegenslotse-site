        );


      el.avdCapitalBar.style.width =
        (
          result.avdCapital /
          maxCapital *
          100
        ) +
        "%";


      el.fundCapitalBar.style.width =
        (
          result.fundCapital /
          maxCapital *
          100
        ) +
        "%";


      el.tableAvdCapital.textContent =
        euro.format(
          result.avdCapital
        );


      el.tableFundCapital.textContent =
        euro.format(
          result.fundCapital
        );


      el.tableAvdPension.textContent =
        euro.format(
          result.avdMonthlyNet
        );


      el.tableFundPension.textContent =
        euro.format(
          result.fundMonthlyNet
        );


      el.tableAvdSubsidies.textContent =
        euro.format(
          result.totalAllowances
        );


      drawChart(
        result
      );


      updateZohoFrame(
        result
      );

    }


    function drawChart(
      result
    ) {

      const canvas =
        document.getElementById(
          "growthChart"
        );


      if (!canvas) return;


      if (chart) {
        chart.destroy();
      }


      chart =
        new Chart(
          canvas,
          {

            type:
              "line",

            data: {

              labels:
                result.labels,

              datasets: [

                {
                  label:
                    "Altersvorsorgedepot",

                  data:
                    result.avdSeries,

                  borderColor:
                    "#1f5b35",

                  backgroundColor:
                    "rgba(31,91,53,.10)",

                  borderWidth:
                    3,

                  fill:
                    true,

                  pointRadius:
                    0,

                  tension:
                    0.25
                },


                {
                  label:
                    "Fonds-Depot",

                  data:
                    result.fundSeries,

                  borderColor:
                    "#8ca8bd",

                  backgroundColor:
                    "rgba(140,168,189,.06)",

                  borderWidth:
                    3,

                  fill:
                    false,

                  pointRadius:
                    0,

                  tension:
                    0.25
                }

              ]

            },


            options: {

              responsive:
                true,

              maintainAspectRatio:
                false,

              interaction: {
                intersect:
                  false,

                mode:
                  "index"
              },


              plugins: {

                legend: {
                  display:
                    false
                },


                tooltip: {

                  callbacks: {

                    label:
                      context =>
                        `${context.dataset.label}: ${euro.format(context.raw)}`

                  }

                }

              },


              scales: {

                x: {

                  title: {
                    display:
                      true,

                    text:
                      "Alter"
                  },

                  grid: {
                    display:
                      false
                  }

                },


                y: {

                  beginAtZero:
                    true,

                  ticks: {

                    callback:
                      value =>
                        euro.format(
                          value
                        )

                  }

                }

              }

            }

          }
        );

    }


    function calculate() {

      const result =
        calculateModel();


      updateUI(
        result
      );

    }


    [
      el.monthly,
      el.riesterTransfer,
      el.currentAge,
      el.retirementAge,
      el.payoutUntil,
      el.avdReturn,
      el.avdCosts,
      el.fundReturn,
      el.fundCosts,
      el.taxRateNow,
      el.taxRateRetirement,
      el.inflationRate,
      el.payoutReturn,
      el.taxAllowance
    ]
      .forEach(
        input => {

          if (!input) return;


          input.addEventListener(
            "input",
            calculate
          );


          input.addEventListener(
            "change",
            calculate
          );

        }
      );


    el.addChildBtn.addEventListener(
      "click",
      () => {

        addChild(
          2015
        );

      }
    );


    el.saveScenarioBtn.addEventListener(
      "click",
      () => {

        if (
          !latestResult
        ) return;


        el.savedCapital.textContent =
          euro.format(
            latestResult.avdCapital
          );


        el.savedPension.textContent =
          euro.format(
            latestResult.avdMonthlyNet
          ) +
          " / Monat";


        el.savedScenarioBox.hidden =
          false;

      }
    );


    el.clearScenarioBtn.addEventListener(
      "click",
      () => {

        el.savedScenarioBox.hidden =
          true;

      }
    );


    el.resetCalculatorBtn.addEventListener(
      "click",
      () => {

        el.monthly.value =
          150;

        el.riesterTransfer.value =
          0;

        el.currentAge.value =
          40;

        el.retirementAge.value =
          67;

        el.payoutUntil.value =
          85;

        el.avdReturn.value =
          6;

        el.avdCosts.value =
          1;

        el.fundReturn.value =
          6;

        el.fundCosts.value =
          1;

        el.taxRateNow.value =
          30;

        el.taxRateRetirement.value =
          22;

        el.inflationRate.value =
          2;

        el.payoutReturn.value =
          2;

        el.taxAllowance.value =
          1000;


        children =
          [];


        renderChildren();

        calculate();

      }
    );


    document
      .querySelectorAll(
        ".infoBtn"
      )
      .forEach(
        button => {

          button.addEventListener(
            "click",
            event => {

              event.preventDefault();

              event.stopPropagation();


              el.tooltip.textContent =
                tooltipTexts[
                  button.dataset.tip
                ] ||
                "";


              el.tooltip.hidden =
                false;


              const rect =
                button
                  .getBoundingClientRect();


              const parent =
                document
                  .querySelector(
                    ".input-card"
                  );


              const parentRect =
                parent
                  .getBoundingClientRect();


              el.tooltip.style.left =
                Math.max(
                  10,
                  rect.left -
                  parentRect.left -
                  30
                ) +
                "px";


              el.tooltip.style.top =
                (
                  rect.bottom -
                  parentRect.top +
                  10
                ) +
                "px";

            }
          );

        }
      );


    document.addEventListener(
      "click",
      event => {

        if (
          !event.target.closest(
            ".infoBtn"
          ) &&
          !event.target.closest(
            ".tooltip"
          )
        ) {

          el.tooltip.hidden =
            true;

        }

      }
    );


    renderChildren();

    calculate();

  </script>


