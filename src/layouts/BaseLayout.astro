---
type Props = {
  title?: string;
};

const { title = "Vermögenslotse" } = Astro.props;

const path = Astro.url.pathname;

const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);

const isToolboxActive = path.startsWith("/toolbox");
const isRiesterActive = path.startsWith("/altersvorsorgedepot");
const isContactActive = path.startsWith("/kontakt");
---

<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>{title}</title>

    <meta
      name="description"
      content="Strategische Vermögensarchitektur für Unternehmer und anspruchsvolle Privatanleger. Struktur statt Produktlogik – für planbare Entscheidungen und langfristige Vermögensentwicklung."
    />

    <meta
      property="og:title"
      content="Vermögenslotse – Strategische Vermögensarchitektur"
    />

    <meta
      property="og:description"
      content="Struktur statt Produktlogik – für planbare Entscheidungen und langfristige Vermögensentwicklung."
    />

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:url"
      content="https://vermoegenslotse.de"
    />

    <!--
    Optional, sobald ein Preview-Bild vorhanden ist:

    <meta
      property="og:image"
      content="https://vermoegenslotse.de/images/og-image.jpg"
    />
    -->

    <link
      rel="stylesheet"
      href="/styles/tokens.css"
    />
  </head>


  <body>

    <!-- ===================================================== -->
    <!-- HEADER / HAUPTNAVIGATION                              -->
    <!-- ===================================================== -->

    <header class="siteHeader">

      <div class="container headerInner">

        <!-- LOGO -->

        <div class="logo">

          <a
            href="/"
            class="logoLink"
            aria-label="Vermögenslotse – Startseite"
          >
            <img
              src="/images/vermoegenslotse-logo.png"
