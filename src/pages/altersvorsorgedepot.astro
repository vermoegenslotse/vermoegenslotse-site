---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Altersvorsorgedepot | Vermögenslotse">
  <main class="avd-page">

    <!-- =========================================================
         HERO
    ========================================================== -->

    <section class="avd-hero">
      <div class="container hero-grid">
        <div>
          <img
            src="/images/vermoegenslotse-logo.png"
            alt="Vermögenslotse"
            class="logo"
          />

          <p class="eyebrow">Unabhängiger Vermögenslotsen-Leitfaden</p>

          <h1>Das Altersvorsorgedepot</h1>

          <p class="lead">
            Chancen verstehen. Förderung nutzen. Entscheidungen mit System treffen.
          </p>

          <p class="heroText">
            Was die neue staatlich geförderte Altersvorsorge für Ihren Vermögensaufbau
            bedeuten kann – verständlich erklärt, unabhängig eingeordnet und ergänzt
            um einen interaktiven Rechner.
          </p>

          <div class="heroActions">
            <a class="btn" href="#broschuere">
              Broschüre kostenlos anfordern
            </a>

            <a class="btn btn--ghost" href="#rechner">
              Rechner starten
            </a>
          </div>
        </div>

        <div class="retirementHeroVisual mediaCard mediaCard--soft">
          <img
            src="/images/ihr-vermoegen-in-sicheren-bahnen.png"
            alt="Ihr Vermögen in sicheren Bahnen – systematisch zu Ihrem Anlageziel"
            loading="eager"
          />
        </div>
      </div>
    </section>


    <!-- =========================================================
         EINLEITUNG
    ========================================================== -->

    <section class="section intro-section">
      <div class="container two-col">
        <div>
          <p class="eyebrow">Warum jetzt?</p>

          <h2>Die private Altersvorsorge wird neu sortiert.</h2>

          <p>
            Das Altersvorsorgedepot soll die staatlich geförderte private Altersvorsorge
            ab 2027 stärker kapitalmarktorientiert, flexibler und für mehr Menschen
            zugänglich machen.
          </p>

          <p>
            Doch mehr Freiheit bedeutet auch mehr Verantwortung. Die entscheidende
            Frage lautet nicht, ob das Altersvorsorgedepot grundsätzlich gut ist.
          </p>

          <p>
            Die entscheidende Frage lautet:
            <strong>Passt es zu Ihrer persönlichen Situation?</strong>
          </p>
        </div>

        <div class="quoteCard">
          <span>Vermögenslotsen-Merksatz</span>

          <strong>
            Förderung ist ein Baustein. Keine Strategie.
          </strong>
        </div>
      </div>
    </section>


    <!-- =========================================================
         RECHNER
    ========================================================== -->

    <section class="section calculator-section" id="rechner">
      <div class="container sectionHeader">
        <p class="eyebrow">Interaktiver Rechner</p>

        <h2>Altersvorsorgedepot vs. ungefördertes ETF-Depot</h2>

        <p>
          Berechnen Sie modellhaft, wie sich Eigenbeitrag, Förderung, Rendite und
          Inflation langfristig auswirken können.
        </p>
      </div>


      <div class="container calculator-grid">

        <!-- Eingaben -->

        <div class="card input-card">
          <p class="eyebrow">Rechner</p>

          <h2>Ihre Eingaben</h2>


          <label class="fieldLabel">
            Monatliche Sparrate
            <button class="infoBtn" type="button" data-tip="sparrate">i</button>
          </label>

          <div class="moneyInput">
            <input
              id="monthly"
              type="number"
              value="150"
              min="0"
              step="10"
            />

            <span>€</span>
          </div>

          <p class="helpText">
            Die maximale Kinderzulage wird ab 25 € monatlich pro Kind erreicht.
            Die volle Grundzulage wird bei 150 € monatlicher Sparrate ausgeschöpft.
          </p>


          <div class="quickButtons">
            <button type="button" data-value="10">
              10 €
              <small>Mindestbeitrag</small>
            </button>

            <button type="button" data-value="150" class="active">
              150 €
              <small>Fördergrenze</small>
            </button>

            <button type="button" data-value="570">
              570 €
              <small>Maximum</small>
            </button>
          </div>


          <label class="fieldLabel">
            Bruttojahreseinkommen
            <button class="infoBtn" type="button" data-tip="income">i</button>
          </label>

          <div class="moneyInput">
            <input
              id="income"
              type="number"
              value="35000"
              min="0"
              step="1000"
            />

            <span>€</span>
          </div>


          <label class="fieldLabel">
            Geburtsjahr
            <button class="infoBtn" type="button" data-tip="birthyear">i</button>
          </label>

          <input
            id="birthyear"
            type="number"
            value="1990"
            min="1950"
            max="2010"
          />


          <label class="fieldLabel">
            Renteneintrittsalter
            <button class="infoBtn" type="button" data-tip="retirement">i</button>
          </label>

          <input
            id="retirementAge"
            type="number"
            value="67"
            min="60"
            max="70"
          />


          <label class="fieldLabel">
            Kinder
            <button class="infoBtn" type="button" data-tip="children">i</button>
          </label>

          <input
            id="children"
            type="number"
            value="0"
            min="0"
            max="10"
          />


          <label class="fieldLabel">
            Rendite nach Kosten
            <button class="infoBtn" type="button" data-tip="return">i</button>

            <span id="returnLabel" class="pillValue">
              5,0 %
            </span>
          </label>

          <input
            id="returnRate"
            type="range"
            value="5"
            min="0"
            max="10"
            step="0.1"
          />

          <div class="rangeEnds">
            <span>0 %</span>
            <span>10 %</span>
          </div>


          <label class="fieldLabel">
            Inflation
            <button class="infoBtn" type="button" data-tip="inflation">i</button>

            <span id="inflationLabel" class="pillValue">
              2,0 %
            </span>
          </label>

          <input
            id="inflationRate"
            type="range"
            value="2"
            min="0"
            max="6"
            step="0.1"
          />


          <button
            class="btn"
            id="calculateBtn"
            type="button"
          >
            Berechnung aktualisieren
          </button>


          <div
            id="tooltip"
            class="tooltip"
            hidden
          ></div>
        </div>


        <!-- Ergebnisse -->

        <div class="results-column">

          <div class="card result-card">
            <p class="eyebrow">Altersvorsorgedepot</p>

            <h2 id="headline">
              Brutto-Vermögen mit 67
            </h2>

            <div class="result-tiles">

              <div>
                <span>Gesamtförderung</span>
                <strong id="totalSubsidy">0 €</strong>
              </div>

              <div class="highlight">
                <span>Brutto-Vermögen</span>
                <strong id="avdFinal">0 €</strong>
              </div>

              <div>
                <span>Heutige Kaufkraft</span>
                <strong id="realValue">0 €</strong>
              </div>

            </div>

            <p
              class="muted"
              id="summaryText"
            ></p>
          </div>


          <div class="card result-card">
            <p class="eyebrow">Vergleich</p>

            <h2>AVD vs. ETF-Depot</h2>

            <div class="comparison">

              <div>
                <span>Altersvorsorgedepot</span>
                <strong id="compareAvd">0 €</strong>
              </div>

              <div>
                <span>ETF-Depot ohne Förderung</span>
                <strong id="compareEtf">0 €</strong>
              </div>

              <div class="highlight">
                <span>Vorteil durch Förderung</span>
                <strong id="advantage">0 €</strong>
              </div>

            </div>
          </div>

        </div>
      </div>


      <!-- Chart + spätere PDF-Auswertung -->

      <div class="container chart-grid">

        <div class="card chart-card">
          <p class="eyebrow">Verlauf</p>

          <h2>Kapitalaufbau bis Rentenbeginn</h2>

          <canvas id="growthChart"></canvas>
        </div>


        <div class="card lead-card">
          <p class="eyebrow">PDF-Auswertung</p>

          <h2>Ergebnis per E-Mail erhalten</h2>

          <p>
            Lassen Sie sich Ihre persönliche Modellrechnung zusenden und nutzen Sie
            sie als Grundlage für Ihre weitere Vorsorgeplanung.
          </p>

          <form id="leadForm">

            <input
              type="text"
              name="name"
              placeholder="Ihr Name"
              required
            />

            <input
              type="email"
              name="email"
              placeholder="Ihre E-Mail-Adresse"
              required
            />

            <input
              type="tel"
              name="phone"
              placeholder="Telefon optional"
            />


            <label class="privacyCheck">
              <input
                type="checkbox"
                required
              />

              <span>
                Ich stimme der Verarbeitung meiner Angaben gemäß Datenschutzerklärung zu.
              </span>
            </label>


            <button
              class="btn"
              type="submit"
            >
              PDF-Auswertung anfordern
            </button>

          </form>

          <p class="small">
            Die persönliche PDF-Auswertung wird im nächsten Schritt
            mit Zoho Forms und Zoho Writer verbunden.
          </p>
        </div>

      </div>
    </section>


    <!-- =========================================================
         ZIELGRUPPEN
    ========================================================== -->

    <section class="section audience-section">
      <div class="container sectionHeader">
        <p class="eyebrow">Für wen?</p>

        <h2>
          Für wen das Altersvorsorgedepot interessant sein kann
        </h2>
      </div>


      <div class="container cards-grid">

        <div class="miniCard">
          <strong>Berufseinsteiger</strong>

          <p>
            Früh starten, lange Laufzeiten nutzen und Förderung mitnehmen.
          </p>
        </div>


        <div class="miniCard">
          <strong>Familien</strong>

          <p>
            Kinderzulagen können den Vermögensaufbau deutlich unterstützen.
          </p>
        </div>


        <div class="miniCard">
          <strong>Berufstätige</strong>

          <p>
            Bestehende Vorsorge prüfen und Versorgungslücken erkennen.
          </p>
        </div>


        <div class="miniCard">
          <strong>Selbstständige</strong>

          <p>
            Erstmals kann staatlich geförderte Vorsorge relevant werden.
          </p>
        </div>

      </div>
    </section>


    <!-- =========================================================
         PERSPEKTIVEN
    ========================================================== -->

    <section class="section perspectives-section">
      <div class="container two-col">

        <div>
          <p class="eyebrow">Einordnung</p>

          <h2>
            Warum es so viele unterschiedliche Meinungen gibt
          </h2>

          <p>
            Fondsanbieter sprechen über Renditechancen. Versicherer über Sicherheit.
            Verbraucherschützer über Kosten. Die Politik über mehr private Vorsorge.
          </p>

          <p>
            Alle diese Perspektiven haben ihre Berechtigung. Entscheidend ist jedoch,
            welche Lösung zu Ihrer persönlichen Situation passt.
          </p>
        </div>


        <div class="card tableCard">

          <div>
            <span>Politik</span>
            <strong>Mehr Vorsorge</strong>
          </div>

          <div>
            <span>Fondsanbieter</span>
            <strong>Rendite</strong>
          </div>

          <div>
            <span>Versicherer</span>
            <strong>Sicherheit</strong>
          </div>

          <div>
            <span>Verbraucherschutz</span>
            <strong>Kosten</strong>
          </div>

          <div class="accent">
            <span>Vermögenslotse</span>
            <strong>Passende Lösung</strong>
          </div>

        </div>
      </div>
    </section>


    <!-- =========================================================
         BROSCHÜRE + ZOHO FORM
    ========================================================== -->

    <section
      class="section download-section"
      id="broschuere"
    >
      <div class="container two-col">

        <div class="brochureBox">
          <p class="eyebrow">
            Kostenloser Leitfaden
          </p>

          <h2>
            Broschüre zum Altersvorsorgedepot anfordern
          </h2>

          <p>
            Verständlich erklärt. Chancen und Risiken eingeordnet.
            Ohne Produktverkauf.
          </p>


          <ul>
            <li>
              Was sich durch die Reform verändert
            </li>

            <li>
              Was jetzt aus bestehenden Riester-Verträgen werden kann
            </li>

            <li>
              Welche Denkfehler Anleger vermeiden sollten
            </li>

            <li>
              Welche Fragen Sie vor einer Entscheidung stellen sollten
            </li>
          </ul>


          <p class="brochureNote">
            Nach dem Absenden erhalten Sie per E-Mail sowohl den Leitfaden
            als auch den ergänzenden Experten-Anhang.
          </p>
        </div>


        <div class="card zoho-form-card">
          <p class="eyebrow">
            Download
          </p>

          <h2>
            PDF-Broschüre erhalten
          </h2>

          <p class="zohoIntro">
            Tragen Sie Ihre Kontaktdaten ein. Anschließend erhalten Sie
            die Download-Links bequem per E-Mail.
          </p>


          <div class="zohoFormWrapper">

            <div
              id="zf_div_FCXvjeX7zWdEo3JIQ7xOG0qTW-KBMx-6ej11xdpqS7M"
            ></div>

          </div>
        </div>

      </div>
    </section>


    <!-- =========================================================
         ÜBER CHRISTIAN
    ========================================================== -->

    <section class="section expert-section">
      <div class="container expert-grid">

        <div>
          <p class="eyebrow">
            Ihr Vermögenslotse
          </p>

          <h2>
            Christian Gradt
          </h2>

          <p>
            Diplom-Betriebswirt, Sachverständiger für das Versicherungswesen (BVSV)
            und seit über 30 Jahren in der Finanzberatung tätig.
          </p>

          <p>
            Mein Ansatz: Orientierung statt Produktverkauf. Struktur statt Zufall.
            Entscheidungen mit System.
          </p>


          <div class="proofBox">
            <div class="stars">
              ★★★★★
            </div>

            <strong>
              Bewertungen auf ProvenExpert
            </strong>

            <p>
              Logo + Sterne hier einbinden.
            </p>
          </div>
        </div>


        <div class="portraitCard">
          <img
            src="/images/christian-hero2.png"
            alt="Christian Gradt – Vermögenslotse"
            loading="lazy"
          />
        </div>

      </div>
    </section>


    <!-- =========================================================
         CTA
    ========================================================== -->

    <section class="section final-cta">
      <div class="container ctaBox">

        <p class="eyebrow">
          Orientierungsgespräch
        </p>

        <h2>
          Welche Rolle kann das Altersvorsorgedepot in Ihrer Strategie spielen?
        </h2>

        <p>
          Besprechen Sie Ihre Ergebnisse persönlich und prüfen Sie,
          welche nächsten Schritte für Ihre Situation sinnvoll sind.
        </p>


        <a
          class="btn"
