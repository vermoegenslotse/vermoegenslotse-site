    /* ---------------------------------------------------------
       FÖRDERUNG
    ---------------------------------------------------------- */

    function basicAllowance(
      yearlyContribution
    ) {

      if (
        yearlyContribution < 120
      ) {
        return 0;
      }


      const funded =
        Math.min(
          yearlyContribution,
          1800
        );


      const firstStage =
        Math.min(
          funded,
          360
        ) *
        0.50;


      const secondStage =
        Math.max(
          0,
          funded - 360
        ) *
        0.25;


      return (
        firstStage +
        secondStage
      );

    }


    function eligibleChildrenForYear(
      year
    ) {

      return children.filter(
        child => {

          const age =
            year -
            child.birthYear;


          return (
            age >= 0 &&
            age < 25
          );

        }
      ).length;

    }


    function childAllowance(
      yearlyContribution,
      year
    ) {

      if (
        yearlyContribution < 120
      ) {
        return 0;
      }


      const childCount =
        eligibleChildrenForYear(
          year
        );


      const allowancePerChild =
        Math.min(
          yearlyContribution,
          300
        );


      return (
        childCount *
        allowancePerChild
      );

    }


    function totalAllowance(
      yearlyContribution,
      year
    ) {

      return (
        basicAllowance(
          yearlyContribution
        ) +
        childAllowance(
          yearlyContribution,
          year
        )
      );

    }


    function taxBenefit(
      yearlyContribution,
      allowance,
      taxRate
    ) {

      const fundedContribution =
        Math.min(
          yearlyContribution,
          1800
        );


      const deductible =
        fundedContribution +
        allowance;


      const grossTaxEffect =
        deductible *
        (
          taxRate /
          100
        );


      return Math.max(
        0,
        grossTaxEffect -
        allowance
      );

    }


    /* ---------------------------------------------------------
       ETF-STEUERDRAG
    ---------------------------------------------------------- */

    function applyEtfYearTax(
      capitalBeforeGain,
      capitalAfterGain,
      taxAllowance
    ) {

      const gain =
        Math.max(
          0,
          capitalAfterGain -
          capitalBeforeGain
        );


      const taxableGain =
        Math.max(
          0,
          gain *
          0.70 -
          taxAllowance
        );


      const taxRate =
        0.26375;


      const tax =
        taxableGain *
        taxRate;


      return Math.max(
        0,
        capitalAfterGain -
        tax
      );

    }


    /* ---------------------------------------------------------
       AUSZAHLUNGSPLAN
    ---------------------------------------------------------- */

    function annuityPayment(
      capital,
      years,
      annualReturn
    ) {

      const months =
        Math.max(
          1,
          years * 12
        );


      const monthlyRate =
        annualReturn /
        100 /
        12;


      if (
        monthlyRate <= 0
      ) {

        return (
          capital /
          months
        );

      }


      return (
        capital *
        monthlyRate /
        (
          1 -
          Math.pow(
            1 +
            monthlyRate,
            -months
          )
        )
      );

    }


    /* ---------------------------------------------------------
       HAUPTBERECHNUNG
    ---------------------------------------------------------- */

    function calculateModel() {

      const monthly =
