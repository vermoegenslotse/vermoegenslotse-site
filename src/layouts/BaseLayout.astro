            />
          </a>

        </div>


        <!-- NAVIGATION -->

        <nav
          class="site-nav"
          aria-label="Hauptnavigation"
        >

          <!-- START -->

          <a
            class:list={[
              "navLink",
              { active: isActive("/") }
            ]}
            href="/"
          >
            Start
          </a>


          <!-- SO DENKE ICH -->

          <a
            class:list={[
              "navLink",
              { active: isActive("/ueber-mich") }
            ]}
            href="/ueber-mich"
          >
            So denke ich
          </a>


          <!-- SO ARBEITE ICH -->

          <a
            class:list={[
              "navLink",
              { active: isActive("/so-arbeite-ich") }
            ]}
            href="/so-arbeite-ich"
