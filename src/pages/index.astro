---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Vermögenslotse – Strategische Vermögensarchitektur für Unternehmer und Privatanleger">

  <!-- ===================================================== -->
  <!-- HERO                                                  -->
  <!-- ===================================================== -->

  <section class="hero">

    <div class="heroGrid">

      <div>

        <div class="kicker">
          Architektur + Kapitalmarktlogik
        </div>

        <img
          src="/images/vermoegenslotse-logo.png"
          alt="Vermögenslotse"
          class="heroBrandLogo"
        />

        <h1 class="heroTitle">
          Klare Vermögensarchitektur<br />
          <span class="heroTitleSub">
            für planbarere Entscheidungen & weniger Überraschungen
          </span>
        </h1>

        <p class="lead">
          Sie haben Vermögen aufgebaut.<br />
          Aber ist es auch bereit für das, was vor Ihnen liegt?
        </p>

        <p class="heroExplanation">
          Aus „Positionen“ wird ein System:
          klare Rollen, sinnvolle Gewichtungen,
          echte Diversifikation – und definierte
          Belastungsgrenzen statt Bauchgefühl.
        </p>


        <div class="personaSwitch">

          <div class="personaLabel">
            Unsere Leistungen für
          </div>

          <div class="personaButtons">

            <a
              class="personaBtn personaBtnDark"
              href="/unternehmer"
            >
              Unternehmer
            </a>

            <a
              class="personaBtn"
              href="/privatanleger"
            >
              Privatanleger
            </a>

          </div>

        </div>

      </div>


      <div>

        <div class="heroPhotoWrap">

          <img
            src="/images/christian-hero.png"
            alt="Christian Gradt"
            class="heroPhoto"
            loading="eager"
          />

        </div>


        <aside
          class="panel"
          style="margin-top:12px;"
        >

          <h2 class="sectionTitle">
            Worum es hier geht
          </h2>

          <ul class="bullets">
            <li>Makro-Rahmen statt Bauchgefühl</li>
            <li>Jedes Instrument mit klarer Funktion</li>
            <li>Kapitaltöpfe statt Produkt-Sammlung</li>
            <li>Unternehmerisches Risiko integriert</li>
          </ul>

          <p
            class="muted"
            style="margin-top:12px;"
          >
            Keine Produktshow. Kein „Top-10“. Sondern Struktur.
          </p>

          <p
            class="muted"
            style="margin-top:12px;"
          >
            In der Regel sinnvoll ab 250.000 €
            strukturiertem Anlagevermögen.
          </p>

        </aside>

      </div>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- DREI REGELN                                           -->
  <!-- ===================================================== -->

  <section class="section">

    <h2 class="sectionTitle">
      Drei Regeln, die Komplexität reduzieren
    </h2>

    <div class="cards">

      <div class="card">
        <h3>Positionsgrößen (5–15%)</h3>
        <p>
          Richtwert für Wirkung ohne strukturelles Klumpenrisiko.
        </p>
      </div>

      <div class="card">
        <h3>Echte Diversifikation</h3>
        <p>
          Mehrere Ertragsquellen statt Fonds-Sammlung
          ohne Systemfunktion.
        </p>
      </div>

      <div class="card">
        <h3>Regelbasierte Steuerung</h3>
        <p>
          Belastungsrahmen (Drawdown) statt Reaktion
          auf Schlagzeilen.
        </p>
      </div>

    </div>

    <p
      class="muted"
      style="margin-top:12px;"
    >
      Vertiefung auf der Seite:
      <a href="/so-arbeite-ich">
        So arbeite ich
      </a>
    </p>

  </section>


  <!-- ===================================================== -->
  <!-- TESTIMONIALS                                          -->
  <!-- ===================================================== -->

  <section class="sectionAlt fullWidthSection reveal">

    <div class="testimonialsContainer">

      <h2
        class="sectionTitle"
        style="text-align:center;"
      >
        Stimmen meiner Mandanten
      </h2>


      <div class="testimonialsGrid">

        <div class="testimonialsCards">

          <div class="card">
            <h3>Unternehmer, 52</h3>
            <p class="muted">
              „Endlich ein Regelwerk statt Einzelentscheidungen.
              Ich weiß jetzt, wann gehandelt wird – und wann nicht.“
            </p>
          </div>


          <div class="card">
            <h3>Privatanlegerin, 49</h3>
            <p class="muted">
              „Ich verstehe mein Risiko, weil wir es in Euro
              definiert haben. Das macht Entscheidungen deutlich ruhiger.“
            </p>
          </div>


          <div class="card">
            <h3>Unternehmerpaar, 58</h3>
            <p class="muted">
              „Ruhiger in der Entnahmephase durch klare Module
              und eine nachvollziehbare Steuerungslogik.“
            </p>
          </div>


          <div class="card">
            <h3>Selbstständiger, 46</h3>
            <p class="muted">
              „Keine Produktshow. Sondern Architektur:
              Rollen, Risiken, Prioritäten – und ein System,
              das ich verstehe.“
            </p>
          </div>

        </div>


        <div class="testimonialsTrust">

          <p class="muted">
            Verifizierte Bewertungen über ProvenExpert
          </p>

          <div id="proSealWidgetTop"></div>

        </div>

      </div>


      <script is:inline>

        window.loadProSealTop = function () {

          window.provenExpert.proSeal({

            widgetId:
              "de268325-2eef-447c-9058-570a06970d50",

            language:
              "de-DE",

            usePageLanguage:
              false,

            bannerColor:
              "#D87808",

            textColor:
              "#FFFFFF",

            showBackPage:
              true,

            showReviews:
              true,

            hideDate:
              true,

            hideName:
              false,

            googleStars:
              true,

            displayReviewerLastName:
              false,

            embeddedSelector:
              "#proSealWidgetTop"

          });

        };


        window.addEventListener(

          "load",

          function () {

            if (
              !document.querySelector(
                'script[src="https://s.provenexpert.net/seals/proseal-v2.js"]'
              )
            ) {

              var script =
                document.createElement("script");

              script.src =
                "https://s.provenexpert.net/seals/proseal-v2.js";

              script.onload =
                loadProSealTop;

              document.head.appendChild(
                script
              );

            }

            else {

              loadProSealTop();

            }

          },

          false

        );

      </script>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- WIEDERERKENNUNG                                       -->
  <!-- ===================================================== -->

  <section class="section reveal">

    <h2 class="sectionTitle">
      Vielleicht erkennen Sie sich hier wieder
    </h2>


    <div class="splitGrid">

      <div class="splitContent">

        <div class="recognitionGrid">

          <div class="recognitionItem">
            <span class="checkIcon">✓</span>
            <span>
              Mein Depot ist gewachsen – aber ich habe
              keinen klaren Gesamtüberblick.
            </span>
          </div>


          <div class="recognitionItem">
            <span class="checkIcon">✓</span>
            <span>
              Ich lese viel – und werde mit jedem Artikel unsicherer.
            </span>
          </div>


          <div class="recognitionItem">
            <span class="checkIcon">✓</span>
            <span>
              Ich möchte Struktur, nicht Produktvorschläge.
            </span>
          </div>


          <div class="recognitionItem">
            <span class="checkIcon">✓</span>
            <span>
              Ich will im Ruhestand ruhig schlafen –
              nicht ständig reagieren müssen.
            </span>
          </div>

        </div>

      </div>


      <div class="splitVisual">

        <img
          src="/images/start-recognition.png"
          alt="Struktur schafft Klarheit"
          loading="lazy"
        />

      </div>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- TOOLBOX EINSTIEG                                      -->
  <!-- ===================================================== -->

  <section class="homeToolbox reveal">

    <div class="homeToolboxHeader">

      <div>

        <p class="homeEyebrow">
          SELBST PRÜFEN & EINORDNEN
        </p>

        <h2>
          Sie möchten erst einmal selbst genauer hinschauen?
        </h2>

        <p>
          Nutzen Sie Rechner, Checks und Fachinformationen,
          um Ihre Situation besser einzuordnen –
          bevor Sie Entscheidungen treffen.
        </p>

      </div>


      <a
        class="homeToolboxMainButton"
        href="/toolbox"
      >
        Gesamte Toolbox öffnen
        <span aria-hidden="true">→</span>
      </a>

    </div>


    <div class="homeToolboxGrid">


      <!-- VERMÖGEN -->

      <a
        class="homeToolCard"
        href="/vermoegenscheck"
      >

        <span class="homeToolNumber">
          01
        </span>

        <span class="homeToolCategory">
          VERMÖGEN
        </span>

        <strong>
          Vermögenscheck
        </strong>

        <span class="homeToolText">
          Vermögensstruktur und mögliche
          Schwachstellen aus der Vogelperspektive betrachten.
        </span>

        <span class="homeToolArrow">
          Öffnen →
        </span>

      </a>


      <!-- DEPOT -->

      <a
        class="homeToolCard"
        href="/depot-blindflecken-check"
      >

        <span class="homeToolNumber">
          02
        </span>

        <span class="homeToolCategory">
          DEPOT
        </span>

        <strong>
          Depotblindfleckencheck
        </strong>

        <span class="homeToolText">
          Konzentrationen, Abhängigkeiten und
          strukturelle Risiken im Depot hinterfragen.
        </span>

        <span class="homeToolArrow">
          Öffnen →
        </span>

      </a>


      <!-- RUHESTAND -->

      <a
        class="homeToolCard"
        href="/ruhestands-navigator"
      >

        <span class="homeToolNumber">
          03
        </span>

        <span class="homeToolCategory">
          RUHESTAND
        </span>

        <strong>
          Ruhestands-Navigator
        </strong>

        <span class="homeToolText">
          Versorgungslücke, Kapitalbedarf und
          Kapitalreichweite unter verschiedenen Annahmen modellieren.
        </span>

        <span class="homeToolArrow">
          Öffnen →
        </span>

      </a>


      <!-- ALTERSVORSORGE -->

      <a
        class="homeToolCard"
        href="/altersvorsorgedepot"
      >

        <span class="homeToolNumber">
          04
        </span>

        <span class="homeToolCategory">
          ALTERSVORSORGE
        </span>

        <strong>
          Altersvorsorgedepot-Rechner
        </strong>

        <span class="homeToolText">
          Neue Förderung, Szenarien und mögliche
          Entwicklungen nachvollziehbar berechnen.
        </span>

        <span class="homeToolArrow">
          Öffnen →
        </span>

      </a>

    </div>


    <div class="homeToolboxKnowledge">

      <span>
        Nicht nur rechnen:
      </span>

      <strong>
        Leitfäden, Broschüren und Checklisten
      </strong>

      <span>
        ergänzen die digitalen Werkzeuge in der Toolbox.
      </span>

      <a href="/toolbox">
        Fachwissen entdecken →
      </a>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- RIESTER 2027                                          -->
  <!-- ===================================================== -->

  <section class="homeRiester reveal">

    <div class="homeRiesterGrid">

      <div>

        <div class="homeRiesterBadge">
          AKTUELL · RIESTER 2027
        </div>

        <h2>
          Was passiert mit Ihrem bestehenden Riester-Vertrag?
        </h2>

        <p class="homeRiesterLead">
          Die neue Vorsorgewelt ab 2027 eröffnet neue Möglichkeiten.
          Das bedeutet aber nicht automatisch, dass ein bestehender
          Vertrag ersetzt oder übertragen werden sollte.
        </p>

        <p>
          Garantien, Kosten, Rentenfaktor, Restlaufzeit und
          bestehende Vertragsrechte können entscheidend sein.
          Deshalb gilt auch hier:
          <strong>
            erst verstehen, dann prüfen – und erst danach entscheiden.
          </strong>
        </p>

      </div>


      <div class="homeRiesterActions">

        <a
          class="homeRiesterPrimary"
          href="/altersvorsorgedepot"
        >
          Riester 2027 einordnen
        </a>

        <a
          class="homeRiesterSecondary"
          href="https://riesterapp.de/a/6AGQYBL"
          target="_blank"
          rel="noopener noreferrer"
        >
          Bestehenden Vertrag prüfen ↗
        </a>

        <span>
          Externer Riester-Check
        </span>

      </div>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- ERSTGESPRÄCH NUTZEN                                   -->
  <!-- ===================================================== -->

  <section class="section">

    <h2 class="sectionTitle">
      Was Sie nach dem Erstgespräch konkret erhalten
    </h2>


    <div class="benefitGrid">

      <div class="benefitCard">

        <h4>
          Struktur-Überblick
        </h4>

        <p>
          Eine geordnete Sicht auf Ihre aktuelle Vermögensarchitektur.
        </p>

      </div>


      <div class="benefitCard">

        <h4>
          Risiken priorisiert
        </h4>

        <p>
          Klumpenrisiken und Schwachstellen –
          nach Relevanz sortiert.
        </p>

      </div>


      <div class="benefitCard">

        <h4>
          Handlungsplan
        </h4>

        <p>
          Konkrete nächste Schritte –
          verständlich, ohne Produktdruck.
        </p>

      </div>


      <div class="benefitCard">

        <h4>
          Klare Richtung
        </h4>

        <p>
          Ein belastbarer Rahmen für Entscheidungen
          im Marktumfeld.
        </p>

      </div>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- STRUKTUR STATT ZUFALL                                 -->
  <!-- ===================================================== -->

  <section class="section sectionAlt reveal">

    <h2 class="sectionTitle">
      Struktur statt Zufall
    </h2>


    <div class="splitGrid splitReverse">

      <div class="splitContent">

        <div class="cardsGrid">


          <div class="card">

            <h3>
              Architektur statt Einzelentscheidungen
            </h3>

            <p>
              Ein Depot ist kein Sammelsurium.
              Entscheidend ist, wie alles zusammenwirkt –
              Ziel, Risiko, Zeit und Liquidität.
            </p>

          </div>


          <div class="card">

            <h3>
              Makro-Logik statt Bauchgefühl
            </h3>

            <p>
              Zinsen, Inflation, Regimewechsel:
              Ohne Rahmen wird aus „Information“
              schnell Unsicherheit.
            </p>

          </div>


          <div class="card">

            <h3>
              Planbarkeit statt Reaktion
            </h3>

            <p>
              Sie bekommen Prioritäten, nächste Schritte
              und eine Steuerungslogik –
              damit Entscheidungen wieder begründet sind.
            </p>

          </div>

        </div>

      </div>


      <div class="splitVisual">

        <img
          src="/images/so-arbeite-ich-02.webp"
          alt="Vermögensarchitektur"
          loading="lazy"
        />

      </div>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- ÜBER CHRISTIAN GRADT                                  -->
  <!-- ===================================================== -->

  <section class="section reveal">

    <div class="aboutGrid">

      <div class="aboutPhotoWrap">

        <img
          src="/images/christian-hero2.png"
          alt="Christian Gradt"
          class="aboutPhoto"
          loading="lazy"
        />

      </div>


      <div>

        <h2 class="sectionTitle">
          Über Christian Gradt
        </h2>

        <p>
          Ich bin Diplom-Betriebswirt mit Studienschwerpunkt
          Steuer & Revision und seit über 30 Jahren als Berater aktiv.
          Mein Fokus liegt in der Entwicklung klarer Strategien
          für Vermögensaufbau, Nachfolgeplanung und den Aufbau von Sachwerten.
        </p>

        <p class="muted">
          Ich weiß aus eigener Erfahrung, wie sich Märkte
          in guten und in schwierigen Phasen anfühlen –
          und warum in genau diesen Momenten Struktur wichtiger ist als Meinung.
          Deshalb geht es in meiner Arbeit nicht um Produkt-Hopping,
          sondern um Vermögensarchitektur:
          Funktion, Risiko, Steuerbarkeit und einen nachvollziehbaren
          Rahmen für Entscheidungen.
        </p>


        <h3 style="margin-top:18px;">
          Was mich auszeichnet
        </h3>

        <ul class="bullets">

          <li>
            Über 30 Jahre Expertise im Vermögensaufbau
            und in der Vermögensübertragung
          </li>

          <li>
            Eigene Erfahrung als Anleger –
            mit Höhen und Tiefen der Finanzmärkte
          </li>

          <li>
            Ein empathischer Ansatz,
            der auf individuelle Bedürfnisse eingeht
          </li>

          <li>
            Ein starkes Netzwerk unabhängiger
            Sachverständiger und Partner
          </li>

        </ul>


        <h3 style="margin-top:18px;">
          Risikoprüfung als zweite Ebene
        </h3>

        <p
          class="lead"
          style="margin-top:10px;"
        >
          Vermögensführung endet nicht bei Kapitalanlagen.
        </p>


        <div class="riskBlock">

          <div class="riskBlockText">

            <p
              class="muted"
              style="margin-top:0;"
            >
              Als berufener Sachverständiger für das Versicherungswesen (BVSV)
              betrachte ich die Risikostruktur rund um Ihre Vermögensziele:
              Haftungslogik, Absicherung, Annahmen –
              systemisch, dokumentiert, nicht produktgetrieben.
            </p>

            <div
              class="btnRow"
              style="margin-top:12px;"
            >
              <a
                class="btn btnSecondary"
                href="/ueber-mich"
              >
                Mehr dazu: Über mich
              </a>
            </div>

          </div>


          <div class="riskBlockBadge">

            <img
              src="/images/sachverstaendiger-logo.png"
              alt="Sachverständiger für das Versicherungswesen (BVSV)"
              class="riskBadgeLogo"
              loading="lazy"
            />

          </div>

        </div>


        <h3 style="margin-top:18px;">
          Mein Anspruch
        </h3>

        <p class="muted">
          Ich mache komplexe Themen verständlich,
          entwickle klare Strukturen und begleite Menschen
          und Unternehmen so, dass sie ihre finanzielle Zukunft
          sicher und planbar gestalten können.
        </p>

      </div>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- PROZESS                                               -->
  <!-- ===================================================== -->

  <section class="section">

    <h2 class="sectionTitle">
      Ihr Weg zur Vermögensarchitektur
    </h2>

    <p class="muted">
      Drei Schritte – klar, strukturiert, ohne Produktfokus.
    </p>


    <div class="cards">

      <div class="card">

        <h3>
          1) Orientierungsgespräch
        </h3>

        <p>
          Standortbestimmung:
          Struktur, Funktion, Rahmen, typische Bruchstellen.
        </p>

      </div>


      <div class="card">

        <h3>
          2) Struktur-Analyse
        </h3>

        <p>
          Einordnung der Ergebnisse und Ableitung
          einer Architektur, die zu Zielen und Risiken passt.
        </p>

      </div>


      <div class="card">

        <h3>
          3) Umsetzung & Steuerung
        </h3>

        <p>
          Vermögen wird geführt –
          mit klaren Regeln statt Einzelentscheidungen.
        </p>

      </div>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- GESPRÄCHE                                             -->
  <!-- ===================================================== -->

  <section class="section sectionAlt ctaProcess reveal">

    <div class="container">

      <h2 class="sectionTitle">
        Der nächste Schritt
      </h2>

      <p class="lead centerText">
        Wählen Sie das Gespräch, das zu Ihrer Situation passt.
      </p>


      <div class="bookingGrid">


        <!-- ORIENTIERUNG -->

        <div class="bookingCard">

          <div class="bookingHeader">

            <div class="bookingBadge">
              20 Minuten
            </div>

            <h3>
              Orientierungsgespräch
            </h3>

          </div>


          <p class="muted">
            Zum Kennenlernen, Einordnen des Status-Quo
            und um zu prüfen, ob eine Zusammenarbeit sinnvoll ist.
          </p>


          <ul
            class="bullets"
            style="margin-top:12px;"
          >

            <li>
              Kurzer Überblick über Ihre Situation
            </li>

            <li>
              Ihre Ziele & Prioritäten
            </li>

            <li>
              Nächster sinnvoller Schritt
            </li>

          </ul>


          <div
            class="btnRow"
            style="margin-top:16px;"
          >

            <a
              class="btn"
              href="https://chgradt-gradt-consulting.zohobookings.eu/#/242656000000190002"
              target="_blank"
              rel="noopener"
            >
              Orientierungsgespräch buchen
            </a>

          </div>


          <p
            class="subtleText"
            style="margin-top:10px;"
          >
            Kostenlos & unverbindlich.
          </p>

        </div>


        <!-- STRATEGIE -->

        <div class="bookingCard bookingCardAlt">

          <div class="bookingHeader">

            <div class="bookingBadge">
              60 Minuten
            </div>

            <h3>
              Strategiegespräch
            </h3>

          </div>


          <p class="muted">
            Für alle, die ihre aktuelle Situation konkret analysieren
            und besprechen möchten.
            Voraussetzung: Die relevanten Daten liegen vor
            (z. B. Depotübersicht).
          </p>


          <ul
            class="bullets"
            style="margin-top:12px;"
          >

            <li>
              Struktur- & Risikoanalyse
              (in Euro greifbar)
            </li>

            <li>
              Architektur-Vorschlag / nächste Schritte
            </li>

            <li>
              Prioritäten & klare Vorgehenslogik
            </li>

          </ul>


          <div
            class="btnRow"
            style="margin-top:16px;"
          >

            <a
              class="btn btnSecondary"
              href="https://chgradt-gradt-consulting.zohobookings.eu/#/242656000000190020"
              target="_blank"
              rel="noopener"
            >
              Strategiegespräch anfragen
            </a>

          </div>


          <p
            class="subtleText"
            style="margin-top:10px;"
          >
            Hinweis:
            Die Terminbuchung ist erst nach Daten-Check sinnvoll.
          </p>

        </div>

      </div>


      <div
        class="centerText"
        style="margin-top:18px;"
      >

        <a
          class="btn btnSecondary"
          href="/kontakt"
        >
          Kontakt
        </a>

      </div>


      <p
        class="centerText subtleText"
        style="margin-top:12px;"
      >
        Ich freue mich, Sie kennenzulernen.
      </p>

    </div>

  </section>


  <!-- ===================================================== -->
  <!-- STYLES FÜR NEUE STARTSEITEN-BEREICHE                  -->
  <!-- ===================================================== -->

  <style>

    /* ----------------------------------------------------- */
    /* TOOLBOX                                               */
    /* ----------------------------------------------------- */

    .homeToolbox {
      margin: 36px 0 46px;

