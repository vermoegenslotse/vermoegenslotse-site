          : "false"
      );


      params.set(
        "kinderfoerderung",
        result.totalChildAllowances > 0
          ? "true"
          : "false"
      );


      params.set(
        "vergleich_status",
        comparisonStatus
      );


      params.set(
        "kurz_einordnung",
        shortAssessment
      );


      params.set(
        "modellhinweis",
        modelNotice
      );


      return (
        zohoCalculationBase +
        "?" +
        params.toString()
      );

    }


